<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone List View -->
    <record id="view_metabase_instance_list" model="ir.ui.view">
        <field name="name">metabase.instance.list</field>
        <field name="model">metabase.instance</field>
        <field name="arch" type="xml">
            <list string="Metabase Instances" sample="1">
                <field name="name"/>
                <field name="base_url"/>
                <field name="token_expiry_minutes"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Standalone Form View -->
    <record id="view_metabase_instance_form" model="ir.ui.view">
        <field name="name">metabase.instance.form</field>
        <field name="model">metabase.instance</field>
        <field name="arch" type="xml">
            <form string="Metabase Instance">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Company Metabase BI"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection Details">
                            <field name="base_url" placeholder="https://bi-wujia.tipscode.io"/>
                            <field name="embedding_secret" password="True"/>
                            <field name="token_expiry_minutes"/>
                            <field name="active"/>
                        </group>
                        <group string="Security &amp; Organization">
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dashboards" name="dashboards">
                            <field name="dashboard_ids" readonly="1">
                                <list string="Dashboards">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="dashboard_id"/>
                                    <field name="show_under_menu_id"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Standalone Mobile Kanban View -->
    <record id="view_metabase_instance_kanban" model="ir.ui.view">
        <field name="name">metabase.instance.kanban</field>
        <field name="model">metabase.instance</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name"/>
                <field name="base_url"/>
                <field name="token_expiry_minutes"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="name"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{record.active.raw_value and 'wj_mobile_badge--success' or 'wj_mobile_badge--danger'}">
                                    <field name="active" widget="boolean_state"/>
                                </span>
                            </div>
                            <div class="wj_mobile_card__title mb-1 text-primary">
                                <field name="base_url"/>
                            </div>
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-clock-o me-1"/>
                                    <field name="token_expiry_minutes"/> mins expiry
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_metabase_instance" model="ir.actions.act_window">
        <field name="name">Metabase Instances</field>
        <field name="res_model">metabase.instance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_metabase_instance_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_metabase_instance_kanban'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_metabase_instance_form'), 'sequence': 3})
        ]"/>
    </record>
</odoo>
