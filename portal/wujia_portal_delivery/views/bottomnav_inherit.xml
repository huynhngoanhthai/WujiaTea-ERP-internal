<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- F5a — tab bottom-nav của màn này; khung chỉ giữ nút "Thêm" làm neo. -->
    <template id="mobile_bottomnav_delivery"
              inherit_id="wujia_portal_layout.mobile_bottomnav"
              priority="30"
              name="Wujia Mobile — Delivery tab">
        <xpath expr="//button[@data-wujia-more='toggle']" position="before">
            <t t-set="_bn_on" t-value="_bnav_path.startswith('/portal/delivery')"/>
            <t t-set="_bnav_hit" t-value="_bnav_hit or bool(_bn_on)"/>
            <t t-call="wujia_portal_layout.wj_bnav_item">
                <t t-set="bn_active" t-value="_bn_on"/>
                <t t-set="bn_href" t-value="'/portal/delivery'"/>
                <t t-set="bn_icon" t-value="'feather icon-truck'"/>
                <t t-set="bn_label">Delivery</t>
            </t>
        </xpath>
    </template>

</odoo>
