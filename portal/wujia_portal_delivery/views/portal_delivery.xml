<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== Khối kết quả (swap được bằng AJAX khi lọc) ==============
         3 mảnh: 'pc' (card desktop), 'mchips' (chips mobile trong form lọc),
         'mbody' (list/empty/error + pager mobile). Trang đầy đủ t-call từng mảnh
         đúng chỗ; route /portal/delivery/results trả cả 3 để JS thay tại chỗ. -->
    <template id="portal_delivery_results_part" name="Wujia Portal — Delivery Results Part">
        <t t-set="_dq" t-value="chip_qs or ''"/>

        <!-- Lỗi khoảng ngày báo tại FilterBar, KHÔNG dùng empty state (E4c).
             Luôn render (rỗng thì `hidden`) vì JS thay khối theo id: thiếu id là
             `swap` trả false rồi cả màn rơi về tải lại trang. -->
        <p t-if="part == 'pcerr'" id="wj-dlv-pcerr" class="wj-filter-error" role="alert"
           t-att-hidden="None if filter_error else 'hidden'" t-out="filter_error"/>
        <p t-if="part == 'merr'" id="wj-dlv-merr" class="wj-filter-error" role="alert"
           t-att-hidden="None if filter_error else 'hidden'" t-out="filter_error"/>

        <!-- ===== PC: card danh sách (head + chips + states + pager) ===== -->
        <t t-call="wujia_portal_layout.wj_surface_card" t-if="part == 'pc'">
            <t t-set="sc_class" t-value="'wj-pc-card'"/>
            <t t-set="sc_id" t-value="'wj-dlv-pc-card'"/>
            <div class="wj-pc-card__head">
                <!-- CMP-SH-001 variant meta (BA chỉ đích danh trang này). Chips lọc KHÔNG vào
                     right slot: chúng là CMP-FC-001, và spec cấm 2 right slot cùng lúc. -->
                <t t-call="wujia_portal_layout.wj_section_header">
                    <t t-set="sh_title">Delivery trips</t>
                    <t t-set="sh_level" t-value="3"/>
                    <t t-set="sh_platform" t-value="'pc'"/>
                    <t t-set="sh_class" t-value="'wj-section-header--inline'"/>
                    <t t-set="sh_meta">
                        <!-- view_state 'error' cố ý KHÔNG có meta, y như trước C8 -->
                        <span t-if="view_state in ('loading', 'list', 'empty')" class="wj-section-header__meta">
                            <t t-if="view_state == 'loading'">Loading data...</t>
                            <t t-elif="view_state == 'list'"><t t-set="_dlv_n" t-value="len(batches)"/><t t-out="_dlv_n"/> <t t-if="_dlv_n == 1">trip · Newest first</t><t t-else="">trips · Newest first</t></t>
                            <t t-else="">0 trips</t>
                        </span>
                    </t>
                </t>
                <!-- Chips số đếm (clickable filter, luôn hiện màu status) -->
                <div t-if="view_state == 'list'" class="wj-pc-dlv-chips">
                    <a t-attf-href="/portal/delivery?bs=#{_dq}"
                       t-attf-class="wj-pc-dlv-chip wj-state-surface wj-pc-dlv-chip--going #{'is-active' if not bs else ''}">All <t t-out="chip_counts.get('all', 0)"/></a>
                    <a t-attf-href="/portal/delivery?bs=going#{_dq}"
                       t-attf-class="wj-pc-dlv-chip wj-state-surface wj-pc-dlv-chip--going #{'is-active' if bs == 'going' else ''}">Delivering <t t-out="chip_counts.get('going', 0)"/></a>
                    <a t-attf-href="/portal/delivery?bs=soon#{_dq}"
                       t-attf-class="wj-pc-dlv-chip wj-state-surface wj-pc-dlv-chip--soon #{'is-active' if bs == 'soon' else ''}">Delivering soon <t t-out="chip_counts.get('soon', 0)"/></a>
                    <a t-attf-href="/portal/delivery?bs=done#{_dq}"
                       t-attf-class="wj-pc-dlv-chip wj-state-surface wj-pc-dlv-chip--done #{'is-active' if bs == 'done' else ''}">Delivered <t t-out="chip_counts.get('done', 0)"/></a>
                </div>
            </div>

            <!-- STATE: list -->
            <t t-if="view_state == 'list'">
                <!-- DataState của route này do view_state quyết ở tầng trên DataList (empty/loading/error là khối anh em). -->
                <t t-call="wujia_portal_layout.wj_data_list">
                    <t t-set="dl_table_class" t-value="'wj-pc-table wj-pc-dlv-table'"/>
                    <thead>
                        <tr>
                            <th scope="col">Trip code</th>
                            <th scope="col">Departs at</th>
                            <th scope="col">Related orders</th>
                            <th scope="col">Status</th>
                            <th scope="col">Vehicle · driver</th>
                            <th scope="col">License plate</th>
                            <th scope="col">Updated on</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="batches" t-as="b">
                            <td class="wj-pc-td--code">
                                <a t-attf-href="/portal/delivery/#{b['id']}" class="wj-pc-dlv-codelink" t-out="b['name']"/>
                            </td>
                            <td>
                                <t t-out="b['departure_full']"/>
                                <span t-if="b['departure_actual']" class="wj-count-meta"> (actual)</span>
                            </td>
                            <td t-out="b['orders']"/>
                            <td><span t-attf-class="wj-status-badge #{b['pc_modifier']}" t-out="b['pc_label']"/></td>
                            <td t-out="b['vehicle']"/>
                            <td t-out="b['plate']"/>
                            <td class="wj-pc-td--muted" t-out="b['updated']"/>
                            <td class="text-end">
                                <a t-attf-href="/portal/delivery/#{b['id']}"
                                   class="wj-btn wj-btn--secondary wj-btn--sm">View</a>
                            </td>
                        </tr>
                    </tbody>
                </t>

                <t t-call="wujia_portal_layout.wj_pagination"/>
            </t>

            <!-- STATE: loading (skeleton) -->
            <div t-if="view_state == 'loading'" class="wj-pc-dlv-skel">
                <t t-foreach="[0,1,2,3,4,5,6]" t-as="s">
                    <div t-attf-class="wj-pc-dlv-skel-row #{'wj-pc-dlv-skel-row--alt' if s_index % 2 else ''}">
                        <span class="wj-pc-dlv-skel-bar" style="width:150px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:132px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:150px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:82px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:168px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:90px;"/>
                        <span class="wj-pc-dlv-skel-bar" style="width:64px;"/>
                    </div>
                </t>
            </div>

            <!-- STATE: empty -->
            <div t-if="view_state == 'empty'" class="wj-pc-dlv-inner">
                <span class="wj-pc-dlv-inner__icon"><i class="feather icon-truck"/></span>
                <h3 class="wj-pc-dlv-inner__title">No delivery trips</h3>
                <p class="wj-pc-dlv-inner__sub">No delivery trips found in the selected date range.</p>
                <a href="/portal/delivery" class="wj-btn wj-btn--secondary">Change filters</a>
            </div>

            <!-- STATE: error -->
            <div t-if="view_state == 'error'" class="wj-pc-dlv-inner">
                <span class="wj-pc-dlv-inner__icon wj-pc-dlv-inner__icon--error"><i class="feather icon-alert-circle"/></span>
                <h3 class="wj-pc-dlv-inner__title">Could not load delivery data</h3>
                <p class="wj-pc-dlv-inner__sub">Please try reloading or check your connection.</p>
                <a href="/portal/delivery"
                   class="wj-btn wj-btn--primary"><i class="feather icon-refresh-cw"/>Reload</a>
            </div>
        </t>

        <!-- ===== Mobile: chips trạng thái (nằm trong form lọc) ===== -->
        <div t-if="part == 'mchips'" id="wj-dlv-mchips" class="wj-filter-chips">
            <a t-attf-href="/portal/delivery?bs=#{_dq}"
               t-attf-class="wj-filter-chip #{'is-active' if not bs else ''}">All</a>
            <a t-attf-href="/portal/delivery?bs=soon#{_dq}"
               t-attf-class="wj-filter-chip #{'is-active' if bs == 'soon' else ''}">Delivering soon</a>
            <a t-attf-href="/portal/delivery?bs=going#{_dq}"
               t-attf-class="wj-filter-chip #{'is-active' if bs == 'going' else ''}">Delivering</a>
            <a t-attf-href="/portal/delivery?bs=done#{_dq}"
               t-attf-class="wj-filter-chip #{'is-active' if bs == 'done' else ''}">Delivered</a>
        </div>

        <!-- ===== Mobile: thân kết quả (list/empty/error/loading + pager) =====
             Wrapper giữ flex-column + gap y hệt .wujia-mpage để gộp 2-3 khối con
             vào 1 vùng swap mà spacing không đổi (xem portal_delivery.css). -->
        <div t-if="part == 'mbody'" id="wj-dlv-mbody" class="wujia-mdelivery-body">
            <!-- STATE: list -->
            <t t-if="view_state == 'list'">
                <div class="wujia-mdelivery-resulthead">
                    <span class="cnt"><t t-set="_dlv_n" t-value="len(batches)"/><t t-out="_dlv_n"/> <t t-if="_dlv_n == 1">trip</t><t t-else="">trips</t></span>
                    <span class="sort">Newest first</span>
                </div>
                <t t-call="wujia_portal_layout.wj_data_list">
                    <t t-set="dl_variant" t-value="'detail-card'"/>
                    <t t-set="dl_class" t-value="'wujia-mdelivery-list'"/>
                    <a t-foreach="batches" t-as="b" t-attf-href="/portal/delivery/#{b['id']}"
                       class="wj-data-item wj-lc">
                        <t t-call="wujia_portal_layout.wj_list_card">
                            <t t-set="lc_name" t-value="b['name']"/>
                            <t t-set="lc_state">
                                <span t-attf-class="wj-status-badge wj-status-badge--compact #{b['modifier']}"
                                      t-out="b['label']"/>
                            </t>
                            <t t-set="lc_rows">
                                <t t-call="wujia_portal_layout.wj_list_card_row">
                                    <t t-set="lcr_label">
                                        <i class="feather icon-calendar wj-lc__icon"/>
                                        <t t-out="b['departure_label']"/>
                                    </t>
                                    <t t-set="lcr_value" t-value="b['departure'] or '—'"/>
                                </t>
                                <t t-call="wujia_portal_layout.wj_list_card_row">
                                    <t t-set="lcr_label">
                                        <i class="feather icon-file-text wj-lc__icon"/>
                                        Related orders
                                    </t>
                                    <t t-set="lcr_value" t-value="b['orders'] or '—'"/>
                                </t>
                            </t>
                        </t>
                    </a>
                </t>
                <t t-call="wujia_portal_layout.wj_pagination"/>
            </t>

            <!-- STATE: empty (no-data chung Figma 4788:974 — lọc rỗng → Xóa lọc) -->
            <div t-if="view_state == 'empty'" class="wj-empty-state wj-empty-state--rich">
                <span class="wj-empty-state-icon"/>
                <p class="wj-empty-state-title">No delivery trips</p>
                <p class="wj-empty-state-sub">No delivery trips found in the selected date range.</p>
                <p class="wj-empty-state-sub">Change the filters or check again later.</p>
                <a href="/portal/delivery" class="wj-btn wj-btn--secondary">Clear filters</a>
            </div>

            <!-- STATE: error (semantic — giữ icon cảnh báo qua dual-mode) -->
            <div t-if="view_state == 'error'" class="wj-empty-state wj-empty-state--rich">
                <span class="wj-empty-state-icon wujia-mdelivery-icon-danger"><i class="feather icon-alert-triangle"/></span>
                <p class="wj-empty-state-title">Could not load data</p>
                <p class="wj-empty-state-sub">Please check your connection or try reloading.</p>
                <button type="button" class="wj-btn wj-btn--primary" onclick="window.location.reload()">Reload</button>
            </div>

            <!-- STATE: loading (skeleton — UI-only, QA ?_preview=loading) -->
            <t t-if="view_state == 'loading'">
                <div class="wujia-mdelivery-resulthead">
                    <span class="cnt">Loading data…</span>
                </div>
                <t t-call="wujia_portal_layout.wj_data_list">
                    <t t-set="dl_variant" t-value="'detail-card'"/>
                    <t t-set="dl_class" t-value="'wujia-mdelivery-list'"/>
                    <t t-foreach="[1, 2, 3]" t-as="s">
                        <div class="wj-data-item wj-lc wujia-mdelivery-skel">
                            <span class="wj-lc__head">
                                <span class="wj-lc__lead">
                                    <span class="wujia-mdelivery-skel-bar" style="width:170px;height:14px;"/>
                                </span>
                                <span class="wj-lc__state">
                                    <span class="wujia-mdelivery-skel-bar" style="width:88px;height:24px;border-radius:8px;"/>
                                </span>
                            </span>
                            <span class="wj-lc__body">
                                <span class="wj-lc__row">
                                    <span class="wujia-mdelivery-skel-bar" style="width:96px;height:12px;"/>
                                </span>
                                <span class="wj-lc__row">
                                    <span class="wujia-mdelivery-skel-bar" style="width:112px;height:12px;"/>
                                </span>
                            </span>
                        </div>
                    </t>
                </t>
            </t>
        </div>
    </template>

    <!-- Fragment AJAX: cả 3 mảnh, JS thay từng khối theo id. -->
    <template id="portal_delivery_results" name="Wujia Portal — Delivery Results Fragment">
        <div t-if="not no_franchise">
            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                <t t-set="part" t-value="'pcerr'"/>
            </t>
            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                <t t-set="part" t-value="'merr'"/>
            </t>
            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                <t t-set="part" t-value="'pc'"/>
            </t>
            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                <t t-set="part" t-value="'mchips'"/>
            </t>
            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                <t t-set="part" t-value="'mbody'"/>
            </t>
        </div>
    </template>

    <!-- ============== List page (theo picking outgoing của franchise) ============== -->
    <template id="portal_delivery_tracking" name="Wujia Portal — Delivery Tracking List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Delivery tracking</t>
            <t t-set="_dlv_t_search_ph">Search trip code / SO code</t>
            <t t-set="_dlv_t_status">Status</t>
            <t t-set="_dlv_t_all_status">All statuses</t>
            <t t-set="_dlv_t_going">Delivering</t>
            <t t-set="_dlv_t_soon">Delivering soon</t>
            <t t-set="_dlv_t_done">Delivered</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/delivery'"/>
                <t t-set="wjl_slots"
                   t-value="'wj-dlv-pcerr,wj-dlv-pc-card,wj-dlv-merr,wj-dlv-mchips,wj-dlv-mbody'"/>
                <t t-set="wjl_fragment" t-value="'/portal/delivery/results'"/>
            </t>
            <!-- Desktop ≥992px — PC Giao hàng, batch-centric (Figma 4766:860). -->
            <div class="content-wrapper d-none d-lg-block wujia-dlv-pc">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Delivery</t>
                </t>

                <t t-if="no_franchise" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>

                <t t-else="">
                    <!-- Bộ lọc: search mã chuyến/SO + 2 date + trạng thái + Xóa lọc/Tìm kiếm -->
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'pc'"/>
                        <t t-set="fb_action" t-value="'/portal/delivery'"/>
                        <t t-set="fb_search"
                           t-value="{'name': 'q', 'value': q,
                                     'placeholder': _dlv_t_search_ph}"/>
                        <t t-set="fb_dates"
                           t-value="{'from': date_from, 'to': date_to}"/>
                        <t t-set="fb_selects"
                           t-value="[{'name': 'bs', 'value': bs,
                                      'label': _dlv_t_status,
                                      'all_label': _dlv_t_all_status,
                                      'options': [('going', _dlv_t_going),
                                                  ('soon', _dlv_t_soon),
                                                  ('done', _dlv_t_done)]}]"/>
                        <t t-set="fb_reset_url" t-value="'/portal/delivery'"/>
                        <t t-set="fb_error">
                            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                                <t t-set="part" t-value="'pcerr'"/>
                            </t>
                        </t>
                    </t>

                    <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                        <t t-set="part" t-value="'pc'"/>
                    </t>
                </t>
            </div>

            <!-- Mobile <992px — Figma 4731:2 (delivery_mobile_mockup_v4), batch-centric (S24) -->
            <div class="d-lg-none wujia-mpage wujia-mdelivery">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Delivery</t>
                </t>

                <t t-if="no_franchise" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>

                <t t-else="">
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'m'"/>
                        <t t-set="fb_action" t-value="'/portal/delivery'"/>
                        <t t-set="fb_id" t-value="'wj-dlv-mform'"/>
                        <t t-set="fb_search"
                           t-value="{'name': 'q', 'value': q, 'placeholder': _dlv_t_search_ph}"/>
                        <t t-set="fb_dates" t-value="{'from': date_from, 'to': date_to}"/>
                        <!-- Luôn render (kể cả rỗng) để JS đồng bộ khi bấm chip AJAX. -->
                        <t t-set="fb_hidden">
                            <input type="hidden" name="bs" id="wj-dlv-bs" t-att-value="bs or ''"/>
                        </t>
                        <t t-set="fb_error">
                            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                                <t t-set="part" t-value="'merr'"/>
                            </t>
                        </t>
                        <t t-set="fb_chips">
                            <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                                <t t-set="part" t-value="'mchips'"/>
                            </t>
                        </t>
                    </t>

                    <t t-call="wujia_portal_delivery.portal_delivery_results_part">
                        <t t-set="part" t-value="'mbody'"/>
                    </t>
                </t>
            </div>
            <!-- /list -->
        </t>
    </template>

    <!-- ============== Detail page (batch) ============== -->
    <template id="portal_delivery_detail" name="Wujia Portal — Delivery Batch Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="batch.name"/>
            <!-- Desktop ≥992px — PC Chi tiết giao hàng (Figma 4766:1091). -->
            <div class="content-wrapper d-none d-lg-block wujia-dlv-pc">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Delivery / Trip details</t>
                    <t t-set="ph_title">Delivery details</t>
                    <t t-set="ph_back_url" t-value="'/portal/delivery'"/>
                </t>

                <!-- Summary card -->
                <div class="wj-pc-order-head wj-pc-dlv-head">
                    <div>
                        <!-- Khối 3 cặp KV bên phải ở lại là NỘI DUNG card (spec cho tối đa MỘT
                             trailing) ⇒ trailing của header là badge trạng thái. -->
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title" t-value="batch.name or '—'"/>
                            <t t-set="ch_subtitle">Trip for <t t-out="store_label"/></t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'pc'"/>
                            <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            <t t-set="ch_meta">
                                <span t-attf-class="wj-status-badge #{pc_badge[1]}" t-out="pc_badge[0]"/>
                            </t>
                        </t>
                    </div>
                    <div class="wj-pc-dlv-head-kv">
                        <div class="wj-pc-kv">
                            <span class="wj-pc-kv__label" t-out="pc_departure_label"/>
                            <span class="wj-pc-kv__value" t-out="pc_departure"/>
                        </div>
                        <div class="wj-pc-kv">
                            <span class="wj-pc-kv__label">Related orders</span>
                            <span class="wj-pc-kv__value" t-out="pc_orders"/>
                        </div>
                        <div class="wj-pc-kv">
                            <span class="wj-pc-kv__label">Updated on</span>
                            <span class="wj-pc-kv__value" t-out="pc_updated"/>
                        </div>
                    </div>
                </div>

                <!-- Two-column: vận chuyển | đơn liên quan + timeline -->
                <div class="wj-pc-two-col">
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_class" t-value="'wj-pc-card'"/>
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Transport information</t>
                            <t t-set="ch_platform" t-value="'pc'"/>
                        </t>
                        <div class="wj-pc-kv-grid">
                            <div class="wj-pc-kv">
                                <span class="wj-pc-kv__label">Vehicle / driver</span>
                                <span class="wj-pc-kv__value">
                                    <t t-if="batch.vehicle_id"><t t-out="batch.vehicle_id.name or '—'"/><t t-if="batch.vehicle_id.driver_name"> · <t t-out="batch.vehicle_id.driver_name"/></t></t>
                                    <t t-else="">—</t>
                                </span>
                            </div>
                            <div class="wj-pc-kv">
                                <span class="wj-pc-kv__label">License plate</span>
                                <span class="wj-pc-kv__value" t-out="batch.vehicle_id.license_plate or '—'"/>
                            </div>
                        </div>
                        <hr class="wj-pc-dlv-divider"/>
                        <div class="wj-pc-kv-grid">
                            <div class="wj-pc-kv">
                                <span class="wj-pc-kv__label">Source warehouse</span>
                                <span class="wj-pc-kv__value" t-out="src_location"/>
                            </div>
                            <div class="wj-pc-kv">
                                <span class="wj-pc-kv__label">Status</span>
                                <span class="wj-pc-kv__value wj-pc-kv__value--primary" t-out="pc_badge[0]"/>
                            </div>
                        </div>
                    </t>

                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_class" t-value="'wj-pc-card'"/>
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Related orders</t>
                            <t t-set="ch_platform" t-value="'pc'"/>
                        </t>
                        <div class="wj-pc-dlv-so-chips">
                            <span t-foreach="so_names" t-as="so" class="wj-pc-dlv-so-chip" t-out="so"/>
                            <span t-if="not so_names" class="wj-pc-td--muted">—</span>
                        </div>
                        <!-- Timeline 3 bước: Xuất kho → Đang giao → Hoàn tất -->
                        <div class="wj-pc-dlv-timeline">
                            <div class="wj-pc-dlv-tl-step">
                                <span class="wj-pc-dlv-tl-time" t-out="tl_times[0]"/>
                                <span t-attf-class="wj-pc-dlv-tl-dot wj-pc-dlv-tl-dot--#{tl_steps[0]}"/>
                                <span class="wj-pc-dlv-tl-label">Dispatched</span>
                            </div>
                            <span class="wj-pc-dlv-tl-line"/>
                            <div class="wj-pc-dlv-tl-step">
                                <span class="wj-pc-dlv-tl-time" t-out="tl_times[1]"/>
                                <span t-attf-class="wj-pc-dlv-tl-dot wj-pc-dlv-tl-dot--#{tl_steps[1]}"/>
                                <span class="wj-pc-dlv-tl-label">Delivering</span>
                            </div>
                            <span class="wj-pc-dlv-tl-line"/>
                            <div class="wj-pc-dlv-tl-step">
                                <span class="wj-pc-dlv-tl-time" t-out="tl_times[2]"/>
                                <span t-attf-class="wj-pc-dlv-tl-dot wj-pc-dlv-tl-dot--#{tl_steps[2]}"/>
                                <span class="wj-pc-dlv-tl-label">Finished</span>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Products -->
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_class" t-value="'wj-pc-card'"/>
                    <!-- Nút "Tải danh sách" đi vào slot `control` (bề mặt bấm nhìn thấy
                         được) chứ không phải `action` dạng chữ. -->
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Products in trip</t>
                        <t t-set="ch_subtitle">Table view to quickly check product names, quantities and units.</t>
                        <t t-set="ch_platform" t-value="'pc'"/>
                        <t t-set="ch_control">
                            <a href="#" class="wj-btn wj-btn--secondary wj-btn--sm wj-card-header__control"><i class="feather icon-download"/>Download list</a>
                        </t>
                    </t>
                    <table class="wj-pc-table wj-pc-dlv-table">
                        <thead>
                            <tr>
                                <th style="width:56px;">No.</th>
                                <th>Product name</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">UoM</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="products" t-foreach="products" t-as="p">
                                <td class="wj-pc-td--muted" t-out="p_index + 1"/>
                                <td t-out="p['name']"/>
                                <td class="text-end wj-pc-td--amount" t-out="'%g' % p['qty']"/>
                                <td class="text-end wj-pc-td--muted" t-out="p['uom']"/>
                            </tr>
                            <tr t-if="not products">
                                <td colspan="4" class="text-center wj-pc-td--muted">No products in this trip yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>

            <!-- Mobile <992px — Figma 4731:155 (delivery detail), batch-centric (S24) -->
            <div class="d-lg-none wujia-mpage wujia-mdelivery">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Delivery details</t>
                    <t t-set="ph_back_url" t-value="'/portal/delivery'"/>
                </t>

                <!-- Batch info -->
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wujia-mdelivery-inf-top">
                        <span class="wujia-mdelivery-row-label">Vehicle trip</span>
                        <span t-attf-class="wj-status-badge #{m_badge[1]}" t-out="m_badge[0]"/>
                    </div>
                    <div class="wujia-mdelivery-inf-id" t-out="batch.name"/>
                    <div class="wujia-mdelivery-row-divider"/>
                    <div class="wujia-mdelivery-inf-dep">
                        <i class="feather icon-calendar wujia-mdelivery-row-colicon"/>
                        <span class="wujia-mdelivery-row-colbody">
                            <span class="wujia-mdelivery-row-collabel" t-out="m_departure_label"/>
                            <span class="wujia-mdelivery-inf-depval" t-out="m_departure_full"/>
                        </span>
                    </div>
                    <div class="wujia-mdelivery-inf-updated">Updated: <t t-out="m_updated"/></div>
                </t>

                <!-- Thông tin chuyến -->
                <div class="wujia-mdelivery-sectiontop">Trip information</div>
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wujia-mdelivery-inforow">
                        <span class="lbl">Related orders</span>
                        <span class="val" t-out="m_orders"/>
                    </div>
                    <div class="wujia-mdelivery-inforow">
                        <span class="lbl">Vehicle / driver</span>
                        <span class="val">
                            <t t-if="batch.vehicle_id"><t t-out="batch.vehicle_id.name or '—'"/><t t-if="batch.vehicle_id.driver_name"> · <t t-out="batch.vehicle_id.driver_name"/></t></t>
                            <t t-else="">—</t>
                        </span>
                    </div>
                    <div class="wujia-mdelivery-inforow">
                        <span class="lbl">License plate</span>
                        <span class="val" t-out="batch.vehicle_id.license_plate or '—'"/>
                    </div>
                </t>

                <!-- Sản phẩm trong chuyến -->
                <div class="wujia-mdelivery-sectiontop">Products in trip</div>
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_body" t-value="'flush'"/>
                    <t t-set="sc_class" t-value="'wujia-mdelivery-prodcard'"/>
                    <div class="wujia-mdelivery-prodrow wujia-mdelivery-prodrow--head">
                        <span class="nm">Product name</span>
                        <span class="qt">Qty</span>
                        <span class="um">UoM</span>
                    </div>
                    <t t-if="products" t-foreach="products" t-as="p">
                        <div class="wujia-mdelivery-prodrow">
                            <span class="nm" t-out="p['name']"/>
                            <span class="qt" t-out="'%g' % p['qty']"/>
                            <span class="um" t-out="p['uom']"/>
                        </div>
                    </t>
                    <div t-if="not products" class="wujia-mdelivery-prodempty">No products in this trip yet.</div>
                </t>
            </div>
        </t>
    </template>

</odoo>
