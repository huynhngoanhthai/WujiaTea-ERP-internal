<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== Khối kết quả (swap được bằng AJAX khi lọc/phân trang) ==============
         4 mảnh dùng chung trang đầy đủ và /portal/order/results: card sản phẩm + pager PC,
         bộ đếm mobile, chip danh mục mobile, thân danh sách mobile. Giỏ hàng KHÔNG nằm
         trong đây — portal_cart_sync.js vẫn lo như cũ. -->
    <template id="portal_order_catalog_results_part" name="Wujia Portal — Catalog Results Part">
        <!-- t-set phải nằm TRONG đây, không phải ở trang: /portal/order/results chỉ gọi
             part nên t-set đặt ngoài sẽ không tồn tại ⇒ KeyError cart_qty_map. -->
        <t t-set="cart_qty_map"
           t-value="{l['product_id']: l['qty'] for l in cart_state['lines']} if cart_state else {}"/>
        <t t-set="has_spec" t-value="any(p.wujia_packaging for p in products)"/>
        <div t-if="part == 'pc'" id="wj-ord-pc">
            <!-- Product card -->
            <t t-call="wujia_portal_layout.wj_surface_card">
                <t t-set="sc_class" t-value="'wj-pc-card wj-pc-order-card'"/>
                <t t-call="wujia_portal_layout.wj_section_header">
                    <t t-set="sh_title">Product list</t>
                    <t t-set="sh_level" t-value="3"/>
                    <t t-set="sh_platform" t-value="'pc'"/>
                    <t t-set="sh_meta">
                        <span class="wj-section-header__meta"><t t-out="product_count"/> products</span>
                    </t>
                </t>
                <div t-if="not products" class="wj-empty-state">
                    <i class="feather icon-package"/>
                    <p>No matching products.</p>
                </div>
                <t t-else="">
                    <table class="wj-pc-order-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th t-if="has_spec">Specification</th>
                                <th>UoM</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="products" t-as="product"
                                t-attf-class="wj-pc-order-row #{'wj-pc-order-row--incart' if cart_qty_map.get(product.id, 0) else ''}">
                                <t t-set="in_cart" t-value="cart_qty_map.get(product.id, 0)"/>
                                <td>
                                    <a t-attf-href="/portal/order/product/#{product.id}"
                                       class="wj-pc-order-prod">
                                        <span class="wj-pc-order-prod-name" t-out="product.name"/>
                                        <span t-if="product.name_chinese"
                                              class="wj-pc-order-prod-cn" t-out="product.name_chinese"/>
                                    </a>
                                </td>
                                <td t-if="has_spec" class="wj-pc-order-spec"
                                    t-out="product.wujia_packaging or '—'"/>
                                <td class="wj-pc-order-uom" t-out="product.uom_id.name or '—'"/>
                                <td class="text-end wj-pc-order-price"
                                    t-out="money(price_map.get(product.id), cart_state['currency_symbol'] if cart_state else '', cart_state['currency_decimals'] if cart_state else 0)"/>
                                <td class="text-center">
                                    <button type="button"
                                            class="wj-pc-order-add btn-add-cart"
                                            t-att-data-product-id="product.id"
                                            t-att-data-min-qty="product.min_qty or 1"
                                            t-att-data-max-qty="str(product.max_qty or 0)"
                                            aria-label="Add to cart">
                                        <i class="feather icon-shopping-cart"/>
                                        <span t-attf-class="wj-pc-order-add-badge #{'' if in_cart else 'd-none'}"
                                              t-out="in_cart"/>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </t>

            <!-- Pager chung CMP-PGNT-001 (nằm trong #wj-ord-pc ⇒ đổi trang không reload) -->
            <t t-call="wujia_portal_layout.wj_pagination"/>
        </div>

        <!-- Meta PageHeader (CMP-PG-001) — H1 nay do shared wj_page_header dựng; giữ nguyên
             id để wj_ajax_list vẫn thay được số SP sau khi lọc. Luôn render (rỗng khi 0 SP). -->
        <span t-if="part == 'mcount'" id="wj-ord-mcount" class="wj-page-header__meta">
            <t t-if="products"><t t-out="len(products)"/> SKUs</t>
        </span>
        <span t-if="part == 'pccount'" id="wj-ord-pccount" class="wj-page-header__meta">
            <t t-if="products"><t t-out="len(products)"/> SKUs</t>
        </span>

        <!-- Luôn render (ẩn khi chưa có danh mục) — AJAX cần chỗ để thay. -->
        <div t-if="part == 'mchips'" id="wj-ord-mchips" class="wj-filter-chips wujia-morder-chips"
             t-att-hidden="None if categories else 'hidden'">
            <a t-attf-href="/portal/order#{('?keyword=' + keyword) if keyword else ''}"
               t-attf-class="wj-filter-chip wj-filter-chip--soft #{'is-active' if not category_id else ''}">All</a>
            <t t-foreach="categories" t-as="cat">
                <a t-attf-href="/portal/order?category_id=#{cat.id}#{('&amp;keyword=' + keyword) if keyword else ''}"
                   t-attf-class="wj-filter-chip wj-filter-chip--soft #{'is-active' if category_id == cat.id else ''}"
                   t-out="cat.name"/>
            </t>
        </div>

        <div t-if="part == 'mbody'" id="wj-ord-mbody" class="wj-ajax-slot">
            <!-- List header — CMP-SH-001: count dùng TỪ ĐẦY ĐỦ và hiện cả khi = 0 -->
            <t t-call="wujia_portal_layout.wj_section_header">
                <t t-set="sh_title">Product list</t>
                <t t-set="sh_level" t-value="3"/>
                <t t-set="sh_platform" t-value="'m'"/>
                <t t-set="sh_meta">
                    <span class="wj-section-header__meta"><t t-out="len(products)"/> products</span>
                </t>
            </t>

            <!-- Empty -->
            <div t-if="not products" class="wujia-empty-state">
                <i class="feather icon-package"/>
                <p>No matching products.</p>
            </div>

            <!-- Product compact rows -->
            <t t-else="">
                <!-- J-V4: nhãn aria theo tên SP — câu dịch được (<t t-set>), ghép tên bằng %. -->
                <t t-set="_os_t_add">Add %s to cart</t>
                <t t-set="_os_t_adjust">Adjust quantity of %s</t>
                <t t-set="_os_t_dec">Decrease %s</t>
                <t t-set="_os_t_qty">Quantity of %s</t>
                <t t-set="_os_t_inc">Increase %s</t>
                <div class="wujia-morder-list">
                    <t t-foreach="products" t-as="product">
                        <t t-set="in_cart" t-value="cart_qty_map.get(product.id, 0)"/>
                        <div class="wujia-morder-row">
                            <!-- UI-MOB-ORDER-002: ảnh SP nếu có, else icon placeholder (bỏ ĐVT lặp) -->
                            <span class="wujia-morder-row-thumb">
                                <img t-if="product.image_128" class="wujia-morder-row-thumb-img"
                                     t-attf-src="/web/image/product.product/#{product.id}/image_128" alt=""/>
                                <i t-else="" class="feather icon-package wujia-morder-row-thumb-ph"/>
                            </span>
                            <!-- RESP-MOB-ORDER-002: tên chiếm nguyên hàng trên của card (grid
                                 2 hàng), giá + ĐVT + nút giỏ xuống hàng dưới — theo đúng đề xuất
                                 BA. 4 con của .wujia-morder-row = 4 ô grid, đừng bọc thêm lớp. -->
                            <a t-attf-href="/portal/order/product/#{product.id}"
                               class="wujia-morder-row-name" t-out="product.name"/>
                            <span class="wujia-morder-row-meta">
                                <span class="wujia-morder-row-spec"
                                      t-out="product.wujia_packaging or product.uom_id.name or '—'"/>
                                <span class="wujia-morder-row-price"
                                      t-out="money(price_map.get(product.id), cart_state['currency_symbol'] if cart_state else '', cart_state['currency_decimals'] if cart_state else 0)"/>
                            </span>
                            <!-- WJ-ORD-021: qty=0 → nút "Thêm"; qty>0 → stepper "− N +"
                                 (giảm ở min = xoá dòng qua /cart/step product_id). data-qty
                                 điều khiển hiển thị; JS applyState morph theo qty_map.
                                 WJ-ORD-010: aria-label = action + tên SP. KHÔNG dùng
                                 .btn-add-cart (delegation ở portal_cart_sync, tránh
                                 double-bind với portal_order.js DOMContentLoaded). -->
                            <div class="wujia-morder-cartctl"
                                 t-att-data-product-id="product.id"
                                 t-att-data-min-qty="product.min_qty or 1"
                                 t-att-data-max-qty="str(product.max_qty or 0)"
                                 t-attf-data-qty="#{in_cart}">
                                <button type="button" class="wujia-morder-row-add wujia-morder-add-btn wj-state-surface"
                                        t-att-aria-label="_os_t_add % product.name">
                                    <i class="feather icon-shopping-cart"/>
                                </button>
                                <div class="wujia-morder-mstepper" role="group"
                                     t-att-aria-label="_os_t_adjust % product.name">
                                    <button type="button" class="wujia-morder-mstep wujia-morder-mstep-minus wj-state-surface"
                                            t-att-aria-label="_os_t_dec % product.name">−</button>
                                    <span class="wujia-morder-mstep-qty" aria-live="polite"
                                          t-att-aria-label="_os_t_qty % product.name" t-out="in_cart"/>
                                    <button type="button" class="wujia-morder-mstep wujia-morder-mstep-plus wj-state-surface"
                                            t-att-aria-label="_os_t_inc % product.name">+</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Trước E3c mobile không có nút trang nào dù server vẫn cắt 24 SP/trang
                 ⇒ người dùng điện thoại không xem được sản phẩm từ trang 2. -->
            <t t-call="wujia_portal_layout.wj_pagination"/>

        </div>

    </template>

    <!-- Fragment AJAX: cả 4 mảnh, JS thay từng khối theo id. -->
    <template id="portal_order_catalog_results" name="Wujia Portal — Catalog Results Fragment">
        <div t-if="not no_franchise">
            <t t-foreach="['pc', 'pccount', 'mcount', 'mchips', 'mbody']" t-as="pt">
                <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                    <t t-set="part" t-value="pt"/>
                </t>
            </t>
        </div>
    </template>

    <template id="portal_order_catalog" name="Wujia Portal — Order Catalog">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="pc_bottom" t-value="'sticky'"/>
            <t t-set="title">Order</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/order'"/>
                <t t-set="wjl_slots" t-value="'wj-ord-pc,wj-ord-pccount,wj-ord-mcount,wj-ord-mchips,wj-ord-mbody'"/>
                <t t-set="wjl_fragment" t-value="'/portal/order/results'"/>
            </t>
            <div class="content-wrapper">
                <!-- Realtime cart sync root — bus channel wujia.franchise_<id> (Sprint 31). -->
                <t t-call="wujia_portal_sale.cart_sync_root"/>
                <!-- Sprint 30: products = product.product, giá từ price_map (pricelist),
                     giỏ chung theo store (cart_state dict từ controller).
                     WJ-ORD-009: cột Quy cách chỉ hiện khi ÍT NHẤT 1 SP có dữ liệu thực.
                     Cả cart_qty_map lẫn has_spec nay t-set trong portal_order_catalog_results_part
                     (chỉ dùng ở đó, và fragment /results cần chúng). -->

                <!-- ===== DESKTOP (≥992px) — PC combined catalog + cart (Figma PC_Product_Cart 4600:2, Sprint PC-1) ===== -->
                <div class="d-none d-lg-block">
                    <div t-if="no_franchise" class="alert alert-warning m-3">
                        You are not assigned to any store — ordering is unavailable.
                    </div>
                    <t t-else="">
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'pc'"/>
                            <t t-set="ph_variant" t-value="'title'"/>
                            <t t-set="ph_title">Order</t>
                            <t t-set="ph_meta">
                                <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                                    <t t-set="part" t-value="'pccount'"/>
                                </t>
                            </t>
                        </t>

                        <div t-if="error" class="alert alert-danger" role="alert"><t t-esc="error"/></div>
                        <div t-if="message" class="alert alert-success" role="status"><t t-esc="message"/></div>

                        <div class="wj-pc-order-grid">
                            <!-- LEFT: catalog -->
                            <div class="wj-pc-order-main">
                                <!-- WJ-ORD-023 (E4b1: về component CMP-FB-001) — select cũ
                                     không khai width nên ăn `select{width:100%}` của shell
                                     dashboard.css → wrap 3 hàng. -->
                                <t t-set="_os_t_search_ph">Search by product name, product code...</t>
                                <t t-set="_os_t_category">Category</t>
                                <t t-set="_os_t_all_categories">All categories</t>
                                <t t-call="wujia_portal_layout.wj_filter_bar">
                                    <t t-set="fb_platform" t-value="'pc'"/>
                                    <t t-set="fb_action" t-value="'/portal/order'"/>
                                    <t t-set="fb_class" t-value="'wj-pc-order-filter'"/>
                                    <t t-set="fb_search"
                                       t-value="{'name': 'keyword', 'value': keyword,
                                                 'placeholder': _os_t_search_ph}"/>
                                    <t t-set="fb_selects"
                                       t-value="[{'name': 'category_id', 'value': category_id,
                                                  'label': _os_t_category,
                                                  'all_label': _os_t_all_categories,
                                                  'auto': True,
                                                  'options': [(c.id, c.name) for c in categories]}]"/>
                                </t>

                                <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                                    <t t-set="part" t-value="'pc'"/>
                                </t>
                            </div>

                            <!-- RIGHT: full cart panel (shared partial) -->
                            <div class="wj-pc-order-side">
                                <t t-call="wujia_portal_sale.pc_cart_panel"/>
                            </div>
                        </div>
                    </t>
                </div>
                <!-- /desktop wrapper -->
                <!-- WJ-ORD-028: panel giỏ PC ở catalog cũng có nút gửi đơn. -->
                <t t-if="not no_franchise" t-call="wujia_portal_sale.order_confirm_modal"/>
                <t t-if="not no_franchise" t-call="wujia_portal_sale.cart_remove_modal"/>

                <!-- ===== MOBILE (<992px) — BA UI Registry v3 + Figma 2480:2 ===== -->
                <div class="d-lg-none wujia-morder">
                    <div t-if="no_franchise" class="alert alert-warning" role="alert">
                        You are not assigned to any store — ordering is unavailable.
                    </div>
                    <t t-else="">
                        <!-- WJ-ORD-005: H1 = task chính "Đặt hàng"; bộ đếm SP cùng hàng bên phải,
                             cập nhật theo số SP đang hiển thị sau tìm/lọc. Từ CMP-PG-001 dùng
                             shared PageHeader thay title row riêng. -->
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'m'"/>
                            <t t-set="ph_variant" t-value="'title'"/>
                            <t t-set="ph_title">Order</t>
                            <t t-set="ph_meta">
                                <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                                    <t t-set="part" t-value="'mcount'"/>
                                </t>
                            </t>
                        </t>

                        <div t-if="error" class="alert alert-danger" role="alert"><t t-esc="error"/></div>
                        <div t-if="message" class="alert alert-success" role="status"><t t-esc="message"/></div>

                        <!-- Order warning bar — cùng kết quả với chặn submit (giờ địa phương cửa hàng). -->
                        <div t-if="order_window_enabled"
                             t-attf-class="wujia-morder-warnbar #{'wujia-morder-warnbar--open' if order_window_open else 'wujia-morder-warnbar--closed'}">
                            <i t-attf-class="feather #{'icon-check-circle' if order_window_open else 'icon-alert-circle'}"/>
                            <span t-if="order_window_open">Within ordering hours: <t t-out="order_window_label"/></span>
                            <span t-elif="order_window_tz_missing"><t t-set="wj_txt">The store's timezone is not configured, so ordering is unavailable. Please contact {brand}.</t><t t-out="wj_txt.replace('{brand}', wj_brand['name'])"/></span>
                            <span t-else="">Outside ordering hours — reopens at <t t-out="order_window_reopen"/>. Window: <t t-out="order_window_label"/></span>
                        </div>

                        <!-- Search box — FUNC-MOB-ORDER-006: nút "Tìm" hiện rõ (không
                             chỉ dựa Enter bàn phím ảo; nhiều bàn phím không có nút Go). -->
                        <form method="get" action="/portal/order" class="wujia-morder-search">
                            <label class="wujia-morder-search-input">
                                <i class="feather icon-search"/>
                                <input type="text" name="keyword" placeholder="Enter a product name to search"
                                       t-att-value="keyword"/>
                            </label>
                            <!-- WJ-ORD-027: LUÔN render (rỗng = mọi danh mục). Chip đổi danh mục qua
                                 wj_ajax_list không reload, JS đồng bộ ô này theo URL; render có điều
                                 kiện thì trang mở từ "Tất cả" mất ô ⇒ tìm sau khi chọn chip rơi danh mục. -->
                            <input type="hidden" name="category_id"
                                   t-att-value="category_id or ''"/>
                            <button type="submit" class="wujia-morder-search-btn wj-state-surface" aria-label="Search products">
                                <i class="feather icon-search"/>
                            </button>
                        </form>

                        <!-- Category chips (wj-filter-chip — Sprint 19 canonical) -->
                        <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                            <t t-set="part" t-value="'mchips'"/>
                        </t>

                        <t t-call="wujia_portal_sale.portal_order_catalog_results_part">
                            <t t-set="part" t-value="'mbody'"/>
                        </t>
                        <!-- Floating cart bar — luôn render, ẩn khi giỏ trống (JS toggle realtime) -->
                        <a href="/portal/order/cart"
                           t-attf-class="wujia-morder-floatbar #{'' if (cart_state and cart_state['line_count']) else 'd-none'}"
                           t-att-data-cart-total="int(cart_state['total_amount']) if cart_state else 0">
                            <span class="wujia-morder-floatbar-icon">
                                <i class="feather icon-shopping-cart"/>
                            </span>
                            <span class="wujia-morder-floatbar-info">
                                <span class="wujia-morder-floatbar-title">Cart</span>
                                <span class="wujia-morder-floatbar-sub">
                                    <!-- WJ-ORD-022: line_count = số mặt hàng (SKU), KHÁC total_qty -->
                                    <span class="wujia-morder-floatbar-count" t-out="cart_state['line_count'] if cart_state else 0"/> items •
                                    <!-- Ký hiệu nằm TRONG span (trước đây ở ngoài) để JS ghi đè
                                         cả số lẫn ký hiệu bằng cùng một nguồn currency (WJ-ORD-025).
                                         Số = Tổng thanh toán đã thuế, khớp giỏ. -->
                                    <span class="wujia-morder-floatbar-total"
                                          t-out="money(cart_state['total_tax_included'] if cart_state else 0, cart_state['currency_symbol'] if cart_state else '', cart_state['currency_decimals'] if cart_state else 0)"/>
                                </span>
                            </span>
                            <span class="wujia-morder-floatbar-btn">View cart</span>
                        </a>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>
