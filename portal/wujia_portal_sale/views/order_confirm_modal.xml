<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WJ-ORD-028 (G5) — hộp xác nhận cuối trước khi gửi đơn, dùng chung PC + mobile.

         Dáng = Modal của khung (`wj-pc-modal__*`, `_pc_components.css`): panel 420, tự co
         `100vw - 32px` ở mobile nên không dựng component thứ hai. Đặt ở CẤP TRANG, ngoài panel
         giỏ: cart sync thay innerHTML panel mỗi lần reconcile, modal nằm trong sẽ bị xoá khi đang mở.

         Số liệu không render ở đây — JS đọc `data-oc-*` của CHÍNH form gửi đơn lúc mở (form nằm trong
         panel được thay mới nên số luôn khớp giỏ hiện tại), ghi chú đọc từ ô đang gõ. -->
    <template id="order_confirm_modal" name="Wujia Portal — Confirm order submission">
        <div class="wj-pc-modal__backdrop wj-order-confirm" id="wjOrderConfirm" hidden="hidden">
            <div class="wj-pc-modal__panel wj-order-confirm__panel" role="dialog" aria-modal="true"
                 aria-labelledby="wjOrderConfirmTitle" aria-describedby="wjOrderConfirmDesc">
                <h2 class="wj-pc-modal__title" id="wjOrderConfirmTitle">Confirm order</h2>
                <t t-set="wj_txt">Review the details before submitting your order to {brand}.</t>
                <p class="wj-pc-modal__body" id="wjOrderConfirmDesc" t-out="wj_txt.replace('{brand}', wj_brand['name'])"/>
                <p class="wj-order-confirm__changed" data-wj-oc="changed" role="alert" hidden="hidden">
                    The cart has just changed. Please review it before submitting.
                </p>
                <hr class="wj-pc-modal__divider"/>
                <dl class="wj-order-confirm__list">
                    <div class="wj-order-confirm__row">
                        <dt>Store</dt>
                        <dd data-wj-oc="store"/>
                    </div>
                    <div class="wj-order-confirm__row">
                        <dt>Number of items</dt>
                        <dd data-wj-oc="lines"/>
                    </div>
                    <div class="wj-order-confirm__row">
                        <dt>Total quantity</dt>
                        <dd data-wj-oc="qty"/>
                    </div>
                    <div class="wj-order-confirm__row wj-order-confirm__row--grand">
                        <dt>Grand total</dt>
                        <dd data-wj-oc="total"/>
                    </div>
                    <div class="wj-order-confirm__row wj-order-confirm__row--note">
                        <dt>Note</dt>
                        <dd data-wj-oc="note"/>
                    </div>
                </dl>
                <div class="wj-pc-modal__actions wj-order-confirm__actions">
                    <button type="button" class="wj-btn wj-btn--secondary" data-wj-oc-action="cancel">Cancel</button>
                    <button type="button" class="wj-btn wj-btn--primary" data-wj-oc-action="confirm">Confirm order</button>
                </div>
            </div>
        </div>
    </template>

    <!-- Hộp hỏi trước khi xoá một dòng giỏ (thay `window.confirm`), cùng khuôn với hộp trên nên
         không thêm CSS. Tên sản phẩm do portal_cart_sync.js điền lúc mở; đặt ở cấp trang vì panel
         giỏ bị thay mỗi lần reconcile. -->
    <template id="cart_remove_modal" name="Wujia Portal — Confirm cart line removal">
        <div class="wj-pc-modal__backdrop wj-order-confirm" id="wjCartRemove" hidden="hidden">
            <div class="wj-pc-modal__panel wj-order-confirm__panel" role="dialog" aria-modal="true"
                 aria-labelledby="wjCartRemoveTitle" aria-describedby="wjCartRemoveName">
                <h2 class="wj-pc-modal__title" id="wjCartRemoveTitle">Remove this product from the cart?</h2>
                <p class="wj-pc-modal__body" id="wjCartRemoveName" data-wj-cr="name"/>
                <div class="wj-pc-modal__actions wj-order-confirm__actions">
                    <button type="button" class="wj-btn wj-btn--secondary" data-wj-cr-action="cancel">Cancel</button>
                    <button type="button" class="wj-btn wj-btn--danger" data-wj-cr-action="confirm">Remove</button>
                </div>
            </div>
        </div>
    </template>
</odoo>
