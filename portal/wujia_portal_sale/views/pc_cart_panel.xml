<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sprint PC-1 — shared PC cart panel (Figma PC_Product_Cart 4600:2).
         Sprint 30: đọc từ cart_state (dict controller — giỏ chung theo store,
         giá tính lại từ pricelist mỗi render).
         Context vars: cart_state, order_window_enabled, order_time_from/to, window_label. -->
    <template id="pc_cart_panel" name="Wujia PC — Cart panel (shared)">
        <t t-set="cs_lines" t-value="cart_state['lines'] if cart_state else []"/>
        <div class="wj-pc-cart">
            <t t-call="wujia_portal_layout.wj_card_header">
                <t t-set="ch_title">Cart</t>
                <t t-set="ch_platform" t-value="'pc'"/>
                <!-- WJ-ORD-022: header = số MẶT HÀNG (SKU), phân biệt tổng số lượng dưới -->
                <t t-set="ch_meta">
                    <span class="wj-pc-cart-count wj-count-meta wj-count-meta--bold">
                        <t t-out="len(cs_lines)"/> items
                    </span>
                </t>
            </t>

            <!-- Warning bar khung giờ — WJ-ORD-006: màu + nội dung theo order_window_open
                 (server tính theo store tz); WJ-ORD-015: label khung qua đêm + múi giờ cửa hàng. -->
            <div t-if="order_window_enabled"
                 t-attf-class="wj-pc-cart-warnbar #{'wj-pc-cart-warnbar--open' if order_window_open else 'wj-pc-cart-warnbar--closed'}">
                <i t-attf-class="feather #{'icon-check-circle' if order_window_open else 'icon-alert-circle'}"/>
                <span t-if="order_window_open">Within ordering hours: <t t-out="order_window_label"/></span>
                <span t-elif="order_window_tz_missing"><t t-set="wj_txt">The store's timezone is not configured, so ordering is unavailable. Please contact {brand}.</t><t t-out="wj_txt.replace('{brand}', wj_brand['name'])"/></span>
                <span t-else="">Outside hours — reopens at <t t-out="order_window_reopen"/>. Window: <t t-out="order_window_label"/></span>
            </div>

            <!-- Empty -->
            <div t-if="not cs_lines" class="wj-pc-cart-empty">
                <span class="wj-pc-cart-empty-icon"><i class="feather icon-shopping-cart"/></span>
                <p class="wj-pc-cart-empty-text">Cart is empty</p>
                <a href="/portal/order" class="wj-btn wj-btn--secondary">Continue shopping</a>
            </div>

            <t t-else="">
                <!-- Cart rows (AJAX stepper/remove — wj-pc-cart-* hooks) -->
                <div class="wj-pc-cart-table-wrap">
                    <table class="wj-pc-cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Line total</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="cs_lines" t-as="line" class="wj-pc-cart-row"
                                t-att-data-line-id="line['line_id']"
                                t-att-data-unit-price="int(line['unit_price'] or 0)"
                                t-att-data-min-qty="line['min_qty'] or 1"
                                t-att-data-max-qty="str(line['max_qty'] or 0)"
                                t-att-data-product-id="line['product_id']">
                                <td class="wj-pc-cart-prod">
                                    <span class="wj-pc-cart-prod-name" t-out="line['name']"/>
                                    <span class="wj-pc-cart-prod-uom" t-out="line['uom']"/>
                                    <span t-if="line['invalid_reason']"
                                          class="wj-pc-cart-prod-warn text-danger"
                                          t-out="line['invalid_message']"/>
                                </td>
                                <td class="text-end wj-pc-cart-unit"
                                    t-out="money(line['unit_price_tax_included'], cart_state['currency_symbol'], cart_state['currency_decimals'])"/>
                                <td class="text-center">
                                    <div class="wj-pc-stepper">
                                        <button type="button" class="wj-pc-cart-step wj-state-surface" data-action="dec"
                                                t-att-data-line-id="line['line_id']" aria-label="Decrease">−</button>
                                        <span class="wj-pc-cart-qty" t-out="line['qty']"/>
                                        <button type="button" class="wj-pc-cart-step wj-state-surface" data-action="inc"
                                                t-att-data-line-id="line['line_id']" aria-label="Increase">+</button>
                                    </div>
                                </td>
                                <td class="text-end wj-pc-cart-subtotal"
                                    t-out="money(line['line_total_tax_included'], cart_state['currency_symbol'], cart_state['currency_decimals'])"/>
                                <td class="text-center">
                                    <button type="button" class="wj-iconbtn wj-iconbtn--ghost wj-iconbtn--sm wj-pc-cart-del"
                                            t-att-data-line-id="line['line_id']"
                                            aria-label="Remove product from cart" title="Remove product from cart">
                                        <i class="feather icon-trash-2"/>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Note + totals + submit (only note submitted; address dropped per Figma) -->
                <!-- WJ-ORD-028: data-oc-* = số liệu hộp xác nhận, render cùng panel nên luôn khớp giỏ. -->
                <form method="POST" action="/portal/order/submit" class="wj-pc-cart-foot"
                      data-wj-confirm-form="1"
                      t-att-data-oc-store="cart_state['store_name'] if cart_state else ''"
                      t-att-data-oc-lines="cart_state['line_count'] if cart_state else 0"
                      t-att-data-oc-qty="cart_state['total_qty'] if cart_state else 0"
                      t-att-data-oc-total="money(cart_state['total_tax_included'], cart_state['currency_symbol'], cart_state['currency_decimals']) if cart_state else ''">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label class="wj-pc-cart-note-label" for="wj-pc-cart-note">Order note</label>
                    <!-- Note chung của giỏ (mọi user cùng store) — autosave qua /cart/note.
                         wj-cart-note = hook chung PC/mobile: autosave + guard swap khi đang gõ. -->
                    <t t-set="wj_txt">Enter a note for {brand} if needed</t>
                    <textarea id="wj-pc-cart-note" name="portal_note" class="wj-pc-cart-note wj-cart-note" rows="2"
                              t-att-placeholder="wj_txt.replace('{brand}', wj_brand['name'])"
                              t-out="cart_state['note'] if cart_state else ''"/>
                    <div class="wj-pc-cart-totals">
                        <div class="wj-pc-cart-total-line">
                            <!-- WJ-ORD-022: total_qty = TỔNG SỐ LƯỢNG (đơn vị), nhãn tường minh -->
                            <span class="wj-pc-cart-total-label">Total quantity</span>
                            <span class="wj-pc-cart-total-qty"><t t-out="cart_state['total_qty'] if cart_state else 0"/></span>
                        </div>
                        <!-- WJ-ORD-024: cùng breakdown với giỏ mobile — Tạm tính · Thuế ·
                             Tổng thanh toán, cùng nguồn `cart_state` nên không thể lệch nhau. -->
                        <div class="wj-pc-cart-total-line">
                            <span class="wj-pc-cart-total-label">Subtotal</span>
                            <span t-out="money(cart_state['total_untaxed'] if cart_state else 0, cart_state['currency_symbol'] if cart_state else '', cart_state['currency_decimals'] if cart_state else 0)"/>
                        </div>
                        <div t-if="cart_state and cart_state['total_tax_amount']" class="wj-pc-cart-total-line">
                            <span class="wj-pc-cart-total-label">Tax</span>
                            <span t-out="money(cart_state['total_tax_amount'], cart_state['currency_symbol'], cart_state['currency_decimals'])"/>
                        </div>
                        <div class="wj-pc-cart-total-line">
                            <span class="wj-pc-cart-total-label wj-pc-cart-total-label--grand">Grand total</span>
                            <span class="wj-pc-cart-grand"
                                  t-out="money(cart_state['total_tax_included'] if cart_state else 0, cart_state['currency_symbol'] if cart_state else '', cart_state['currency_decimals'] if cart_state else 0)"/>
                        </div>
                    </div>
                    <!-- WJ-ORD-006: ngoài giờ → disable submit + nêu rõ (server vẫn chặn
                         ORDER_TIME_CLOSED; disable = phản hồi sớm, giỏ vẫn sửa được). -->
                    <!-- WJ-ORD-028: vẫn type=submit (không JS thì gửi thẳng như cũ); có JS thì click mở hộp xác nhận. -->
                    <button type="submit" class="wj-btn wj-btn--primary wj-btn--lg wj-btn--block wj-pc-cart-submit"
                            data-wj-confirm-open="1"
                            t-att-data-wj-window-closed="'1' if (order_window_enabled and not order_window_open) else None"
                            t-att-disabled="'disabled' if (order_window_enabled and not order_window_open) else None">
                        <i class="feather icon-shopping-cart"/> Submit order
                    </button>
                    <p t-if="order_window_enabled and not order_window_open and not order_window_tz_missing" class="wj-pc-cart-submit-hint">
                        Outside hours — you can still edit the cart, submit again at <t t-out="order_window_reopen"/>.
                    </p>
                </form>
            </t>
        </div>
    </template>

</odoo>
