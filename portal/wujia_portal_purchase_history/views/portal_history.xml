<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== Khối kết quả (swap được bằng AJAX khi lọc) ==============
         7 mảnh: 'pcerr'/'merr' (dòng lỗi khoảng ngày trong bộ lọc — LUÔN render, ẩn
         bằng [hidden] để AJAX có chỗ mà thay), 'pccount'/'mcount' (meta PageHeader),
         'pc' (card bảng desktop), 'mchips' (chip preset mobile trong form lọc),
         'mbody' (list/empty + pager mobile). Trang đầy đủ t-call từng mảnh đúng chỗ;
         /portal/purchase-history/results trả cả 7 để JS thay tại chỗ. -->
    <template id="portal_history_results_part" name="Wujia Portal — History Results Part">
        <!-- CMP-SB-001: variant badge do controller trả ở khoá 'badge' (một nguồn PC+mobile). -->
        <t t-set="_ph_t_not_delivered">Not delivered yet</t>

        <!-- Lỗi khoảng ngày báo tại FilterBar, KHÔNG dùng empty state (WJ-PH-007) -->
        <p t-if="part == 'pcerr'" id="wj-hist-pcerr" class="wj-filter-error" role="alert"
           t-att-hidden="None if filter_error else 'hidden'" t-out="filter_error"/>
        <p t-if="part == 'merr'" id="wj-hist-merr" class="wj-filter-error" role="alert"
           t-att-hidden="None if filter_error else 'hidden'" t-out="filter_error"/>

        <!-- Meta PageHeader (CMP-PG-001 matrix: "{tổng số đơn} đơn") — slot AJAX riêng để
             lọc xong vẫn thay được số. -->
        <t t-set="_ph_n" t-value="(pgn or {}).get('total_items', len(rows))"/>
        <span t-if="part == 'pccount'" id="wj-hist-pccount" class="wj-page-header__meta">
            <t t-out="_ph_n"/> <t t-if="_ph_n == 1">order</t><t t-else="">orders</t>
        </span>
        <span t-if="part == 'mcount'" id="wj-hist-mcount" class="wj-page-header__meta">
            <t t-out="_ph_n"/> <t t-if="_ph_n == 1">order</t><t t-else="">orders</t>
        </span>

        <!-- ===== PC: card bảng danh sách đơn ===== -->
        <t t-call="wujia_portal_layout.wj_surface_card" t-if="part == 'pc'">
            <t t-set="sc_class" t-value="'wj-pc-card'"/>
            <t t-set="sc_id" t-value="'wj-hist-pc'"/>
            <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
            <t t-call="wujia_portal_layout.wj_card_header">
                <t t-set="ch_title">Order list</t>
                <t t-set="ch_subtitle">Track purchase orders of the active store</t>
                <t t-set="ch_level" t-value="3"/>
                <t t-set="ch_platform" t-value="'pc'"/>
                <t t-set="ch_meta">
                    <span class="wj-pc-card__count"><t t-out="(pgn or {}).get('total_items', len(rows))"/> records</span>
                </t>
            </t>

            <t t-call="wujia_portal_layout.wj_data_list">
                <t t-set="dl_table_class" t-value="'wj-pc-table'"/>
                <t t-set="dl_empty" t-value="not rows"/>
                <t t-set="dl_state">
                    <!-- filter_error đã báo ở FilterBar → không hiện thêm empty state (2 thông điệp mâu thuẫn) -->
                    <div t-if="not filter_error" class="wj-pc-empty">
                        <span class="wj-pc-empty__icon"><i class="feather icon-inbox"/></span>
                        <h3 class="wj-pc-empty__title">No orders yet</h3>
                        <p class="wj-pc-empty__sub">No orders match the filters.</p>
                    </div>
                </t>
                <thead>
                    <tr>
                        <th scope="col">Order code</th>
                        <th scope="col">Created on</th>
                        <th scope="col">Confirmation date</th>
                        <th scope="col">Ordered by</th>
                        <th scope="col" class="text-end">Total amount</th>
                        <th scope="col">Batch / delivery</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="r">
                        <td class="wj-pc-td--code">
                            <a t-attf-href="/portal/purchase-history/#{r['id']}" class="wj-pc-link" t-out="r['name']"/>
                        </td>
                        <td class="wj-pc-td--muted" t-out="r['create_date'] and r['create_date'].strftime('%d/%m/%Y %H:%M') or '—'"/>
                        <!-- WJ-ORD-029: draft/sent chưa có ngày xác nhận ⇒ "—" (date_order của báo giá chỉ là giờ tạo). -->
                        <td class="wj-pc-td--muted" t-out="r['confirm_date'] and r['confirm_date'].strftime('%d/%m/%Y') or '—'"/>
                        <td t-out="r['requester_display']"/>
                        <td class="text-end wj-pc-td--amount" t-out="money(r['amount_total'], r['currency_symbol'], r['currency_decimals'])"/>
                        <td t-out="r['batch_name'] or _ph_t_not_delivered"/>
                        <td>
                            <span t-attf-class="wj-status-badge #{r['badge']}" t-out="r['state_label']"/>
                        </td>
                    </tr>
                </tbody>
            </t>
            <t t-if="rows" t-call="wujia_portal_layout.wj_pagination"/>
        </t>

        <!-- ===== Mobile: chip preset (nằm trong form lọc) ===== -->
        <div t-if="part == 'mchips'" id="wj-hist-mchips" class="wj-filter-chips">
            <a href="/portal/purchase-history?preset=this_month"
               t-attf-class="wj-filter-chip #{'is-active' if preset == 'this_month' else ''}">This month</a>
            <a href="/portal/purchase-history?preset=last_month"
               t-attf-class="wj-filter-chip #{'is-active' if preset == 'last_month' else ''}">Previous month</a>
            <a href="/portal/purchase-history?state=sale"
               t-attf-class="wj-filter-chip #{'is-active' if state == 'sale' else ''}">Confirmed</a>
            <!-- WJ-PH-003: mobile không có ô chọn trạng thái ⇒ chip riêng để tra cứu đơn huỷ. -->
            <a href="/portal/purchase-history?state=cancel"
               t-attf-class="wj-filter-chip #{'is-active' if state == 'cancel' else ''}">Cancelled</a>
            <a href="/portal/purchase-history" class="wj-filter-chip wj-filter-chip--clear">Clear filters</a>
        </div>

        <!-- ===== Mobile: thân kết quả (listhead + list/empty + pager) ===== -->
        <div t-if="part == 'mbody'" id="wj-hist-mbody" class="wj-ajax-slot">
            <!-- Header danh sách (CMP-SH-001) -->
            <t t-call="wujia_portal_layout.wj_section_header">
                <t t-set="sh_title">List of orders</t>
                <t t-set="sh_level" t-value="3"/>
                <t t-set="sh_platform" t-value="'m'"/>
                <t t-set="sh_meta">
                    <span class="wj-section-header__meta"><t t-set="_ph_rn" t-value="len(rows)"/><t t-out="_ph_rn"/> <t t-if="_ph_rn == 1">latest order</t><t t-else="">latest orders</t></span>
                </t>
            </t>

            <!-- Danh sách đơn -->
            <t t-set="mhist_filtered" t-value="q or date_from or date_to or preset or state"/>
            <div t-if="not rows and not filter_error" class="wj-empty-state wj-empty-state--rich">
                <span class="wj-empty-state-icon"/>
                <p class="wj-empty-state-title">No orders yet</p>
                <p class="wj-empty-state-sub">There are no orders to display yet.</p>
                <p class="wj-empty-state-sub">New orders will appear here once updated.</p>
                <a t-if="mhist_filtered" href="/portal/purchase-history" class="wj-btn wj-btn--secondary">Clear filters</a>
                <button t-else="" type="button" class="wj-btn wj-btn--primary" onclick="window.location.reload()">Reload</button>
            </div>
            <t t-call="wujia_portal_layout.wj_data_list" t-if="rows">
                <!-- E5: ruột thành header + 2 hàng phụ ⇒ đúng dáng detail-card (96–120). -->
                <t t-set="dl_variant" t-value="'detail-card'"/>
                <t t-set="dl_class" t-value="'wujia-mhist-list'"/>
                    <a t-foreach="rows" t-as="r" t-attf-href="/portal/purchase-history/#{r['id']}"
                       class="wj-data-item wj-lc">
                        <t t-call="wujia_portal_layout.wj_list_card">
                            <t t-set="lc_name" t-value="r['name']"/>
                            <t t-set="lc_state">
                                <span t-attf-class="wj-status-badge wj-status-badge--compact #{r['badge']}"
                                      t-out="r['state_label']"/>
                            </t>
                            <t t-set="lc_rows">
                                <t t-call="wujia_portal_layout.wj_list_card_row">
                                    <t t-set="lcr_label">Order date</t>
                                    <t t-set="lcr_value"
                                       t-value="r['create_date'] and r['create_date'].strftime('%H:%M · %d/%m/%Y') or '—'"/>
                                </t>
                                <t t-call="wujia_portal_layout.wj_list_card_row">
                                    <t t-set="lcr_label">Total amount</t>
                                    <t t-set="lcr_strong" t-value="True"/>
                                    <t t-set="lcr_value"
                                       t-value="money(r['amount_total'], r['currency_symbol'], r['currency_decimals'])"/>
                                </t>
                            </t>
                        </t>
                    </a>
            </t>

            <t t-call="wujia_portal_layout.wj_pagination"/>
        </div>
    </template>

    <!-- Fragment AJAX: cả 5 mảnh, JS thay từng khối theo id. -->
    <template id="portal_history_results" name="Wujia Portal — History Results Fragment">
        <div t-if="not no_store">
            <t t-foreach="['pcerr', 'pccount', 'pc', 'merr', 'mcount', 'mchips', 'mbody']" t-as="pt">
                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                    <t t-set="part" t-value="pt"/>
                </t>
            </t>
        </div>
    </template>

    <!-- ============== List page ============== -->
    <template id="portal_history_list" name="Wujia Portal — Purchase History List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Order history</t>
            <t t-set="_ph_t_search_ph">Search by order code</t>
            <t t-set="_ph_t_all_status">All statuses</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/purchase-history'"/>
                <t t-set="wjl_slots"
                   t-value="'wj-hist-pcerr,wj-hist-pccount,wj-hist-pc,wj-hist-merr,wj-hist-mcount,wj-hist-mchips,wj-hist-mbody'"/>
                <t t-set="wjl_fragment" t-value="'/portal/purchase-history/results'"/>
            </t>
            <div class="content-wrapper">

                <!-- ============================================================
                     DESKTOP (≥992px) — wj-pc-* theo Figma 4643:258
                     ============================================================ -->
                <div class="d-none d-lg-block">
                    <t t-call="wujia_portal_layout.wj_page_header">
                        <t t-set="ph_platform" t-value="'pc'"/>
                        <t t-set="ph_variant" t-value="'title'"/>
                        <t t-set="ph_title">Order history</t>
                        <t t-if="not no_store">
                            <t t-set="ph_meta">
                                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                                    <t t-set="part" t-value="'pccount'"/>
                                </t>
                            </t>
                        </t>
                    </t>

                    <div t-if="no_store" class="wj-pc-empty">
                        <span class="wj-pc-empty__icon"><i class="feather icon-alert-circle"/></span>
                        <h3 class="wj-pc-empty__title">No store selected</h3>
                        <p class="wj-pc-empty__sub" t-out="error"/>
                    </div>

                    <t t-else="">
                        <t t-call="wujia_portal_layout.wj_filter_bar">
                            <t t-set="fb_platform" t-value="'pc'"/>
                            <t t-set="fb_action" t-value="'/portal/purchase-history'"/>
                            <t t-set="fb_search"
                               t-value="{'name': 'q', 'value': q, 'placeholder': _ph_t_search_ph}"/>
                            <t t-set="fb_dates"
                               t-value="{'from': date_from, 'to': date_to}"/>
                            <t t-set="fb_selects"
                               t-value="[{'name': 'state', 'value': state,
                                          'all_label': _ph_t_all_status,
                                          'options': state_options}]"/>
                            <t t-set="fb_reset_url" t-value="'/portal/purchase-history'"/>
                            <!-- WJ-PH-008: giữ số dòng/trang khi tìm/lọc, đừng bắt chọn lại. -->
                            <t t-set="fb_hidden">
                                <input type="hidden" name="page_size" t-att-value="page_size"/>
                            </t>
                            <t t-set="fb_error">
                                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                                    <t t-set="part" t-value="'pcerr'"/>
                                </t>
                            </t>
                        </t>

                        <!-- Bảng danh sách đơn -->
                        <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                            <t t-set="part" t-value="'pc'"/>
                        </t>
                    </t>
                </div>
                <!-- /desktop -->

                <!-- ============================================================
                     MOBILE (<992px) — Figma 4445:4. Shell shared do app_layout lo.
                     ============================================================ -->
                <div class="d-lg-none wujia-mhist">
                    <t t-call="wujia_portal_layout.wj_page_header">
                        <t t-set="ph_platform" t-value="'m'"/>
                        <t t-set="ph_variant" t-value="'title'"/>
                        <t t-set="ph_title">Order history</t>
                        <t t-if="not no_store">
                            <t t-set="ph_meta">
                                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                                    <t t-set="part" t-value="'mcount'"/>
                                </t>
                            </t>
                        </t>
                    </t>

                    <div t-if="no_store" class="wj-empty-state wj-empty-state--card">
                        <i class="feather icon-alert-circle"/>
                        <p t-out="error"/>
                    </div>

                    <t t-else="">
                        <!-- Filter canonical 03-Advanced -->
                        <t t-call="wujia_portal_layout.wj_filter_bar">
                            <t t-set="fb_platform" t-value="'m'"/>
                            <t t-set="fb_action" t-value="'/portal/purchase-history'"/>
                            <t t-set="fb_search"
                               t-value="{'name': 'q', 'value': q, 'placeholder': _ph_t_search_ph}"/>
                            <t t-set="fb_dates"
                               t-value="{'from': date_from, 'to': date_to}"/>
                            <t t-set="fb_hidden">
                                <input type="hidden" name="page_size" t-att-value="page_size"/>
                            </t>
                            <t t-set="fb_error">
                                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                                    <t t-set="part" t-value="'merr'"/>
                                </t>
                            </t>
                            <t t-set="fb_chips">
                                <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                                    <t t-set="part" t-value="'mchips'"/>
                                </t>
                            </t>
                        </t>

                        <t t-call="wujia_portal_purchase_history.portal_history_results_part">
                            <t t-set="part" t-value="'mbody'"/>
                        </t>
                    </t>
                </div>
                <!-- /mobile -->

            </div>
        </t>
    </template>

    <!-- ============== Detail page ============== -->
    <template id="portal_history_detail" name="Wujia Portal — Purchase History Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="_ph_t_detail">Order details</t>
            <t t-set="_ph_t_not_delivered">Not delivered yet</t>
            <t t-set="_ph_t_no_delivery_info">No delivery information yet</t>
            <!-- WJ-PH-009: MỘT chuỗi rỗng cho mọi ghi chú (đặt hàng / giao hàng) ở cả PC và mobile. -->
            <t t-set="_ph_t_no_note">No notes</t>
            <t t-set="title" t-value="detail and detail['header']['name'] or _ph_t_detail"/>
            <div class="content-wrapper">

                <!-- Không tìm thấy / không có quyền — cùng 1 message (không lộ tồn tại) -->
                <t t-if="error">
                    <div class="d-none d-lg-block">
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'pc'"/>
                            <t t-set="ph_variant" t-value="'back'"/>
                            <t t-set="ph_crumb">Order history / Order details</t>
                            <t t-set="ph_title">Order details</t>
                            <t t-set="ph_back_url" t-value="'/portal/purchase-history'"/>
                        </t>
                        <div class="wj-pc-empty">
                            <span class="wj-pc-empty__icon"><i class="feather icon-alert-circle"/></span>
                            <h3 class="wj-pc-empty__title">Cannot view the order</h3>
                            <p class="wj-pc-empty__sub" t-out="error"/>
                        </div>
                    </div>
                    <div class="d-lg-none wujia-mhist-detail">
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'m'"/>
                            <t t-set="ph_variant" t-value="'back'"/>
                            <t t-set="ph_title">Order details</t>
                            <t t-set="ph_back_url" t-value="'/portal/purchase-history'"/>
                        </t>
                        <div class="wj-empty-state wj-empty-state--card">
                            <i class="feather icon-alert-circle"/>
                            <p t-out="error"/>
                        </div>
                    </div>
                </t>

                <t t-else="">
                    <t t-set="h" t-value="detail['header']"/>
                    <t t-set="b" t-value="detail['batch']"/>

                    <!-- ====================================================
                         DESKTOP (≥992px) — wj-pc-* theo Figma 4643:2
                         ==================================================== -->
                    <div class="d-none d-lg-block">
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'pc'"/>
                            <t t-set="ph_variant" t-value="'back'"/>
                            <t t-set="ph_crumb">Order history / Order details</t>
                            <t t-set="ph_title">Order details</t>
                            <t t-set="ph_back_url" t-value="'/portal/purchase-history'"/>
                        </t>

                        <!-- Card tóm tắt đơn -->
                        <div class="wj-pc-order-head">
                            <div>
                                <!-- Eyebrow "Mã đơn" + khối Tổng tiền bên phải ở lại là NỘI DUNG
                                     card (spec cho tối đa MỘT trailing) ⇒ trailing = badge. -->
                                <p class="wj-pc-order-head__label">Order code</p>
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title" t-value="h['name']"/>
                                    <t t-set="ch_level" t-value="2"/>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                    <t t-set="ch_variant" t-value="'regular'"/>
                                    <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    <t t-set="ch_meta">
                                        <span t-attf-class="wj-status-badge #{h['badge']}" t-out="h['state_label']"/>
                                    </t>
                                </t>
                                <!-- Dòng meta CỐ Ý ở lại là nội dung card, KHÔNG làm ch_subtitle:
                                     nó dài hơn mã đơn nên khi nằm trong lead thì badge (trailing)
                                     bị đẩy theo mép của nó, trôi khỏi mã đơn — ảnh chụp bắt được,
                                     mọi số đo vẫn Pass. -->
                                <p class="wj-pc-order-head__meta">
                                    Ordered on <t t-out="h['create_date'] and h['create_date'].strftime('%d/%m/%Y %H:%M') or '—'"/>
                                    · Ordered by <t t-out="h['requester_display']"/>
                                </p>
                            </div>
                            <div class="wj-pc-order-head__right">
                                <p class="wj-pc-order-head__label">Total amount</p>
                                <p class="wj-pc-order-head__amount" t-out="money(h['amount_total'], h['currency_symbol'], h['currency_decimals'])"/>
                                <p class="wj-pc-order-head__note">Includes taxes of all order lines</p>
                            </div>
                        </div>

                        <!-- 2 panel thông tin -->
                        <div class="wj-pc-two-col">
                            <t t-call="wujia_portal_layout.wj_surface_card">
                                <t t-set="sc_class" t-value="'wj-pc-card'"/>
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Order information</t>
                                    <t t-set="ch_level" t-value="3"/>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                </t>
                                <div class="wj-pc-kv-grid">
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Ordered on</span>
                                        <span class="wj-pc-kv__value" t-out="h['create_date'] and h['create_date'].strftime('%d/%m/%Y %H:%M') or '—'"/>
                                    </div>
                                    <!-- WJ-ORD-029: chỉ đơn đã xác nhận mới có dòng này (chủ dự án chốt 30/09: ẩn hẳn, không "—"). -->
                                    <div class="wj-pc-kv" t-if="h['confirm_date']">
                                        <span class="wj-pc-kv__label">Confirmation date</span>
                                        <span class="wj-pc-kv__value" t-out="h['confirm_date'].strftime('%d/%m/%Y %H:%M')"/>
                                    </div>
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Ordered by</span>
                                        <span class="wj-pc-kv__value" t-out="h['requester_display']"/>
                                    </div>
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Status</span>
                                        <span class="wj-pc-kv__value wj-pc-kv__value--primary" t-out="h['state_label']"/>
                                    </div>
                                </div>
                            </t>
                            <t t-call="wujia_portal_layout.wj_surface_card">
                                <t t-set="sc_class" t-value="'wj-pc-card'"/>
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Batch / delivery</t>
                                    <t t-set="ch_level" t-value="3"/>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                </t>
                                <div class="wj-pc-kv-grid">
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Delivery batch</span>
                                        <span class="wj-pc-kv__value" t-out="b and b['name'] or _ph_t_not_delivered"/>
                                    </div>
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Shipping status</span>
                                        <span class="wj-pc-kv__value" t-out="b and b['status_label'] or _ph_t_no_delivery_info"/>
                                    </div>
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Delivery note</span>
                                        <span class="wj-pc-kv__value" t-out="(b and b['delivery_note']) or _ph_t_no_note"/>
                                    </div>
                                    <div class="wj-pc-kv">
                                        <span class="wj-pc-kv__label">Delivery date</span>
                                        <span class="wj-pc-kv__value" t-out="b and b['departure'] and b['departure'].strftime('%d/%m/%Y · %H:%M') or '—'"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- WJ-PH-009: Ghi chú khi đặt hàng (portal_note) — cùng khối, cùng thứ tự với mobile;
                             KHÁC "Ghi chú giao hàng" của chuyến ở panel trên. -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_class" t-value="'wj-pc-card wj-ph-order-note'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Ordering note</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                            </t>
                            <p t-attf-class="wj-ph-note #{'' if detail['note'] else 'wj-ph-note--empty'}" t-out="detail['note'] or _ph_t_no_note"/>
                        </t>

                        <!-- Bảng sản phẩm đã đặt — giá đã gồm thuế -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_class" t-value="'wj-pc-card'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Ordered products</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_meta">
                                    <span class="wj-pc-card__count"><t t-out="h['product_line_count']"/> <t t-if="h['product_line_count'] == 1">product</t><t t-else="">products</t></span>
                                </t>
                            </t>
                            <table class="wj-pc-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Unit of measure</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Unit price</th>
                                        <th class="text-end">Line total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="detail['lines']" t-as="line">
                                        <td t-out="line['product_name']"/>
                                        <td class="wj-pc-td--muted" t-out="line['uom_name'] or '—'"/>
                                        <td class="text-end wj-pc-td--amount" t-out="'{:,.0f}'.format(line['quantity'] or 0)"/>
                                        <td class="text-end" t-out="money(line['unit_price_tax_included'], h['currency_symbol'], h['currency_decimals'])"/>
                                        <td class="text-end wj-pc-td--amount" t-out="money(line['line_total_tax_included'], h['currency_symbol'], h['currency_decimals'])"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-end">Order total</td>
                                        <td class="text-end" t-out="money(h['amount_total'], h['currency_symbol'], h['currency_decimals'])"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </div>
                    <!-- /desktop -->

                    <!-- ====================================================
                         MOBILE (<992px) — Figma 4445:4 "Chi tiết đơn"
                         ==================================================== -->
                    <div class="d-lg-none wujia-mhist-detail">
                        <t t-call="wujia_portal_layout.wj_page_header">
                            <t t-set="ph_platform" t-value="'m'"/>
                            <t t-set="ph_variant" t-value="'back'"/>
                            <t t-set="ph_title">Order details</t>
                            <t t-set="ph_back_url" t-value="'/portal/purchase-history'"/>
                        </t>

                        <!-- Card tóm tắt -->
                        <div class="wujia-mhist-summary">
                            <div class="wujia-mhist-summary-top">
                                <span class="wujia-mhist-summary-code" t-out="h['name']"/>
                                <span t-attf-class="wj-status-badge #{h['badge']}" t-out="h['state_label']"/>
                            </div>
                            <div class="wujia-mhist-summary-bottom">
                                <span class="wujia-mhist-summary-date"
                                      t-out="h['create_date'] and h['create_date'].strftime('%H:%M · %d/%m/%Y') or ''"/>
                                <span class="wujia-mhist-summary-amount"
                                      t-out="money(h['amount_total'], h['currency_symbol'], h['currency_decimals'])"/>
                            </div>
                        </div>

                        <!-- Thông tin đơn hàng -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'record'"/>
                            <t t-set="sc_class" t-value="'wujia-mhist-card'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Order information</t>
                                <t t-set="ch_platform" t-value="'m'"/>
                            </t>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Ordered by</span>
                                <span class="wujia-mhist-kv-value" t-out="h['requester_display']"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Store</span>
                                <span class="wujia-mhist-kv-value"
                                      t-out="(h['franchise_code'] + ' - ' if h['franchise_code'] else '') + (h['franchise_name'] or '—')"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Total amount</span>
                                <span class="wujia-mhist-kv-value"
                                      t-out="money(h['amount_total'], h['currency_symbol'], h['currency_decimals'])"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Line count</span>
                                <span class="wujia-mhist-kv-value"><t t-out="'%02d' % h['product_line_count']"/> <t t-if="h['product_line_count'] == 1">product</t><t t-else="">products</t></span>
                            </div>
                        </t>

                        <!-- Thông tin batch / giao hàng -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'record'"/>
                            <t t-set="sc_class" t-value="'wujia-mhist-card'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Batch / delivery information</t>
                                <t t-set="ch_platform" t-value="'m'"/>
                            </t>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Batch number</span>
                                <span class="wujia-mhist-kv-value" t-out="b and b['name'] or '—'"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Shipping status</span>
                                <span class="wujia-mhist-kv-value" t-out="b and b['status_label'] or _ph_t_no_delivery_info"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Delivery note</span>
                                <span class="wujia-mhist-kv-value" t-out="(b and b['delivery_note']) or _ph_t_no_note"/>
                            </div>
                            <div class="wujia-mhist-kv">
                                <span class="wujia-mhist-kv-label">Departure time</span>
                                <span class="wujia-mhist-kv-value"
                                      t-out="b and b['departure'] and b['departure'].strftime('%d/%m/%Y · %H:%M') or '—'"/>
                            </div>
                        </t>

                        <!-- Ghi chú khi đặt hàng — dùng portal_note (order.note = T&C Odoo, sai ngữ nghĩa) -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'record'"/>
                            <t t-set="sc_class" t-value="'wujia-mhist-card wj-ph-order-note'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Ordering note</t>
                                <t t-set="ch_platform" t-value="'m'"/>
                            </t>
                            <p t-attf-class="wujia-mhist-note wj-ph-note #{'' if detail['note'] else 'wj-ph-note--empty'}" t-out="detail['note'] or _ph_t_no_note"/>
                        </t>

                        <!-- Danh sách sản phẩm — thành tiền đã gồm thuế -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'record'"/>
                            <t t-set="sc_class" t-value="'wujia-mhist-card'"/>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Product list</t>
                                <t t-set="ch_platform" t-value="'m'"/>
                            </t>
                            <div t-foreach="detail['lines']" t-as="line" class="wujia-mhist-prod">
                                <span class="wujia-mhist-prod-main">
                                    <span class="wujia-mhist-prod-name" t-out="line['product_name']"/>
                                    <span class="wujia-mhist-prod-spec">Packaging: <t t-out="line['spec'] or '—'"/> · Qty: x<t t-out="'{:,.0f}'.format(line['quantity'] or 0)"/></span>
                                </span>
                                <span class="wujia-mhist-prod-amount"
                                      t-out="money(line['line_total_tax_included'], h['currency_symbol'], h['currency_decimals'])"/>
                            </div>
                        </t>
                    </div>
                    <!-- /mobile -->
                </t>

            </div>
        </t>
    </template>

</odoo>
