<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Báo cáo đặt hàng (BA Tasks STT12) — 2 mockup SVG đã chốt:
         · PC 1440x1120  Bao-cao-dat-hang-Portal-PC-1440x1120.svg
         · Mobile 390x1385 (link BA cấp ngoài sheet)
         PC bám hệ wj-pc-*; mobile bám BlankShell .wujia-mpage.
         Vùng swap wj_ajax_list tách riêng 2 id để mỗi bố cục giữ đúng
         wrapper padding của mình (lọc vẫn không reload trang).
         ================================================================ -->

    <template id="portal_report_orders" name="Wujia Portal — Order report">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Order report</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/reports/orders'"/>
                <t t-set="wjl_slots"
                   t-value="'wj-rep-pcerr,wj-rep-pc-body,wj-rep-merr,wj-rep-m-body'"/>
            </t>

            <!-- Nhãn trạng thái nào có mặt trong kỳ (dùng chung cho donut PC và
                 thanh xếp chồng mobile). Tổng đơn = mọi trạng thái, kể cả huỷ. -->
            <t t-set="state_total" t-value="sum([s['count'] for s in state_summary])"/>
            <t t-set="_rep_t_unknown">Unknown</t>
            <t t-set="_rep_t_revenue">Revenue</t>
            <t t-set="_rep_t_total">Total</t>
            <t t-set="_rep_t_order">%s order</t>
            <t t-set="_rep_t_orders">%s orders</t>
            <t t-set="_rep_t_million">%sM</t>
            <t t-set="_rep_t_thousand">%sK</t>
            <t t-set="_rep_t_no_data">No data in the selected range.</t>
            <t t-set="_rep_msgs" t-value="{
                'data-wj-msg-revenue': _rep_t_revenue, 'data-wj-msg-total': _rep_t_total,
                'data-wj-msg-order': _rep_t_order, 'data-wj-msg-orders': _rep_t_orders,
                'data-wj-msg-million': _rep_t_million, 'data-wj-msg-thousand': _rep_t_thousand,
                'data-wj-msg-no-data': _rep_t_no_data}"/>

            <!-- ============================================================
                 MOBILE (dưới 992px)
                 ============================================================ -->
            <div class="d-lg-none wujia-mpage wujia-mreport" t-att="_rep_msgs">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Order report</t>
                </t>

                <t t-if="store_scope == 'need_pick'" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>
                <t t-else="">
                <t t-call="wujia_portal_layout.wj_filter_bar">
                    <t t-set="fb_platform" t-value="'m'"/>
                    <t t-set="fb_action" t-value="'/portal/reports/orders'"/>
                    <t t-set="fb_dates"
                       t-value="{'from': date_from, 'to': date_to}"/>
                    <t t-set="fb_error">
                        <p id="wj-rep-merr" class="wj-filter-error" role="alert"
                           t-att-hidden="None if filter_error else 'hidden'"
                           t-out="filter_error"/>
                    </t>
                </t>

                <div id="wj-rep-m-body" class="wj-rep-mbody">
                    <!-- KPI lưới 2 cột, thanh màu ở đỉnh thay cho icon -->
                    <div class="wj-rep-mkpi-grid">
                        <div class="wj-rep-mkpi wj-rep-mkpi--primary">
                            <span class="wj-rep-mkpi__bar"/>
                            <span class="wj-rep-mkpi__label">Total orders</span>
                            <span class="wj-rep-mkpi__value"
                                  t-out="'{:,}'.format(total_orders).replace(',', '.')"/>
                            <span class="wj-rep-mkpi__desc">Placed + confirmed</span>
                        </div>
                        <div class="wj-rep-mkpi wj-rep-mkpi--success">
                            <span class="wj-rep-mkpi__bar"/>
                            <span class="wj-rep-mkpi__label">Total cost</span>
                            <span class="wj-rep-mkpi__value" t-out="money(total_revenue)"/>
                            <span class="wj-rep-mkpi__desc">Selected range</span>
                        </div>
                        <div class="wj-rep-mkpi wj-rep-mkpi--done">
                            <span class="wj-rep-mkpi__bar"/>
                            <span class="wj-rep-mkpi__label">Completed orders</span>
                            <span class="wj-rep-mkpi__value"
                                  t-out="'{:,}'.format(done_orders).replace(',', '.')"/>
                            <span class="wj-rep-mkpi__desc">Delivered orders</span>
                        </div>
                        <div class="wj-rep-mkpi wj-rep-mkpi--danger">
                            <span class="wj-rep-mkpi__bar"/>
                            <span class="wj-rep-mkpi__label">Orders cancelled</span>
                            <span class="wj-rep-mkpi__value"
                                  t-out="'{:,}'.format(cancel_orders).replace(',', '.')"/>
                            <span class="wj-rep-mkpi__desc">Orders cancelled before fulfilment</span>
                        </div>
                    </div>

                    <!-- Biểu đồ tháng: cột = doanh thu, số trong cột = số đơn -->
                    <section class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush wj-rep-mcard wj-rep-mcard--chart">
                        <div class="wj-rep-mcard__head">
                            <h2 class="wj-rep-mcard__title">Orders by month</h2>
                            <span class="wj-rep-mcard__meta">Revenue (<t t-out="currency_symbol"/>)</span>
                        </div>
                        <div class="wj-rep-mcard__body">
                            <div id="report-chart-months-m" class="wj-rep-mchart"
                                 t-att-data-chart-payload="chart_payload_json"/>
                            <p class="wj-rep-mchart__note">Number in bar = order count</p>
                        </div>
                    </section>

                    <!-- Phân bổ trạng thái: thanh xếp chồng + chú giải 2 cột -->
                    <section class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush wj-rep-mcard">
                        <div class="wj-rep-mcard__head">
                            <h2 class="wj-rep-mcard__title">Status breakdown</h2>
                            <span class="wj-rep-mcard__meta">
                                <t t-out="'{:,}'.format(state_total).replace(',', '.')"/> <t t-if="state_total == 1">order in total</t><t t-else="">orders in total</t>
                            </span>
                        </div>
                        <div class="wj-rep-mcard__body">
                            <div t-if="not state_total" class="wj-rep-mempty">
                                No orders in the selected range.
                            </div>
                            <t t-else="">
                                <div class="wj-rep-mstack" role="img"
                                     aria-label="Order share by status">
                                    <t t-foreach="state_summary" t-as="s">
                                        <span t-if="s['count']" class="wj-rep-mstack__seg"
                                              t-attf-style="width: #{s['ratio']}%; background: #{s['color']}"
                                              t-att-title="s['label']"/>
                                    </t>
                                </div>
                                <ul class="wj-rep-mlegend">
                                    <li t-foreach="state_summary" t-as="s" class="wj-rep-mlegend__item">
                                        <span class="wj-rep-mlegend__dot"
                                              t-attf-style="background: #{s['color']}"/>
                                        <span class="wj-rep-mlegend__label" t-out="s['label']"/>
                                        <span class="wj-rep-mlegend__value"
                                              t-out="'{:,}'.format(s['count']).replace(',', '.')"/>
                                    </li>
                                </ul>
                            </t>
                        </div>
                    </section>

                    <!-- Sản phẩm đặt nhiều nhất: list-card (PC dùng bảng) -->
                    <section class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush wj-rep-mcard">
                        <div class="wj-rep-mcard__head">
                            <h2 class="wj-rep-mcard__title">Most ordered products</h2>
                            <span t-if="top_products" class="wj-rep-mcard__meta">
                                <t t-set="_n" t-value="len(top_products)"/><t t-out="_n"/> <t t-if="_n == 1">product</t><t t-else="">products</t>
                            </span>
                        </div>
                        <div class="wj-rep-mcard__body">
                            <div t-if="not top_products" class="wj-rep-mempty">
                                No products in the selected period.
                            </div>
                            <ul t-else="" class="wj-rep-mtop">
                                <li t-foreach="top_products" t-as="p" class="wj-rep-mtop__row">
                                    <span class="wj-rep-mtop__rank" t-out="p_index + 1"/>
                                    <span class="wj-rep-mtop__main">
                                        <span class="wj-rep-mtop__name"
                                              t-out="p['name'] or _rep_t_unknown"/>
                                        <span class="wj-rep-mtop__sub">
                                            <t t-out="'{:,.0f}'.format(p['qty']).replace(',', '.')"/>
                                            <t t-out="p['uom']"/>
                                        </span>
                                    </span>
                                    <span class="wj-rep-mtop__amount" t-out="money(p['total'])"/>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
                </t>
            </div>

            <!-- ============================================================
                 DESKTOP (từ 992px)
                 ============================================================ -->
            <div class="content-wrapper d-none d-lg-block wj-rep-pc" t-att="_rep_msgs">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Order report</t>
                </t>
                <p class="wj-rep-pc__subtitle">
                    Track your store's orders, revenue and products.
                </p>

                <t t-if="store_scope == 'need_pick'" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>
                <t t-else="">
                <t t-call="wujia_portal_layout.wj_filter_bar">
                    <t t-set="fb_platform" t-value="'pc'"/>
                    <t t-set="fb_action" t-value="'/portal/reports/orders'"/>
                    <!-- Nhịp dọc riêng của trang báo cáo (14 thay vì 24). -->
                    <t t-set="fb_class" t-value="'wj-rep-pcfilter'"/>
                    <t t-set="fb_dates"
                       t-value="{'from': date_from, 'to': date_to}"/>
                    <t t-set="fb_reset_url" t-value="'/portal/reports/orders'"/>
                    <t t-set="fb_error">
                        <p id="wj-rep-pcerr" class="wj-filter-error" role="alert"
                           t-att-hidden="None if filter_error else 'hidden'"
                           t-out="filter_error"/>
                    </t>
                </t>

                <div id="wj-rep-pc-body">
                    <div class="wj-pc-metric-grid wj-rep-pcmetrics">
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-rep-pcicon wj-rep-pcicon--primary">
                                <i class="feather icon-file-text"/>
                            </span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Total orders</span>
                                <span class="wj-pc-metric-card__value"
                                      t-out="'{:,}'.format(total_orders).replace(',', '.')"/>
                                <span class="wj-rep-pcmetric__desc">Placed + confirmed</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-rep-pcicon wj-rep-pcicon--success">
                                <i class="feather icon-credit-card"/>
                            </span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Total cost</span>
                                <span class="wj-pc-metric-card__value" t-out="money(total_revenue)"/>
                                <span class="wj-rep-pcmetric__desc">In the selected range</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-rep-pcicon wj-rep-pcicon--done">
                                <i class="feather icon-check-circle"/>
                            </span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Completed orders</span>
                                <span class="wj-pc-metric-card__value"
                                      t-out="'{:,}'.format(done_orders).replace(',', '.')"/>
                                <span class="wj-rep-pcmetric__desc">Delivered orders</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-rep-pcicon wj-rep-pcicon--danger">
                                <i class="feather icon-x-circle"/>
                            </span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Orders cancelled</span>
                                <span class="wj-pc-metric-card__value"
                                      t-out="'{:,}'.format(cancel_orders).replace(',', '.')"/>
                                <span class="wj-rep-pcmetric__desc">Orders cancelled before fulfilment</span>
                            </span>
                        </t>
                    </div>

                    <div class="wj-rep-pcrow">
                        <section class="wj-surface-card wj-surface-card--flush wj-pc-card wj-rep-pccard wj-rep-pccard--chart">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Orders by month</t>
                                <t t-set="ch_level" t-value="2"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-rep-pccard__head wj-card-header--flush'"/>
                                <t t-set="ch_meta">
                                    <span class="wj-rep-pclegend">
                                        <span class="wj-rep-pclegend__dot"/>
                                        <span class="wj-rep-pclegend__name">Revenue</span>
                                        <span class="wj-rep-pclegend__hint">Number in bar: order count</span>
                                    </span>
                                </t>
                            </t>
                            <div class="wj-rep-pccard__body">
                                <div id="report-chart-months" class="wj-rep-pcchart"
                                     t-att-data-chart-payload="chart_payload_json"/>
                            </div>
                        </section>

                        <section class="wj-surface-card wj-surface-card--flush wj-pc-card wj-rep-pccard wj-rep-pccard--state">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Status breakdown</t>
                                <t t-set="ch_level" t-value="2"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-rep-pccard__head wj-card-header--flush'"/>
                                <t t-set="ch_meta">
                                    <span class="wj-rep-pccard__meta">
                                        <t t-out="'{:,}'.format(state_total).replace(',', '.')"/> <t t-if="state_total == 1">order in total</t><t t-else="">orders in total</t>
                                    </span>
                                </t>
                            </t>
                            <div class="wj-rep-pccard__body wj-rep-pcstate">
                                <div id="report-chart-state" class="wj-rep-pcdonut"/>
                                <ul class="wj-rep-pclegend-list">
                                    <li t-foreach="state_summary" t-as="s" class="wj-rep-pclegend-list__item">
                                        <span class="wj-rep-pclegend-list__dot"
                                              t-attf-style="background: #{s['color']}"/>
                                        <span class="wj-rep-pclegend-list__label" t-out="s['label']"/>
                                        <span class="wj-rep-pclegend-list__value">
                                            <t t-out="'{:,}'.format(s['count']).replace(',', '.')"/>
                                            ·
                                            <t t-out="'{:.1f}'.format(s['ratio']).replace('.', ',')"/>%
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </section>
                    </div>

                    <section class="wj-surface-card wj-surface-card--flush wj-pc-card wj-rep-pccard wj-rep-pccard--top">
                        <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Top ordered products</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'pc'"/>
                            <t t-set="ch_class" t-value="'wj-rep-pccard__head wj-card-header--flush'"/>
                            <t t-set="ch_meta">
                                <span class="wj-rep-pccard__meta">
                                    <t t-set="_n" t-value="len(top_products)"/><t t-out="_n"/> <t t-if="_n == 1">product</t><t t-else="">products</t>
                                </span>
                            </t>
                        </t>
                        <div class="wj-rep-pccard__body">
                            <div t-if="not top_products" class="wj-pc-empty">
                                <span class="wj-pc-empty__icon"><i class="feather icon-bar-chart-2"/></span>
                                <h3 class="wj-pc-empty__title">No data yet</h3>
                                <p class="wj-pc-empty__sub">No products in the selected period.</p>
                            </div>
                            <table t-else="" class="wj-pc-table wj-rep-pctable">
                                <thead>
                                    <tr>
                                        <th class="wj-rep-pctable__stt">No.</th>
                                        <th>Product</th>
                                        <th class="wj-rep-pctable__num">Quantity</th>
                                        <th>Unit</th>
                                        <th class="wj-rep-pctable__num">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="top_products" t-as="p">
                                        <td class="wj-rep-pctable__stt" t-out="p_index + 1"/>
                                        <!-- Dòng đơn không gắn sản phẩm (section/note) cho name=False,
                                             QWeb t-out gặp False thì BỎ LUÔN thẻ td → lệch cả hàng. -->
                                        <td t-out="p['name'] or _rep_t_unknown"/>
                                        <td class="wj-rep-pctable__num"
                                            t-out="'{:,.0f}'.format(p['qty']).replace(',', '.')"/>
                                        <td t-out="p['uom']"/>
                                        <td class="wj-rep-pctable__num wj-pc-td--amount"
                                            t-out="money(p['total'])"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
