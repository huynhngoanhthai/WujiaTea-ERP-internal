<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Thông báo nghiệp vụ khi lọc/bài không còn khả dụng (WJ-KNW-001/004).
         Đặt NGOÀI slot của wj_ajax_list để lọc-không-reload không nuốt mất. -->
    <template id="portal_knowledge_notice" name="Wujia Portal — Knowledge Notice">
        <div t-if="notice" class="wj-know-notice" role="status">
            <i class="feather icon-info"/>
            <span t-if="notice == 'category_gone'">The selected category is no longer available.</span>
            <span t-if="notice == 'tag_gone'">The selected tag is no longer available.</span>
            <span t-if="notice == 'article_gone'">The article does not exist or is no longer available.</span>
        </div>
    </template>

    <!-- ============== List ============== -->
    <template id="portal_knowledge_list" name="Wujia Portal — Knowledge List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Knowledge library</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/knowledge'"/>
                <t t-set="wjl_slots"
                   t-value="'wj-know-pc-cats,wj-know-pc-body,wj-know-mcount,wj-know-mchips,wj-know-mbody'"/>
            </t>
            <!-- ===== Desktop (≥992px) — GIỮ NGUYÊN (Sprint 9.13b) ===== -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Knowledge</t>
                </t>
                <div class="content-body">
                    <t t-call="wujia_portal_knowledge.portal_knowledge_notice"/>
                    <t t-set="_kn_t_search_ph">Search articles...</t>
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'pc'"/>
                        <t t-set="fb_action" t-value="'/portal/knowledge'"/>
                        <t t-set="fb_search"
                           t-value="{'name': 'keyword', 'value': keyword,
                                     'placeholder': _kn_t_search_ph}"/>
                    </t>

                    <div class="row">
                        <!-- Category nav -->
                        <div class="col-md-3 col-12 mb-2" id="wj-know-pc-cats">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush">
                                <div class="wj-surface-card__head py-2">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Category</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="list-group list-group-flush knowledge-cat-list">
                                    <a href="/portal/knowledge"
                                       t-attf-class="list-group-item list-group-item-action#{' active' if not category_id else ''}">
                                        <i class="fa fa-list me-1"/>All
                                    </a>
                                    <t t-foreach="categories" t-as="cat">
                                        <a t-attf-href="/portal/knowledge?category_id=#{cat.id}"
                                           t-attf-class="list-group-item list-group-item-action#{' active' if category_id == cat.id else ''}">
                                            <span t-out="cat.name"/>
                                            <span class="badge bg-light text-dark float-end" t-out="cat.article_count"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Articles list — MẪU 04 Card danh sách + icon (Sprint 9.13b 2026-05-27) -->
                        <div class="col-md-9 col-12" id="wj-know-pc-body">
                            <t t-call="wujia_portal_layout.wj_surface_card">
                                <t t-set="sc_density" t-value="'regular'"/>
                                <t t-set="sc_class" t-value="'wujia-content-card'"/>
                            <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
                            <t t-set="_kn_t_recent">Recently updated documents</t>
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title"
                                   t-value="current_category.name if current_category else _kn_t_recent"/>
                                <t t-set="ch_level" t-value="4"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_icon" t-value="'book'"/>
                                <t t-set="ch_meta">
                                    <t t-set="_n" t-value="len(articles)"/>
                                    <span class="wj-card-header__meta"><t t-out="_n"/> <t t-if="_n == 1">article</t><t t-else="">articles</t></span>
                                </t>
                            </t>
                            <t t-call="wujia_portal_layout.wj_data_list">
                                <t t-set="dl_variant" t-value="'compact-row'"/>
                                <t t-set="dl_class" t-value="'wj-data-list--inset'"/>
                                <t t-set="dl_empty" t-value="not articles"/>
                                <t t-set="dl_state">
                                    <div class="wujia-empty-state">
                                        <i class="feather icon-book"/>
                                        <p>No articles yet.</p>
                                    </div>
                                </t>
                                <t t-set="dl_pager">
                                    <t t-call="wujia_portal_layout.wj_pagination"/>
                                </t>
                                <t t-set="_kn_t_mandatory">Mandatory</t>
                                <t t-set="_kn_t_important">Important</t>
                                <t t-set="_kn_t_new">New</t>
                                <ul class="wujia-content-card-body">
                                    <t t-foreach="articles" t-as="art">
                                        <t t-set="badge_cls" t-value="{'mandatory': 'wujia-badge-danger', 'important': 'wujia-badge-warning', 'new': 'wujia-badge-info'}.get(art.portal_badge, '')"/>
                                        <t t-set="badge_lbl" t-value="{'mandatory': _kn_t_mandatory, 'important': _kn_t_important, 'new': _kn_t_new}.get(art.portal_badge, '')"/>
                                        <li class="wj-data-item wj-lc">
                                            <t t-call="wujia_portal_layout.wj_list_card">
                                                <t t-set="lc_prefix">
                                                    <span class="wujia-know-bullet"/>
                                                </t>
                                                <t t-set="lc_name">
                                                    <a t-attf-href="/portal/knowledge/#{art.slug}">
                                                        <t t-out="art.name"/>
                                                    </a>
                                                </t>
                                                <t t-set="lc_state">
                                                    <span t-if="art.category_id" class="wujia-badge wujia-badge-muted" t-out="art.category_id.name"/>
                                                    <span t-if="badge_lbl" t-attf-class="wujia-badge #{badge_cls}" t-out="badge_lbl"/>
                                                    <span class="wj-lc__meta">
                                                        <t t-out="wj_dt(art.publish_date, '%d/%m/%Y')"/>
                                                        · <i class="fa fa-eye"/> <t t-out="art.view_count or 0"/>
                                                    </span>
                                                </t>
                                            </t>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                            </t>

                        </div>
                    </div>
                </div>
            </div>
            <!-- /desktop -->

            <!-- ===== Mobile (<992px) — Sprint 15, Figma WJ_Knowledge_Mobile 4475:2 =====
                 Trang ĐẦU TIÊN dùng BlankShell .wujia-mpage (Sprint 14, BA 4447:11).
                 Đặt NGOÀI .content-wrapper: .wujia-mpage tự lo gutter (pad-x 16) —
                 lồng vào content-wrapper sẽ double padding ngang.
                 UI-only (chốt user 2026-06-12, wire backend sau):
                 - "N bài viết" = len(articles) trang hiện tại (TODO: search_count từ controller).
                 - "Bài nổi bật" = lọc portal_badge important/mandatory từ recordset đã fetch
                   (TODO: query controller riêng, không phụ thuộc trang/pagination).
                 - Icon bài viết: 1 icon chung icon-file-text (Figma vẽ icon riêng từng bài
                   — drift, chờ BA cấp field icon rồi đối chiếu). -->
            <div class="d-lg-none wujia-mpage wujia-mknow">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'title'"/>
                    <t t-set="ph_title">Knowledge</t>
                </t>
                <t t-call="wujia_portal_knowledge.portal_knowledge_notice"/>
                <t t-set="_n" t-value="len(articles)"/>
                <p class="wj-count-meta wj-count-meta--primary" id="wj-know-mcount"><t t-out="_n"/> <t t-if="_n == 1">article</t><t t-else="">articles</t></p>

                <!-- Filter canonical 01-ChipSlide (Figma 4785:562) — keyword + category chips -->
                <t t-set="_kn_t_msearch_ph">Search for articles...</t>
                <t t-call="wujia_portal_layout.wj_filter_bar">
                    <t t-set="fb_platform" t-value="'m'"/>
                    <t t-set="fb_action" t-value="'/portal/knowledge'"/>
                    <t t-set="fb_search"
                       t-value="{'name': 'keyword', 'value': keyword, 'placeholder': _kn_t_msearch_ph}"/>
                    <t t-set="fb_chips">
                        <div class="wj-filter-chips" id="wj-know-mchips">
                            <a href="/portal/knowledge"
                               t-attf-class="wj-filter-chip#{'' if category_id else ' is-active'}">All</a>
                            <t t-foreach="categories" t-as="cat">
                                <a t-attf-href="/portal/knowledge?category_id=#{cat.id}"
                                   t-attf-class="wj-filter-chip#{' is-active' if category_id == cat.id else ''}"
                                   t-out="cat.name"/>
                            </t>
                        </div>
                    </t>
                </t>

                <div id="wj-know-mbody" class="wj-ajax-slot">
                <div t-if="not articles" class="wj-empty-state wj-empty-state--rich">
                    <span class="wj-empty-state-icon"/>
                    <p class="wj-empty-state-title">No articles yet</p>
                    <p class="wj-empty-state-sub">There are no articles to show yet.</p>
                    <p class="wj-empty-state-sub">New content will appear here once it is published.</p>
                    <a t-if="keyword or category_id" href="/portal/knowledge" class="wj-btn wj-btn--secondary">Clear filters</a>
                    <button t-else="" type="button" class="wj-btn wj-btn--primary" onclick="window.location.reload()">Reload</button>
                </div>
                <t t-else="">
                    <t t-set="m_featured" t-value="articles.filtered(lambda a: a.portal_badge in ('important', 'mandatory'))[:1]"/>
                    <t t-set="m_rest" t-value="articles - m_featured"/>
                    <!-- Badge map MOBILE — tách desktop (precedent MOBILE_STATE_BADGES S13):
                         important → danger (Figma đỏ hồng; desktop map warning — drift có
                         chủ đích, đối chiếu BA). -->
                    <t t-set="m_badge_cls" t-value="{'mandatory': 'wujia-badge-danger', 'important': 'wujia-badge-danger', 'new': 'wujia-badge-info'}"/>
                    <t t-set="_kn_t_mandatory">Mandatory</t>
                    <t t-set="_kn_t_important">Important</t>
                    <t t-set="_kn_t_new">New</t>
                    <t t-set="m_badge_lbl" t-value="{'mandatory': _kn_t_mandatory, 'important': _kn_t_important, 'new': _kn_t_new}"/>

                    <!-- Bài nổi bật -->
                    <t t-if="m_featured">
                        <div class="wujia-mknow-sechead">
                            <span class="wujia-mknow-sechead-title">Featured articles</span>
                            <span class="wujia-mknow-sechead-sub">Read first</span>
                        </div>
                        <t t-foreach="m_featured" t-as="art">
                            <a t-attf-href="/portal/knowledge/#{art.slug}" class="wujia-mknow-feat wj-state-surface">
                                <span class="wujia-mknow-tile"><i class="feather icon-save"/></span>
                                <span class="wujia-mknow-feat-main">
                                    <span class="wujia-mknow-feat-title" t-out="art.name"/>
                                    <span class="wujia-mknow-badges">
                                        <span t-if="m_badge_lbl.get(art.portal_badge)"
                                              t-attf-class="wujia-badge #{m_badge_cls.get(art.portal_badge)}"
                                              t-out="m_badge_lbl.get(art.portal_badge)"/>
                                        <span t-if="art.category_id" class="wujia-badge wujia-badge-info"
                                              t-out="art.category_id.name"/>
                                    </span>
                                    <span class="wujia-mknow-feat-date">
                                        Updated on <t t-out="wj_dt(art.publish_date, '%d/%m/%Y')"/>
                                    </span>
                                </span>
                            </a>
                        </t>
                    </t>

                    <!-- Mới cập nhật -->
                    <div class="wujia-mknow-sechead">
                        <span class="wujia-mknow-sechead-title">Recently updated</span>
                        <span class="wujia-mknow-sechead-pill">Latest</span>
                    </div>
                    <t t-call="wujia_portal_layout.wj_data_list">
                        <t t-set="dl_variant" t-value="'detail-card'"/>
                            <t t-foreach="m_rest" t-as="art">
                                <a t-attf-href="/portal/knowledge/#{art.slug}" class="wj-data-item wj-lc">
                                    <t t-call="wujia_portal_layout.wj_list_card">
                                        <t t-set="lc_prefix">
                                            <span class="wj-lc__tile wujia-know-tile-tone"><i class="feather icon-file-text"/></span>
                                        </t>
                                        <t t-set="lc_name" t-value="art.name"/>
                                        <t t-set="lc_state">
                                            <span t-if="m_badge_lbl.get(art.portal_badge)"
                                                  t-attf-class="wujia-badge #{m_badge_cls.get(art.portal_badge)}"
                                                  t-out="m_badge_lbl.get(art.portal_badge)"/>
                                            <span t-if="art.category_id" class="wujia-badge wujia-badge-info"
                                                  t-out="art.category_id.name"/>
                                        </t>
                                        <t t-set="lc_rows">
                                            <t t-call="wujia_portal_layout.wj_list_card_row">
                                                <t t-set="lcr_value">Updated on <t t-out="wj_dt(art.publish_date, '%d/%m/%Y')"/></t>
                                            </t>
                                        </t>
                                    </t>
                                </a>
                            </t>
                    </t>

                    <t t-call="wujia_portal_layout.wj_pagination"/>
                </t>
                </div>
            </div>
            <!-- /mobile -->
        </t>
    </template>

    <!-- ============== Detail ============== -->
    <template id="portal_knowledge_detail" name="Wujia Portal — Knowledge Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="article.name"/>
            <!-- ===== Desktop (≥992px) — GIỮ NGUYÊN ===== -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Knowledge / Article details</t>
                    <t t-set="ph_title">Knowledge</t>
                    <t t-set="ph_back_url" t-value="'/portal/knowledge'"/>
                </t>

                <div class="content-body">
                    <div class="row">
                        <div class="col-lg-9 col-12">
                            <article class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush knowledge-detail">
                                <img t-if="article.cover_image"
                                     t-attf-src="/web/image/wujia.knowledge.article/#{article.id}/cover_image"
                                     class="wj-surface-card__media knowledge-detail-cover"
                                     t-att-alt="article.name"/>
                                <div class="wj-surface-card__body">
                                    <h1 class="article-title" t-out="article.name"/>
                                    <p class="text-muted small mb-3">
                                        <span t-if="article.author_id"><i class="fa fa-user me-1"/><t t-out="article.author_id.name"/></span>
                                        <span class="ms-3"><i class="fa fa-clock me-1"/><t t-out="wj_dt(article.publish_date, '%d/%m/%Y %H:%M')"/></span>
                                        <t t-set="_n" t-value="article.view_count or 0"/>
                                        <span class="ms-3"><i class="fa fa-eye me-1"/><t t-out="_n"/> <t t-if="_n == 1">view</t><t t-else="">views</t></span>
                                    </p>
                                    <div class="article-content wj-richtext" t-out="article.content"/>
                                </div>
                            </article>
                        </div>

                        <div class="col-lg-3 col-12">
                            <div t-if="related" class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush">
                                <div class="wj-surface-card__head py-2">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Related articles</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="list-group list-group-flush">
                                    <t t-foreach="related" t-as="r">
                                        <a t-attf-href="/portal/knowledge/#{r.slug}" class="list-group-item list-group-item-action py-2">
                                            <strong class="d-block small" t-out="r.name"/>
                                            <small class="text-muted" t-out="wj_dt(r.publish_date, '%d/%m/%Y')"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2">
                        <a href="/portal/knowledge" class="wj-btn wj-btn--secondary">
                            <i class="fa fa-arrow-left me-1"/>Back to library
                        </a>
                    </div>
                </div>
            </div>
            <!-- /desktop -->

            <!-- ===== Mobile (<992px) — Sprint 15, Figma WJ_Knowledge_Mobile 4475:2 =====
                 Card xám "Các điểm cần nắm" / card cam "Lưu ý" trong mockup = NỘI DUNG
                 HTML mẫu admin soạn trong field content, KHÔNG phải field riêng. CSS
                 .wujia-mknow-body hỗ trợ sẵn: ul/li bullet cyan, blockquote → card xám,
                 div.wujia-note → card cam (admin thêm class trong editor HTML).
                 Related "Bài liên quan": Figma mobile KHÔNG có → chỉ desktop. -->
            <div class="d-lg-none wujia-mpage wujia-mknow">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Knowledge</t>
                    <t t-set="ph_back_url" t-value="'/portal/knowledge'"/>
                </t>

                <article class="wj-surface-card wj-surface-card--record wj-surface-card--compact wj-surface-card--padded wujia-mknow-card wujia-mknow-article">
                    <h1 class="wujia-mknow-article-title" t-out="article.name"/>
                    <!-- Badge map mobile: important → danger (Figma đỏ; desktop warning — drift, đối chiếu BA) -->
                    <t t-set="m_badge_cls" t-value="{'mandatory': 'wujia-badge-danger', 'important': 'wujia-badge-danger', 'new': 'wujia-badge-info'}"/>
                    <t t-set="_kn_t_mandatory">Mandatory</t>
                    <t t-set="_kn_t_important">Important</t>
                    <t t-set="_kn_t_new">New</t>
                    <t t-set="m_badge_lbl" t-value="{'mandatory': _kn_t_mandatory, 'important': _kn_t_important, 'new': _kn_t_new}"/>
                    <div class="wujia-mknow-badges">
                        <span t-if="m_badge_lbl.get(article.portal_badge)"
                              t-attf-class="wujia-badge #{m_badge_cls.get(article.portal_badge)}"
                              t-out="m_badge_lbl.get(article.portal_badge)"/>
                        <span t-if="article.category_id" class="wujia-badge wujia-badge-info"
                              t-out="article.category_id.name"/>
                    </div>
                    <div class="wujia-mknow-meta">
                        <t t-if="article.author_id" t-out="article.author_id.name"/>
                        <t t-if="article.author_id and article.publish_date"> • </t>
                        <t t-if="article.publish_date">Updated on <t t-out="wj_dt(article.publish_date, '%d/%m/%Y')"/></t>
                    </div>

                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Main content</t>
                        <t t-set="ch_level" t-value="2"/>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <p t-if="article.summary" class="wujia-mknow-lead" t-out="article.summary"/>
                    <div class="wujia-mknow-body wj-richtext" t-out="article.content"/>

                    <t t-if="article.attachment_ids">
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Attached documents</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'m'"/>
                        </t>
                        <t t-foreach="article.attachment_ids" t-as="att">
                            <t t-set="att_ext" t-value="att.name and '.' in att.name and att.name.rsplit('.', 1)[1].upper() or (att.mimetype or '').rsplit('/', 1)[-1].upper()"/>
                            <t t-set="att_size" t-value="att.file_size and (att.file_size &gt;= 1048576 and '%.1f MB' % (att.file_size / 1048576.0) or '%d KB' % max(1, att.file_size // 1024)) or ''"/>
                            <!-- Download THẬT (chốt user 2026-06-12) — route stream Sprint 15 -->
                            <a t-attf-href="/portal/knowledge/#{article.slug}/attachment/#{att.id}"
                               class="wujia-mknow-att">
                                <span class="wujia-mknow-tile"><i class="feather icon-file-text"/></span>
                                <span class="wujia-mknow-att-main">
                                    <span class="wujia-mknow-att-name" t-out="att.name"/>
                                    <span class="wujia-mknow-att-sub">
                                        <t t-out="att_ext"/><t t-if="att_size"> • <t t-out="att_size"/></t>
                                    </span>
                                </span>
                            </a>
                        </t>
                    </t>
                </article>
            </div>
            <!-- /mobile -->
        </t>
    </template>

</odoo>
