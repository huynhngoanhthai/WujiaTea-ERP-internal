<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CMP-SN-001 — mục sidebar PC do CHÍNH module sở hữu route khai; khung
         (wujia_portal_layout) chỉ giữ 3 tiêu đề nhóm + neo `nav_end`. Gỡ module này ⇒ mục biến mất. -->
    <template id="layout_sidenav_knowledge"
              inherit_id="wujia_portal_layout.layout_sidenav"
              priority="62"
              name="Wujia Sidenav — Knowledge">
        <xpath expr="//li[@id='nav_end']" position="before">
            <t t-set="ni_active" t-value="_p.startswith('/portal/knowledge')"/>
            <li t-attf-class="nav-item #{ni_active and 'active' or ''}" id="nav_item_knowledge">
                <t t-call="wujia_portal_layout.wj_nav_item">
                    <t t-set="ni_href" t-value="'/portal/knowledge'"/>
                    <t t-set="ni_icon" t-value="'feather icon-book'"/>
                    <t t-set="ni_label">Knowledge</t>
                </t>
            </li>
        </xpath>
    </template>

</odoo>
