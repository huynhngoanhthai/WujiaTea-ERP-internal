<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== List ============== -->
    <template id="portal_support_list" name="Wujia Portal — Support List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Support requests</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/support'"/>
                <t t-set="wjl_slots" t-value="'wj-sup-pc,wj-sup-mchips,wj-sup-mbody'"/>
            </t>
            <!-- ===== Desktop (>=992px) — GIỮ NGUYÊN 100%, chỉ bọc d-none d-lg-block (Sprint 16) ===== -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Support</t>
                    <t t-set="ph_create_url" t-value="'/portal/support/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>
                <t t-if="no_franchise" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>
                <div t-else="" class="content-body">
                    <!-- Nhãn bộ lọc (dịch được, J-V7). -->
                    <t t-set="_sup_t_status">Status</t>
                    <t t-set="_sup_t_all_status">All statuses</t>
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'pc'"/>
                        <t t-set="fb_action" t-value="'/portal/support'"/>
                        <t t-set="fb_selects"
                           t-value="[{'name': 'state', 'value': state,
                                      'label': _sup_t_status,
                                      'all_label': _sup_t_all_status,
                                      'options': [(kv[0], kv[1][0]) for kv in state_labels.items()]}]"/>
                    </t>

                    <!-- Vùng swap AJAX: card + pager (bộ lọc nằm ngoài, JS đồng bộ theo URL). -->
                    <div id="wj-sup-pc">
                    <!-- Tickets — MẪU 06 Card ticket (Sprint 9.13b 2026-05-27) -->
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_density" t-value="'regular'"/>
                        <t t-set="sc_class" t-value="'wujia-content-card'"/>
                    <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Open support requests</t>
                        <t t-set="ch_level" t-value="4"/>
                        <t t-set="ch_platform" t-value="'pc'"/>
                        <t t-set="ch_icon" t-value="'life-buoy'"/>
                        <t t-set="ch_meta">
                            <t t-set="_n" t-value="len(tickets)"/>
                            <span class="wj-card-header__meta"><t t-out="_n"/> <t t-if="_n == 1">ticket</t><t t-else="">tickets</t></span>
                        </t>
                    </t>
                    <t t-call="wujia_portal_layout.wj_data_list">
                        <t t-set="dl_table_class" t-value="'wujia-content-card-table'"/>
                        <t t-set="dl_bleed" t-value="True"/>
                        <t t-set="dl_empty" t-value="not tickets"/>
                        <t t-set="dl_state">
                            <div class="wujia-empty-state">
                                <i class="feather icon-life-buoy"/>
                                <p>You have no tickets yet. <a href="/portal/support/new">Submit a support request</a>.</p>
                            </div>
                        </t>
                        <thead>
                            <tr>
                                <th scope="col">Request code</th>
                                <th scope="col">Title</th>
                                <th scope="col">Classification</th>
                                <th scope="col">Store</th>
                                <th scope="col">Created on</th>
                                <th scope="col" class="text-center">Priority</th>
                                <th scope="col" class="text-center">Status</th>
                                <th scope="col" class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="tickets" t-as="t">
                                <td><a t-attf-href="/portal/support/#{t.id}" t-out="t.name"/></td>
                                <td t-out="t.title"/>
                                <td t-out="t.category_id.name or '—'"/>
                                <td t-out="t.franchise_id.name or '—'"/>
                                <td t-out="t.create_date and t.create_date.strftime('%d/%m/%Y') or ''"/>
                                <td class="text-center">
                                    <t t-set="prio" t-value="priority_labels.get(t.priority, (t.priority, 'wujia-badge-muted'))"/>
                                    <span t-attf-class="wujia-badge #{prio[1]}" t-out="prio[0]"/>
                                </td>
                                <td class="text-center">
                                    <t t-set="lbl" t-value="state_labels.get(t.state, (t.state, 'wj-status-badge--neutral'))"/>
                                    <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                                </td>
                                <td class="text-end">
                                    <a t-attf-href="/portal/support/#{t.id}" class="wj-iconbtn wj-iconbtn--sm wj-iconbtn--secondary"
                                       aria-label="View ticket" title="View ticket">
                                        <i class="fa fa-eye"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                    </t>

                    <t t-call="wujia_portal_layout.wj_pagination"/>
                    </div>
                </div>
            </div>
            <!-- /desktop -->

            <!-- ===== Mobile (<992px) — Sprint 17, Figma Mobile_Ticket (List + Empty).
                 BlankShell .wujia-mpage, đặt NGOÀI .content-wrapper (pattern S15).
                 Thay khối hub dashboard SAI của Sprint 16 (đã gộp về Home /portal). -->
            <div class="d-lg-none wujia-mpage wujia-mticket">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Support</t>
                    <t t-set="ph_create_url" t-value="'/portal/support/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>

                <!-- Empty state thật sự (chưa có ticket nào, không lọc/tìm) — no-data chung Figma 4788:974 -->
                <t t-if="no_franchise" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>
                <t t-elif="not tickets and not q and not state">
                    <div class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon"/>
                        <p class="wj-empty-state-title">No support requests yet</p>
                        <p class="wj-empty-state-sub">There are no tickets to show yet.</p>
                        <p class="wj-empty-state-sub">Create your first ticket and Wujia will handle it.</p>
                        <a href="/portal/support/new" class="wj-btn wj-btn--primary">
                            <i class="feather icon-plus"/> Create ticket
                        </a>
                    </div>
                </t>
                <t t-else="">
                    <!-- Filter canonical 01-ChipSlide (Figma 4785:562) — search q + hidden state -->
                    <t t-set="_sup_t_search_ph">Search ticket code / title</t>
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'m'"/>
                        <t t-set="fb_action" t-value="'/portal/support'"/>
                        <t t-set="fb_search"
                           t-value="{'name': 'q', 'value': q or '', 'placeholder': _sup_t_search_ph}"/>
                        <t t-set="fb_hidden">
                            <input type="hidden" name="state" t-att-value="state or ''"/>
                        </t>
                        <t t-set="fb_chips">
                            <div class="wj-filter-chips" id="wj-sup-mchips">
                                <a href="/portal/support"
                                   t-attf-class="wj-filter-chip #{'is-active' if not state else ''}">All</a>
                                <a href="/portal/support?state=new"
                                   t-attf-class="wj-filter-chip #{'is-active' if state == 'new' else ''}">New</a>
                                <a href="/portal/support?state=in_progress"
                                   t-attf-class="wj-filter-chip #{'is-active' if state == 'in_progress' else ''}">Processing</a>
                                <a href="/portal/support?state=waiting_customer"
                                   t-attf-class="wj-filter-chip #{'is-active' if state == 'waiting_customer' else ''}">Replied</a>
                            </div>
                        </t>
                    </t>

                    <div id="wj-sup-mbody" class="wj-ajax-slot">
                    <!-- Không tìm thấy — no-data card (lọc rỗng → Xóa lọc) -->
                    <div t-if="not tickets" class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon"/>
                        <p class="wj-empty-state-title">No tickets found</p>
                        <p class="wj-empty-state-sub">No tickets match the current filters.</p>
                        <p class="wj-empty-state-sub">Try another keyword or clear the filters.</p>
                        <a href="/portal/support" class="wj-btn wj-btn--secondary">Clear filters</a>
                    </div>
                    <t t-call="wujia_portal_layout.wj_surface_card" t-else="">
                        <t t-set="sc_variant" t-value="'section'"/>
                        <t t-set="sc_body" t-value="'flush'"/>
                        <t t-set="sc_class" t-value="'wujia-mdash-card wujia-mdash-list wj-surface-card--listwrap'"/>
                        <t t-call="wujia_portal_layout.wj_data_list">
                            <t t-set="dl_variant" t-value="'detail-card'"/>
                            <a t-foreach="tickets" t-as="tk" t-attf-href="/portal/support/#{tk.id}"
                               class="wj-data-item wj-lc">
                                <t t-call="wujia_portal_layout.wj_list_card">
                                    <t t-set="lc_name" t-value="tk.name"/>
                                    <t t-set="lc_state">
                                        <t t-set="lbl" t-value="m_ticket_badges.get(tk.state, (tk.state, 'wj-status-badge--neutral'))"/>
                                        <span t-attf-class="wj-status-badge wj-status-badge--compact #{lbl[1]}" t-out="lbl[0]"/>
                                    </t>
                                    <t t-set="lc_rows">
                                        <t t-call="wujia_portal_layout.wj_list_card_row">
                                            <t t-set="lcr_full" t-value="True"/>
                                            <t t-set="lcr_value" t-value="tk.title"/>
                                            <t t-set="lcr_strong" t-value="True"/>
                                        </t>
                                        <t t-call="wujia_portal_layout.wj_list_card_row">
                                            <t t-set="lcr_value">
                                                <span t-if="tk.category_id" class="wujia-badge wujia-badge-muted" t-out="tk.category_id.name"/>
                                                <span t-out="tk.create_date and tk.create_date.strftime('%d/%m') or ''"/>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </a>
                        </t>
                    </t>

                    <t t-call="wujia_portal_layout.wj_pagination"/>
                    </div>
                </t>
            </div>
            <!-- /mobile -->
        </t>
    </template>

    <!-- ============== Form ============== -->
    <template id="portal_support_form" name="Wujia Portal — Support Form">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'narrow'"/>
            <t t-set="title">Create a support request</t>
            <!-- ===== Desktop (>=992px) — GIỮ NGUYÊN, bọc d-none d-lg-block (Sprint 17) ===== -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Support / Create request</t>
                    <t t-set="ph_title">Create a support request</t>
                    <t t-set="ph_back_url" t-value="'/portal/support'"/>
                </t>
                <div class="content-body">
                    <!-- Component PC v1.5: card + field h42 + action bar có separator
                         (UI-PC-BASE-008/009). Route POST, name field, required GIỮ NGUYÊN. -->
                    <form method="post" action="/portal/support/new" enctype="multipart/form-data"
                          data-wj-dirty-guard="1" class="wj-surface-card wj-pc-card">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row g-3">
                            <div class="col-md-6 col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Store</label>
                                    <select name="franchise_id" class="wj-pc-control" required="required">
                                        <t t-foreach="franchises" t-as="f">
                                            <option t-att-value="f.id" t-out="f.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Classification</label>
                                    <select name="category_id" class="wj-pc-control" required="required">
                                        <t t-foreach="categories" t-as="c">
                                            <option t-att-value="c.id" t-out="c.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Severity</label>
                                    <select name="priority" class="wj-pc-control">
                                        <option value="normal" selected="selected">Normal</option>
                                        <option value="urgent">Urgent</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Title</label>
                                    <input type="text" name="title" class="wj-pc-control" required="required"
                                           placeholder="E.g. Cannot place order no. ..."/>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Detailed description</label>
                                    <textarea name="description" rows="6" class="wj-pc-control"
                                              placeholder="Describe the situation, the steps you tried, screenshots..."/>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="wj-pc-field">
                                    <label class="wj-pc-field__label">Attached files (optional)</label>
                                    <input type="file" name="attachments" class="wj-pc-control" multiple="multiple"/>
                                </div>
                            </div>
                        </div>
                        <div class="wj-pc-form-actions">
                            <a href="/portal/support" class="wj-btn wj-btn--secondary">Cancel</a>
                            <button type="submit" class="wj-btn wj-btn--primary">
                                <i class="fa fa-paper-plane" title="Send"/>Submit request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- /desktop -->

            <!-- ===== Mobile (<992px) — Sprint 17, Figma Mobile_Ticket màn "Tạo yêu cầu hỗ trợ".
                 BlankShell .wujia-mpage, route POST /portal/support/new GIỮ NGUYÊN. -->
            <div class="d-lg-none wujia-mpage wujia-mticket">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Create a support request</t>
                    <t t-set="ph_back_url" t-value="'/portal/support'"/>
                </t>

                <form method="post" action="/portal/support/new" enctype="multipart/form-data"
                      class="wj-mform" data-wj-dirty-guard="1">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_variant" t-value="'section'"/>
                        <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Ticket information</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'m'"/>
                        </t>

                        <label class="wujia-mticket-label" for="wj-sup-m-category">Request type</label>
                        <select id="wj-sup-m-category" name="category_id" class="form-select mb-3" required="required">
                            <option value="">Select a request type</option>
                            <t t-foreach="categories" t-as="c">
                                <option t-att-value="c.id" t-out="c.name"/>
                            </t>
                        </select>

                        <label class="wujia-mticket-label" for="wj-sup-m-title">Title</label>
                        <input type="text" id="wj-sup-m-title" name="title" class="form-control mb-3" required="required"
                               placeholder="Enter a short title"/>

                        <label class="wujia-mticket-label" for="wj-sup-m-description">Detailed content</label>
                        <textarea id="wj-sup-m-description" name="description" rows="4" class="form-control mb-3"
                                  placeholder="Describe the issue, when it happened and any related document numbers."/>

                        <label class="wujia-mticket-label">Priority level</label>
                        <!-- BA: 'Gấp' và 'Khẩn cấp' đều map 'urgent' — model chưa có giá trị riêng cho 'Gấp' -->
                        <div class="wj-filter-chips mb-3">
                            <label class="wj-filter-chip">
                                <input type="radio" name="priority" value="normal" checked="checked"
                                       class="d-none"/> Normal
                            </label>
                            <label class="wj-filter-chip">
                                <input type="radio" name="priority" value="urgent" class="d-none"/> Rush
                            </label>
                            <label class="wj-filter-chip">
                                <input type="radio" name="priority" value="urgent" class="d-none"/> Critical
                            </label>
                        </div>

                        <label class="wujia-mticket-label">Attachments</label>
                        <p class="wujia-mticket-hint">Add screenshots / error files — PNG, JPG, PDF — up to 5 files</p>
                        <input type="file" id="wj-sup-m-attachments" name="attachments" class="form-control mb-1"
                               aria-label="Attachments"
                               multiple="multiple" accept=".png,.jpg,.jpeg,.pdf"/>

                        <!-- Cửa hàng: 1 franchise → hidden; nhiều → select -->
                        <t t-if="franchises and len(franchises) == 1">
                            <input type="hidden" name="franchise_id" t-att-value="franchises[0].id"/>
                        </t>
                        <t t-elif="franchises">
                            <label class="wujia-mticket-label mt-3" for="wj-sup-m-franchise">Store</label>
                            <select id="wj-sup-m-franchise" name="franchise_id" class="form-select" required="required">
                                <t t-foreach="franchises" t-as="f">
                                    <option t-att-value="f.id" t-out="f.name"/>
                                </t>
                            </select>
                        </t>
                    </t>

                    <p t-if="error == 'missing_fields'" class="text-danger small mt-2 mb-0">
                        Please fill in all required fields.
                    </p>
                    <p t-if="error == 'invalid_franchise'" class="text-danger small mt-2 mb-0">
                        Invalid store.
                    </p>
                    <p t-if="error == 'invalid_input'" class="text-danger small mt-2 mb-0">
                        The submitted data is invalid.
                    </p>
                    <p t-if="error == 'invalid_attachment'" class="text-danger small mt-2 mb-0">
                        Attachments must be images or PDF files, up to 6 files, each ≤ 5MB.
                    </p>

                    <button type="submit" class="wj-btn wj-btn--primary wj-btn--block mt-3">Submit a support request</button>
                </form>
            </div>
            <!-- /mobile -->
        </t>
    </template>

    <!-- ============== Detail ============== -->
    <template id="portal_support_detail" name="Wujia Portal — Support Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="ticket.name"/>
            <!-- ===== Desktop (>=992px) — GIỮ NGUYÊN, bọc d-none d-lg-block (Sprint 17) ===== -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Support / Support request details</t>
                    <t t-set="ph_title">Support request details</t>
                    <t t-set="ph_back_url" t-value="'/portal/support'"/>
                </t>
                <!-- Status badge dời khỏi header (spec title-only) → block riêng dưới header -->
                <t t-set="lbl" t-value="state_labels.get(ticket.state, (ticket.state, 'wj-status-badge--neutral'))"/>
                <div class="mb-2"><span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/></div>
                <div class="content-body">
                    <div class="row">
                        <div class="col-md-8 col-12">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush mb-2">
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Request content</t>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                    <t t-set="ch_class" t-value="'wj-surface-card__head wj-card-header--flush'"/>
                                </t>
                                <div class="wj-surface-card__body">
                                    <div class="wj-sup-content wj-richtext" t-out="ticket.description or '—'"/>
                                </div>
                            </div>
                            <t t-set="portal_files" t-value="ticket._portal_attachments()"/>
                            <div t-if="portal_files" class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush mb-2">
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Attached files</t>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                    <t t-set="ch_class" t-value="'wj-surface-card__head wj-card-header--flush'"/>
                                </t>
                                <ul class="list-group list-group-flush">
                                    <li t-foreach="portal_files" t-as="att" class="list-group-item">
                                        <a t-attf-href="/portal/support/#{ticket.id}/attachment/#{att.id}">
                                            <i class="fa fa-paperclip me-1" title="Attachment"/><t t-out="att.name"/>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Chatter — show comment messages, oldest first -->
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush support-chatter mb-2">
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Conversation</t>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                    <t t-set="ch_class" t-value="'wj-surface-card__head wj-card-header--flush'"/>
                                </t>
                                <div class="wj-surface-card__body">
                                    <t t-set="comments" t-value="ticket._portal_messages()"/>
                                    <div t-if="not comments" class="wujia-empty-state">
                                        <i class="feather icon-message-square"/>
                                        <p>No messages yet.</p>
                                    </div>
                                    <div t-else="">
                                        <div t-foreach="comments" t-as="msg" class="mb-2 pb-2 border-bottom">
                                            <div class="d-flex justify-content-between">
                                                <strong t-out="msg.author_id.name or 'System'"/>
                                                <small class="text-muted" t-out="msg.date and msg.date.strftime('%d/%m/%Y %H:%M') or ''"/>
                                            </div>
                                            <div t-out="msg.body"/>
                                        </div>
                                    </div>
                                </div>
                                <div t-if="ticket.state not in ('closed', 'cancelled')" class="wj-surface-card__foot">
                                    <form method="post" t-attf-action="/portal/support/#{ticket.id}/reply">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <textarea name="body" rows="3" class="form-control mb-2"
                                                  placeholder="Reply to HQ..." required="required"/>
                                        <button type="submit" class="wj-btn wj-btn--primary wj-btn--sm">
                                            <i class="fa fa-paper-plane"/>Send
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 col-12">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush">
                                <t t-call="wujia_portal_layout.wj_card_header">
                                    <t t-set="ch_title">Info</t>
                                    <t t-set="ch_platform" t-value="'pc'"/>
                                    <t t-set="ch_class" t-value="'wj-surface-card__head wj-card-header--flush'"/>
                                </t>
                                <div class="wj-surface-card__body">
                                    <dl class="row mb-0 profile-dl">
                                        <!-- S53-B3b: mã ticket + tiêu đề gỡ khỏi PageHeader
                                             (CMP-PG-001 CONTENT RULES) → về card thông tin. -->
                                        <dt class="col-5">Request code</dt>
                                        <dd class="col-7" t-out="ticket.name"/>
                                        <dt class="col-5">Title</dt>
                                        <dd class="col-7" t-out="ticket.title or '—'"/>
                                        <dt class="col-5">Store</dt>
                                        <dd class="col-7" t-out="ticket.franchise_id.name or '—'"/>
                                        <dt class="col-5">Classification</dt>
                                        <dd class="col-7" t-out="ticket.category_id.name or '—'"/>
                                        <dt class="col-5">Severity</dt>
                                        <!-- WJ-SUPPORT-003: cùng nguồn nhãn đã dịch với mobile (priority_labels). -->
                                        <dd class="col-7" t-out="priority_labels.get(ticket.priority, (ticket.priority, ''))[0]"/>
                                        <dt class="col-5">Sent on</dt>
                                        <dd class="col-7" t-out="ticket.create_date and ticket.create_date.strftime('%d/%m/%Y %H:%M') or ''"/>
                                        <dt class="col-5">Assignee</dt>
                                        <dd class="col-7" t-out="ticket.assigned_user_id.name or '—'"/>
                                        <dt class="col-5">Resolved on</dt>
                                        <dd class="col-7" t-out="ticket.resolved_date and ticket.resolved_date.strftime('%d/%m/%Y') or '—'"/>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Nút "Quay lại" cuối trang đã gỡ: chỉ MỘT nút back / màn, nằm ở
                         page header (UI-PC-BASE-006). -->
                </div>
            </div>
            <!-- /desktop -->

            <!-- ===== Mobile (<992px) — Sprint 17, Figma Mobile_Ticket màn "Chi tiết ticket".
                 BlankShell .wujia-mpage. Bubble: khách = trái xám / Wujia Support = phải cyan.
                 Reply POST /portal/support/<id>/reply GIỮ NGUYÊN. -->
            <div class="d-lg-none wujia-mpage wujia-mticket">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Support request details</t>
                    <t t-set="ph_back_url" t-value="'/portal/support'"/>
                </t>

                <!-- Header card: mã + badge + tiêu đề -->
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="wujia-mdash-row-sub is-primary" t-out="ticket.name"/>
                        <t t-set="lbl" t-value="m_ticket_badges.get(ticket.state, (ticket.state, 'wj-status-badge--neutral'))"/>
                        <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                    </div>
                    <p class="wujia-mdash-row-title mb-0" style="white-space:normal;" t-out="ticket.title"/>
                </t>

                <!-- Meta grid -->
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_body" t-value="'flush'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wujia-mdash-list'"/>
                    <div class="wujia-mdash-row">
                        <span class="wujia-mdash-ico"><i class="feather icon-tag"/></span>
                        <span class="wujia-mdash-row-main">
                            <span class="wujia-mdash-row-sub">Group</span>
                            <span class="wujia-mdash-row-sub is-strong" t-out="ticket.category_id.name or '—'"/>
                        </span>
                    </div>
                    <div class="wujia-mdash-row">
                        <span class="wujia-mdash-ico"><i class="feather icon-flag"/></span>
                        <span class="wujia-mdash-row-main">
                            <span class="wujia-mdash-row-sub">Priority</span>
                            <t t-set="prio" t-value="priority_labels.get(ticket.priority, (ticket.priority, ''))"/>
                            <span class="wujia-mdash-row-sub is-strong" t-out="prio[0]"/>
                        </span>
                    </div>
                    <div class="wujia-mdash-row">
                        <span class="wujia-mdash-ico"><i class="feather icon-user"/></span>
                        <span class="wujia-mdash-row-main">
                            <span class="wujia-mdash-row-sub">Sender</span>
                            <span class="wujia-mdash-row-sub is-strong" t-out="ticket.created_by_id.name or '—'"/>
                        </span>
                    </div>
                    <div class="wujia-mdash-row">
                        <span class="wujia-mdash-ico"><i class="feather icon-calendar"/></span>
                        <span class="wujia-mdash-row-main">
                            <span class="wujia-mdash-row-sub">Created on</span>
                            <span class="wujia-mdash-row-sub is-strong"
                                  t-out="ticket.create_date and ticket.create_date.strftime('%d/%m/%Y') or '—'"/>
                        </span>
                    </div>
                </t>

                <!-- WJ-SUPPORT-002: nội dung gốc như PC, đọc đủ trước khi trả lời (không thu gọn). -->
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_body" t-value="'flush'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wj-surface-headpad">
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Request content</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'m'"/>
                            <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                        </t>
                    </div>
                    <div class="wujia-mticket-content wj-sup-content wj-richtext" t-out="ticket.description or '—'"/>
                </t>

                <!-- File đính kèm -->
                <t t-set="portal_files" t-value="ticket._portal_attachments()"/>
                <t t-if="portal_files" t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_body" t-value="'flush'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wj-surface-headpad">
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Attached files</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'m'"/>
                            <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                        </t>
                    </div>
                    <t t-call="wujia_portal_layout.wj_data_list">
                        <t t-set="dl_variant" t-value="'compact-row'"/>
                        <t t-set="dl_class" t-value="'wujia-mdash-list wj-data-list--inset'"/>
                        <a t-foreach="portal_files" t-as="att" class="wujia-mdash-row wj-data-item"
                           t-attf-href="/portal/support/#{ticket.id}/attachment/#{att.id}">
                            <span class="wujia-mdash-tile"><i class="feather icon-paperclip"/></span>
                            <span class="wujia-mdash-row-main">
                                <span class="wujia-mdash-row-title is-sm" t-out="att.name"/>
                            </span>
                        </a>
                    </t>
                </t>

                <!-- Lịch sử trao đổi -->
                <t t-set="comments" t-value="ticket._portal_messages()"/>
                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_body" t-value="'flush'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wj-surface-headpad">
                        <t t-call="wujia_portal_layout.wj_card_header">
                            <t t-set="ch_title">Conversation history</t>
                            <t t-set="ch_level" t-value="2"/>
                            <t t-set="ch_platform" t-value="'m'"/>
                            <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            <t t-set="ch_meta">
                                <t t-set="_n" t-value="len(comments)"/>
                                <span class="wj-card-header__meta"><t t-out="_n"/> <t t-if="_n == 1">reply</t><t t-else="">replies</t></span>
                            </t>
                        </t>
                    </div>
                    <div class="wujia-mticket-thread">
                        <div t-if="not comments" class="wj-empty-state--compact">No conversation yet.</div>
                        <t t-foreach="comments" t-as="msg">
                            <t t-set="is_customer" t-value="msg.author_id.id == ticket.created_by_id.partner_id.id"/>
                            <div t-attf-class="wujia-mticket-bubble wj-richtext #{'is-customer' if is_customer else 'is-hq'}"
                                 t-out="msg.body"/>
                            <div t-attf-class="wujia-mticket-bubble-meta #{'is-customer' if is_customer else 'is-hq'}">
                                <t t-out="msg.author_id.name or 'Wujia Support'"/> ·
                                <t t-out="msg.date and msg.date.strftime('%d/%m %H:%M') or ''"/>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Reply box (ẩn khi đóng / huỷ) -->
                <form t-if="ticket.state not in ('closed', 'cancelled')" method="post"
                      t-attf-action="/portal/support/#{ticket.id}/reply" class="wujia-mticket-reply">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <textarea name="body" class="wujia-mticket-reply-input mb-2"
                              placeholder="Add a reply..." required="required"/>
                    <button type="submit" class="wj-btn wj-btn--primary wj-btn--block">
                        <i class="feather icon-send"/>Send
                    </button>
                </form>
            </div>
            <!-- /mobile -->
        </t>
    </template>

</odoo>
