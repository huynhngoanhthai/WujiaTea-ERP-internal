<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- F5a — dòng sheet "Thêm" của màn này. -->
    <template id="mobile_bottomnav_return"
              inherit_id="wujia_portal_layout.mobile_bottomnav"
              priority="20"
              name="Wujia Mobile — More sheet: Returns / Compensation">
        <xpath expr="//span[@id='msheet_end']" position="before">
            <t t-call="wujia_portal_layout.wj_msheet_item">
                <t t-set="mi_href" t-value="'/portal/return'"/>
                <t t-set="mi_icon" t-value="'feather icon-corner-up-left'"/>
                <t t-set="mi_title">Returns / Compensation</t>
                <t t-set="mi_sub">Submit and track product claims</t>
            </t>
        </xpath>
    </template>

</odoo>
