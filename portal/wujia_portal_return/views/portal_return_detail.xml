<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_return_detail" name="Wujia Portal — Return Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="rr.name"/>

            <t t-set="no_order_label">No original order</t>
            <t t-set="_ret_t_not_recorded">Not recorded</t>
            <t t-set="_ret_t_no_note">The store left no note</t>
            <t t-set="wj_txt">No feedback from {brand} yet.</t>
            <t t-set="_ret_t_no_feedback" t-value="wj_txt.replace('{brand}', wj_brand['name'])"/>
            <t t-set="wj_txt">{brand} feedback</t>
            <t t-set="_ret_t_feedback" t-value="wj_txt.replace('{brand}', wj_brand['name'])"/>
            <t t-set="lbl" t-value="wj_state_label(rr)"/>
            <t t-set="_ret_pc_card" t-value="'wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush mb-2'"/>

            <!-- Desktop ≥992px — một cột, cùng thứ tự nhóm với mobile -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Compensation / Compensation request detail</t>
                    <t t-set="ph_title">Compensation request detail</t>
                    <t t-set="ph_back_url" t-value="'/portal/return'"/>
                </t>

                <div class="content-body wj-return-detail">
                    <div t-attf-class="#{_ret_pc_card} wj-ret-g wj-ret-g--summary">
                        <div class="wj-surface-card__body">
                            <div class="wujia-mreturn-row-head">
                                <span class="wujia-mreturn-row-code" t-out="rr.name"/>
                                <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                            </div>
                            <div class="wujia-mreturn-summary-meta">
                                <span t-out="rr.sale_order_id.name or no_order_label"/>
                                <span t-out="wj_dt(rr.request_date, '%d/%m/%Y') or '—'"/>
                            </div>
                        </div>
                    </div>

                    <div t-attf-class="#{_ret_pc_card} wj-ret-g wj-ret-g--request">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Request information</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <dl class="row mb-0 profile-dl">
                                <dt class="col-sm-4">Request date</dt>
                                <dd class="col-sm-8" t-out="wj_dt(rr.request_date, '%d/%m/%Y %H:%M') or '—'"/>
                                <dt class="col-sm-4">Original order</dt>
                                <dd class="col-sm-8">
                                    <a t-if="rr.sale_order_id" t-attf-href="/portal/purchase-history/#{rr.sale_order_id.id}" t-out="rr.sale_order_id.name"/>
                                    <t t-else="" t-out="no_order_label"/>
                                </dd>
                                <dt class="col-sm-4">Unboxing time</dt>
                                <dd class="col-sm-8" t-out="wj_dt(rr.opening_datetime, '%d/%m/%Y %H:%M') or '—'"/>
                                <dt class="col-sm-4">Production date</dt>
                                <dd class="col-sm-8" t-out="wj_dt(rr.production_date, '%d/%m/%Y') or _ret_t_not_recorded"/>
                                <dt class="col-sm-4">Created by</dt>
                                <dd class="col-sm-8" t-out="rr.requester_user_id.name or '—'"/>
                            </dl>
                        </div>
                    </div>

                    <div t-attf-class="#{_ret_pc_card} wj-ret-g wj-ret-g--product">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Requested product</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <dl class="row mb-0 profile-dl">
                                <dt class="col-sm-4">Product</dt>
                                <dd class="col-sm-8" t-out="wj_pname(rr.product_id) or '—'"/>
                                <dt class="col-sm-4">Requested qty</dt>
                                <dd class="col-sm-8" t-out="rr._portal_qty_label()"/>
                            </dl>
                        </div>
                    </div>

                    <div t-attf-class="#{_ret_pc_card} wj-ret-g wj-ret-g--issue">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Issue details</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <dl class="row mb-0 profile-dl">
                                <dt class="col-sm-4">Issue type</dt>
                                <dd class="col-sm-8" t-out="rr.issue_type_id.name or '—'"/>
                                <dt class="col-sm-4">Note from the store</dt>
                                <dd class="col-sm-8" t-out="rr.note or _ret_t_no_note"/>
                                <t t-if="rr.image_attachment_ids">
                                    <dt class="col-sm-4">Evidence photos</dt>
                                    <dd class="col-sm-8"><t t-call="wujia_portal_return.portal_return_photo_count"/></dd>
                                </t>
                            </dl>
                            <div t-if="rr.image_attachment_ids" class="row g-2 mt-1">
                                <div t-foreach="rr.image_attachment_ids" t-as="img" class="col-6 col-sm-4 col-md-3">
                                    <a t-attf-href="/portal/return/#{rr.id}/attachment/#{img.id}" target="_blank">
                                        <img loading="lazy" t-attf-src="/portal/return/#{rr.id}/attachment/#{img.id}"
                                             class="img-fluid rounded return-image-thumb" t-att-alt="img.name"/>
                                    </a>
                                </div>
                            </div>
                            <ul t-if="rr.video_attachment_ids" class="list-unstyled mb-0 mt-2">
                                <li t-foreach="rr.video_attachment_ids" t-as="vid">
                                    <a t-attf-href="/portal/return/#{rr.id}/attachment/#{vid.id}" target="_blank">
                                        <i class="feather icon-video"/> <t t-out="vid.name"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div t-attf-class="#{_ret_pc_card} wujia-mreturn-response wj-ret-g wj-ret-g--feedback">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title" t-value="_ret_t_feedback"/>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <t t-call="wujia_portal_return.portal_return_feedback_body"/>
                        </div>
                    </div>

                    <div t-if="comp" t-attf-class="#{_ret_pc_card} wj-ret-g wj-ret-g--resolution">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Resolution &amp; compensation progress</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <dl class="row mb-0 profile-dl">
                                <dt class="col-sm-4">Resolution</dt>
                                <dd class="col-sm-8">
                                    <span class="wujia-badge wujia-badge-info" t-out="comp['resolution_label']"/>
                                </dd>
                            </dl>
                            <t t-if="comp['is_compensation']">
                                <hr/>
                                <dl class="row mb-0 profile-dl">
                                    <dt class="col-sm-4">Compensation product</dt>
                                    <dd class="col-sm-8" t-out="comp['product_label']"/>
                                    <dt class="col-sm-4">Approved compensation qty</dt>
                                    <dd class="col-sm-8">
                                        <t t-out="'{:,.2f}'.format(comp['approved_qty'])"/> <t t-out="comp['approved_uom']"/>
                                    </dd>
                                    <dt class="col-sm-4">Added to compensation orders</dt>
                                    <dd class="col-sm-8">
                                        <t t-out="'{:,.2f}'.format(comp['allocated_qty'])"/> <t t-out="comp['approved_uom']"/>
                                    </dd>
                                    <dt class="col-sm-4">Compensation status</dt>
                                    <dd class="col-sm-8">
                                        <span t-attf-class="wj-status-badge #{comp['status'][1]}" t-out="comp['status'][0]"/>
                                    </dd>
                                </dl>
                                <div t-if="comp['all_cancelled']" class="alert alert-warning mt-3 mb-0">
                                    The compensation order was cancelled. If you still need compensation, please create a new request.
                                </div>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Compensated <strong t-out="'{:,.2f}'.format(comp['compensated_qty'])"/> <t t-out="comp['approved_uom']"/></span>
                                        <span>Still short <strong t-out="'{:,.2f}'.format(comp['remaining_qty'])"/> <t t-out="comp['approved_uom']"/></span>
                                    </div>
                                    <div class="progress wujia-return-progress">
                                        <div class="progress-bar" role="progressbar"
                                             t-attf-style="width: #{comp['progress_pct']}%;"
                                             t-att-aria-valuenow="comp['progress_pct']"
                                             aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                </div>
                                <t t-if="comp['orders']">
                                    <hr/>
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Compensation orders</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_platform" t-value="'pc'"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel'"/>
                                    </t>
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            <tr t-foreach="comp['orders']" t-as="o">
                                                <td t-out="o['name']"/>
                                                <td t-out="o['state_label']"/>
                                                <td class="text-end text-muted" t-out="o['delivery_label']"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile <992px -->
            <div class="d-lg-none wujia-mpage wujia-mreturn">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Compensation request detail</t>
                    <t t-set="ph_back_url" t-value="'/portal/return'"/>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wj-ret-g wj-ret-g--summary'"/>
                    <div class="wujia-mreturn-row-head">
                        <span class="wujia-mreturn-row-code" t-out="rr.name"/>
                        <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                    </div>
                    <div class="wujia-mreturn-summary-meta">
                        <span t-out="rr.sale_order_id.name or no_order_label"/>
                        <span t-out="wj_dt(rr.request_date, '%d/%m/%Y') or '—'"/>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wj-ret-g wj-ret-g--request'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Request information</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Request date</span>
                        <span class="wujia-mhist-kv-value" t-out="wj_dt(rr.request_date, '%d/%m/%Y %H:%M') or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Original order</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.sale_order_id.name or no_order_label"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Unboxing time</span>
                        <span class="wujia-mhist-kv-value" t-out="wj_dt(rr.opening_datetime, '%d/%m/%Y %H:%M') or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Production date</span>
                        <span class="wujia-mhist-kv-value" t-out="wj_dt(rr.production_date, '%d/%m/%Y') or _ret_t_not_recorded"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Created by</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.requester_user_id.name or '—'"/>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wj-ret-g wj-ret-g--product'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Requested product</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Product</span>
                        <span class="wujia-mhist-kv-value" t-out="wj_pname(rr.product_id) or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Requested qty</span>
                        <span class="wujia-mhist-kv-value" t-out="rr._portal_qty_label()"/>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wj-ret-g wj-ret-g--issue'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Issue details</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Issue type</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.issue_type_id.name or '—'"/>
                    </div>
                    <p class="wujia-mhist-note" t-out="rr.note or _ret_t_no_note"/>
                    <div t-if="rr.image_attachment_ids" class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Evidence photos</span>
                        <span class="wujia-mhist-kv-value"><t t-call="wujia_portal_return.portal_return_photo_count"/></span>
                    </div>
                    <div t-if="rr.image_attachment_ids" class="wujia-mreturn-thumbs">
                        <a t-foreach="rr.image_attachment_ids" t-as="img" target="_blank"
                           t-attf-href="/portal/return/#{rr.id}/attachment/#{img.id}">
                            <img loading="lazy" t-att-alt="img.name"
                                 t-attf-src="/portal/return/#{rr.id}/attachment/#{img.id}"/>
                        </a>
                    </div>
                    <ul t-if="rr.video_attachment_ids" class="list-unstyled mb-0 mt-2">
                        <li t-foreach="rr.video_attachment_ids" t-as="vid">
                            <a t-attf-href="/portal/return/#{rr.id}/attachment/#{vid.id}" target="_blank">
                                <i class="feather icon-video"/> <t t-out="vid.name"/>
                            </a>
                        </li>
                    </ul>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wujia-mreturn-response wj-ret-g wj-ret-g--feedback'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title" t-value="_ret_t_feedback"/>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <t t-call="wujia_portal_return.portal_return_feedback_body"/>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card" t-if="comp">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wj-ret-g wj-ret-g--resolution'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Resolution &amp; compensation progress</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Outcome</span>
                        <span class="wujia-mhist-kv-value">
                            <span class="wujia-badge wujia-badge-info" t-out="comp['resolution_label']"/>
                        </span>
                    </div>
                    <t t-if="comp['is_compensation']">
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Compensation product</span>
                            <span class="wujia-mhist-kv-value" t-out="comp['product_label']"/>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Approved compensation qty</span>
                            <span class="wujia-mhist-kv-value">
                                <t t-out="'{:,.2f}'.format(comp['approved_qty'])"/> <t t-out="comp['approved_uom']"/>
                            </span>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Added to compensation orders</span>
                            <span class="wujia-mhist-kv-value">
                                <t t-out="'{:,.2f}'.format(comp['allocated_qty'])"/> <t t-out="comp['approved_uom']"/>
                            </span>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Compensation status</span>
                            <span class="wujia-mhist-kv-value">
                                <span t-attf-class="wj-status-badge #{comp['status'][1]}" t-out="comp['status'][0]"/>
                            </span>
                        </div>
                        <p t-if="comp['all_cancelled']" class="wujia-mticket-hint">
                            The compensation order was cancelled. If you still need compensation, please create a new request.
                        </p>
                        <div class="wujia-mreturn-progress-wrap">
                            <div class="wujia-mreturn-progress-meta">
                                <span>Compensated <t t-out="'{:,.2f}'.format(comp['compensated_qty'])"/></span>
                                <span>Still short <t t-out="'{:,.2f}'.format(comp['remaining_qty'])"/></span>
                            </div>
                            <div class="progress wujia-return-progress">
                                <div class="progress-bar" t-attf-style="width: #{comp['progress_pct']}%;"/>
                            </div>
                        </div>
                        <div t-if="comp['orders']" class="wujia-mreturn-so-list">
                            <div t-foreach="comp['orders']" t-as="o" class="wujia-mreturn-so-row">
                                <span class="wujia-mreturn-so-name" t-out="o['name']"/>
                                <span class="wujia-mreturn-so-deliv" t-out="o['delivery_label']"/>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_return_photo_count" name="Wujia Portal — Return photo count">
        <t t-set="_n" t-value="len(rr.image_attachment_ids)"/>
        <t t-out="_n"/> <t t-if="_n == 1">attached photo</t><t t-else="">attached photos</t>
    </template>

    <template id="portal_return_feedback_body" name="Wujia Portal — Return feedback body">
        <t t-if="rr.reject_reason">
            <t t-call="wujia_portal_layout.wj_card_header">
                <t t-set="ch_title">Rejection reason</t>
                <t t-set="ch_level" t-value="4"/>
                <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel wj-return-sublabel--danger'"/>
            </t>
            <p class="wujia-mreturn-resp-body" t-out="rr.reject_reason"/>
        </t>
        <p t-if="comp and comp.get('approval_note')" class="wujia-mreturn-resp-body" t-out="comp['approval_note']"/>
        <p t-if="not rr.reject_reason and not (comp and comp.get('approval_note'))" class="wujia-mhist-note" t-out="_ret_t_no_feedback"/>
    </template>

</odoo>
