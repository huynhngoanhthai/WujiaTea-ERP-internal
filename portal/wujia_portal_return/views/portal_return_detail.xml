<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_return_detail" name="Wujia Portal — Return Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="rr.name"/>

            <!-- Desktop ≥992px -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Compensation / Compensation request detail</t>
                    <t t-set="ph_title">Compensation request detail</t>
                    <t t-set="ph_back_url" t-value="'/portal/return'"/>
                </t>
                <t t-set="lbl" t-value="wj_state_label(rr)"/>
                <div class="mb-2"><span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/></div>

                <div class="content-body">
                    <div class="row">
                        <div class="col-md-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Request information</t>
                                        <t t-set="ch_level" t-value="3"/>
                                        <t t-set="ch_platform" t-value="'pc'"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <dl class="row mb-0 profile-dl">
                                        <!-- S53-B3b: mã yêu cầu gỡ khỏi PageHeader (CMP-PG-001
                                             CONTENT RULES) → hiển thị tại card thông tin. -->
                                        <dt class="col-sm-5">Request code</dt>
                                        <dd class="col-sm-7" t-out="rr.name"/>
                                        <dt class="col-sm-5">Store</dt>
                                        <dd class="col-sm-7" t-out="rr.franchise_id.name or '—'"/>
                                        <dt class="col-sm-5">Request date</dt>
                                        <dd class="col-sm-7" t-out="wj_dt(rr.request_date, '%d/%m/%Y %H:%M')"/>
                                        <dt class="col-sm-5">Original order</dt>
                                        <dd class="col-sm-7">
                                            <t t-if="rr.sale_order_id">
                                                <a t-attf-href="/portal/purchase-history/#{rr.sale_order_id.id}" t-out="rr.sale_order_id.name"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </dd>
                                        <dt class="col-sm-5">Issue type</dt>
                                        <dd class="col-sm-7" t-out="rr.issue_type_id.name or '—'"/>
                                        <dt class="col-sm-5">Unboxing time</dt>
                                        <dd class="col-sm-7" t-out="wj_dt(rr.opening_datetime, '%d/%m/%Y %H:%M') or '—'"/>
                                        <dt class="col-sm-5">Production date</dt>
                                        <dd class="col-sm-7" t-out="wj_dt(rr.production_date, '%d/%m/%Y') or '—'"/>
                                        <dt class="col-sm-5">Created by</dt>
                                        <dd class="col-sm-7" t-out="rr.requester_user_id.name or '—'"/>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Notes &amp; feedback</t>
                                        <t t-set="ch_level" t-value="3"/>
                                        <t t-set="ch_platform" t-value="'pc'"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Note from the store</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_platform" t-value="'pc'"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel'"/>
                                    </t>
                                    <p t-if="rr.note" t-out="rr.note"/>
                                    <p t-else="" class="text-muted fst-italic">No notes.</p>
                                    <t t-if="rr.reject_reason">
                                        <hr/>
                                        <t t-call="wujia_portal_layout.wj_card_header">
                                            <t t-set="ch_title">Rejection reason</t>
                                            <t t-set="ch_level" t-value="4"/>
                                            <t t-set="ch_platform" t-value="'pc'"/>
                                            <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel wj-return-sublabel--danger'"/>
                                        </t>
                                        <p t-out="rr.reject_reason"/>
                                    </t>
                                    <t t-if="comp and comp.get('approval_note')">
                                        <hr/>
                                        <t t-call="wujia_portal_layout.wj_card_header">
                                            <t t-set="wj_txt">Feedback from {brand}</t>
                                            <t t-set="ch_title" t-value="wj_txt.replace('{brand}', wj_brand['name'])"/>
                                            <t t-set="ch_level" t-value="4"/>
                                            <t t-set="ch_platform" t-value="'pc'"/>
                                            <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel'"/>
                                        </t>
                                        <p t-out="comp['approval_note']"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush mb-2">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Requested product</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body wj-surface-card__body--flush">
                            <table class="table mb-0 wj-return-ptable">
                                <thead><tr><th>Product</th><th class="text-end">Requested qty</th><th>UoM</th></tr></thead>
                                <tbody>
                                    <tr>
                                        <td t-out="rr.product_id.display_name or '—'"/>
                                        <td class="text-end" t-out="'{:,.2f}'.format(rr.request_qty or 0)"/>
                                        <td t-out="rr.request_uom_id.name or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush mb-2" t-if="comp">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Resolution &amp; compensation progress</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <dl class="row mb-0 profile-dl">
                                <dt class="col-sm-4">Resolution</dt>
                                <dd class="col-sm-8">
                                    <span class="wujia-badge wujia-badge-info" t-out="comp['resolution_label']"/>
                                </dd>
                            </dl>
                            <t t-if="comp['is_compensation']">
                                <hr/>
                                <dl class="row mb-0 profile-dl">
                                    <dt class="col-sm-4">Compensation product</dt>
                                    <dd class="col-sm-8" t-out="comp['product_label']"/>
                                    <dt class="col-sm-4">Approved compensation qty</dt>
                                    <dd class="col-sm-8">
                                        <t t-out="'{:,.2f}'.format(comp['approved_qty'])"/> <t t-out="comp['approved_uom']"/>
                                    </dd>
                                    <dt class="col-sm-4">Added to compensation orders</dt>
                                    <dd class="col-sm-8">
                                        <t t-out="'{:,.2f}'.format(comp['allocated_qty'])"/> <t t-out="comp['approved_uom']"/>
                                    </dd>
                                    <dt class="col-sm-4">Compensation status</dt>
                                    <dd class="col-sm-8">
                                        <span t-attf-class="wj-status-badge #{comp['status'][1]}" t-out="comp['status'][0]"/>
                                    </dd>
                                </dl>
                                <div t-if="comp['all_cancelled']" class="alert alert-warning mt-3 mb-0">
                                    The compensation order was cancelled. If you still need compensation, please create a new request.
                                </div>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Compensated <strong t-out="'{:,.2f}'.format(comp['compensated_qty'])"/> <t t-out="comp['approved_uom']"/></span>
                                        <span>Still short <strong t-out="'{:,.2f}'.format(comp['remaining_qty'])"/> <t t-out="comp['approved_uom']"/></span>
                                    </div>
                                    <div class="progress wujia-return-progress">
                                        <div class="progress-bar" role="progressbar"
                                             t-attf-style="width: #{comp['progress_pct']}%;"
                                             t-att-aria-valuenow="comp['progress_pct']"
                                             aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                </div>
                                <t t-if="comp['orders']">
                                    <hr/>
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Compensation orders</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_platform" t-value="'pc'"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--sublabel wj-return-sublabel'"/>
                                    </t>
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            <tr t-foreach="comp['orders']" t-as="o">
                                                <td t-out="o['name']"/>
                                                <td t-out="o['state_label']"/>
                                                <td class="text-end text-muted" t-out="o['delivery_label']"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </t>
                        </div>
                    </div>

                    <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush" t-if="rr.image_attachment_ids">
                        <div class="wj-surface-card__head">
                            <t t-call="wujia_portal_layout.wj_card_header">
                                <t t-set="ch_title">Evidence photos</t>
                                <t t-set="ch_level" t-value="3"/>
                                <t t-set="ch_platform" t-value="'pc'"/>
                                <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                            </t>
                        </div>
                        <div class="wj-surface-card__body">
                            <div class="row g-2">
                                <t t-foreach="rr.image_attachment_ids" t-as="img">
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <a t-attf-href="/portal/return/#{rr.id}/attachment/#{img.id}" target="_blank">
                                            <img loading="lazy"
                                                 t-attf-src="/portal/return/#{rr.id}/attachment/#{img.id}"
                                                 class="img-fluid rounded return-image-thumb"
                                                 t-att-alt="img.name"/>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Nút "Quay lại" cuối trang đã gỡ: chỉ MỘT nút back / màn, nằm ở
                         page header (UI-PC-BASE-006). -->
                </div>
            </div>

            <!-- Mobile <992px -->
            <div class="d-lg-none wujia-mpage wujia-mreturn">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Compensation request detail</t>
                    <t t-set="ph_back_url" t-value="'/portal/return'"/>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <div class="wujia-mreturn-row-head">
                        <span class="wujia-mreturn-row-code" t-out="rr.name"/>
                        <t t-set="lbl" t-value="wj_state_label(rr)"/>
                        <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                    </div>
                    <div class="wujia-mreturn-summary-meta">
                        <span t-out="rr.sale_order_id.name or '—'"/>
                        <span t-out="wj_dt(rr.request_date, '%d/%m/%Y') or '—'"/>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Order information</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Request date</span>
                        <span class="wujia-mhist-kv-value"
                              t-out="wj_dt(rr.request_date, '%d/%m/%Y') or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Unboxing time</span>
                        <span class="wujia-mhist-kv-value"
                              t-out="wj_dt(rr.opening_datetime, '%d/%m/%Y %H:%M') or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Original order</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.sale_order_id.name or '—'"/>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Requested product</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Product</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.product_id.display_name or '—'"/>
                    </div>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Requested qty</span>
                        <span class="wujia-mhist-kv-value">
                            <t t-out="'{:,.2f}'.format(rr.request_qty or 0)"/> <t t-out="rr.request_uom_id.name or ''"/>
                        </span>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card" t-if="comp">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Resolution &amp; compensation progress</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Outcome</span>
                        <span class="wujia-mhist-kv-value">
                            <span class="wujia-badge wujia-badge-info" t-out="comp['resolution_label']"/>
                        </span>
                    </div>
                    <t t-if="comp['is_compensation']">
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Compensation product</span>
                            <span class="wujia-mhist-kv-value" t-out="comp['product_label']"/>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Approved compensation qty</span>
                            <span class="wujia-mhist-kv-value">
                                <t t-out="'{:,.2f}'.format(comp['approved_qty'])"/> <t t-out="comp['approved_uom']"/>
                            </span>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Added to compensation orders</span>
                            <span class="wujia-mhist-kv-value">
                                <t t-out="'{:,.2f}'.format(comp['allocated_qty'])"/> <t t-out="comp['approved_uom']"/>
                            </span>
                        </div>
                        <div class="wujia-mhist-kv">
                            <span class="wujia-mhist-kv-label">Compensation status</span>
                            <span class="wujia-mhist-kv-value">
                                <span t-attf-class="wj-status-badge #{comp['status'][1]}" t-out="comp['status'][0]"/>
                            </span>
                        </div>
                        <p t-if="comp['all_cancelled']" class="wujia-mticket-hint">
                            The compensation order was cancelled. If you still need compensation, please create a new request.
                        </p>
                        <div class="wujia-mreturn-progress-wrap">
                            <div class="wujia-mreturn-progress-meta">
                                <span>Compensated <t t-out="'{:,.2f}'.format(comp['compensated_qty'])"/></span>
                                <span>Still short <t t-out="'{:,.2f}'.format(comp['remaining_qty'])"/></span>
                            </div>
                            <div class="progress wujia-return-progress">
                                <div class="progress-bar" t-attf-style="width: #{comp['progress_pct']}%;"/>
                            </div>
                        </div>
                        <div t-if="comp['orders']" class="wujia-mreturn-so-list">
                            <div t-foreach="comp['orders']" t-as="o" class="wujia-mreturn-so-row">
                                <span class="wujia-mreturn-so-name" t-out="o['name']"/>
                                <span class="wujia-mreturn-so-deliv" t-out="o['delivery_label']"/>
                            </div>
                        </div>
                    </t>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Issue details</t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mhist-kv">
                        <span class="wujia-mhist-kv-label">Issue type</span>
                        <span class="wujia-mhist-kv-value" t-out="rr.issue_type_id.name or '—'"/>
                    </div>
                    <t t-set="_ret_t_no_note">No notes.</t>
                    <p class="wujia-mhist-note" t-out="rr.note or _ret_t_no_note"/>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card" t-if="rr.image_attachment_ids">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title"><t t-out="len(rr.image_attachment_ids)"/> <t t-if="len(rr.image_attachment_ids) == 1">attached photo</t><t t-else="">attached photos</t></t>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <div class="wujia-mreturn-thumbs">
                        <a t-foreach="rr.image_attachment_ids" t-as="img" target="_blank"
                           t-attf-href="/portal/return/#{rr.id}/attachment/#{img.id}">
                            <img loading="lazy" t-att-alt="img.name"
                                 t-attf-src="/portal/return/#{rr.id}/attachment/#{img.id}"/>
                        </a>
                    </div>
                </t>

                <t t-call="wujia_portal_layout.wj_surface_card">
                    <t t-set="sc_variant" t-value="'section'"/>
                    <t t-set="sc_class" t-value="'wujia-mdash-card wujia-mreturn-response'"/>
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="wj_txt">{brand} feedback</t>
                        <t t-set="ch_title" t-value="wj_txt.replace('{brand}', wj_brand['name'])"/>
                        <t t-set="ch_platform" t-value="'m'"/>
                    </t>
                    <p t-if="rr.reject_reason" class="wujia-mreturn-resp-body" t-out="rr.reject_reason"/>
                    <p t-elif="comp and comp.get('approval_note')" class="wujia-mreturn-resp-body" t-out="comp['approval_note']"/>
                    <p t-else="" class="wujia-mhist-note"><t t-set="wj_txt">No feedback from {brand} yet.</t><t t-out="wj_txt.replace('{brand}', wj_brand['name'])"/></p>
                </t>
            </div>
        </t>
    </template>

</odoo>
