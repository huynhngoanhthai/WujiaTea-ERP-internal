<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- /portal/franchises/<id>/profile — full info + status + contract -->
    <template id="portal_franchise_profile_full" name="Wujia Portal — Franchise Profile">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title" t-value="franchise.name"/>
            <div class="content-wrapper">
                <!-- Header chung wj_page_header thay h2 Vuexy: tiêu đề 30/800 + MỘT nút back
                     (UI-PC-BASE-002/006/007), thay nút "Quay lại" cũ ở cuối trang. -->
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Store information / Store profile</t>
                    <t t-set="_fp_t_title">Store profile</t>
                    <t t-set="ph_title" t-value="_fp_t_title + ' — ' + franchise.name"/>
                    <t t-set="ph_back_url" t-value="'/portal/franchises/%s' % franchise.id"/>
                </t>
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Store profile</t>
                    <t t-set="ph_back_url" t-value="'/portal/franchises/%s' % franchise.id"/>
                </t>

                <div class="content-body">
                    <div class="row">
                        <!-- Định danh + Trạng thái -->
                        <div class="col-lg-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Identification</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <dl class="row mb-0 profile-dl">
                                        <dt class="col-sm-4">Code</dt>
                                        <dd class="col-sm-8" t-out="franchise.code or '—'"/>
                                        <dt class="col-sm-4">Name</dt>
                                        <dd class="col-sm-8" t-out="franchise.name or '—'"/>
                                        <dt class="col-sm-4">Status</dt>
                                        <dd class="col-sm-8">
                                            <span t-attf-class="wj-status-badge #{franchise.status == 'active' and 'wj-status-badge--success' or (franchise.status == 'draft' and 'wj-status-badge--neutral' or 'wj-status-badge--danger')}"
                                                  t-out="status_labels.get(franchise.status, franchise.status)"/>
                                            <span t-if="franchise.portal_locked" class="wj-status-badge wj-status-badge--danger ms-1">
                                                <i class="fa fa-lock me-1"/>Portal access locked
                                            </span>
                                        </dd>
                                        <dt class="col-sm-4">Opening date</dt>
                                        <dd class="col-sm-8" t-out="franchise.opening_date and franchise.opening_date.strftime('%d/%m/%Y') or '—'"/>
                                        <dt class="col-sm-4">Area</dt>
                                        <dd class="col-sm-8" t-out="franchise.area_id.name or '—'"/>
                                        <dt class="col-sm-4">My role</dt>
                                        <dd class="col-sm-8">
                                            <strong t-out="role_labels.get(membership.role, membership.role)"/>
                                            <span t-if="membership.is_primary_owner" class="badge bg-warning text-dark ms-1">Main owner</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Liên hệ -->
                        <div class="col-lg-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Contact</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <dl class="row mb-0 profile-dl">
                                        <dt class="col-sm-4">Address</dt>
                                        <dd class="col-sm-8" t-out="franchise.address or '—'"/>
                                        <dt class="col-sm-4">Province/City</dt>
                                        <dd class="col-sm-8" t-out="franchise.state_id.name or '—'"/>
                                        <dt class="col-sm-4">Telephone</dt>
                                        <dd class="col-sm-8" t-out="franchise.phone or '—'"/>
                                        <dt class="col-sm-4">Email</dt>
                                        <dd class="col-sm-8" t-out="franchise.email or '—'"/>
                                        <dt class="col-sm-4">Representative</dt>
                                        <dd class="col-sm-8">
                                            <t t-if="franchise.main_owner_member_id">
                                                <t t-out="franchise.main_owner_member_id.user_id.name"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Hợp đồng -->
                        <div class="col-lg-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Franchise contract</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <dl class="row mb-0 profile-dl">
                                        <dt class="col-sm-5">Starts</dt>
                                        <dd class="col-sm-7" t-out="franchise.franchise_start_date and franchise.franchise_start_date.strftime('%d/%m/%Y') or '—'"/>
                                        <dt class="col-sm-5">Ends</dt>
                                        <dd class="col-sm-7" t-out="franchise.franchise_end_date and franchise.franchise_end_date.strftime('%d/%m/%Y') or '—'"/>
                                        <dt class="col-sm-5">Remaining</dt>
                                        <dd class="col-sm-7">
                                            <t t-set="_fp_days" t-value="franchise._portal_contract_days()"/>
                                            <t t-if="_fp_days[0] is None">—</t>
                                            <t t-elif="_fp_days[1]">
                                                <span class="wj-status-badge wj-status-badge--danger">Has expired</span>
                                            </t>
                                            <t t-elif="0 &lt; _fp_days[0] &lt;= 30">
                                                <span class="wj-status-badge wj-status-badge--pending"><t t-out="_fp_days[0]"/> days (expiring soon)</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted"><t t-out="_fp_days[0]"/> days</span>
                                            </t>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Yêu cầu cập nhật (placeholder cho Phase 2) -->
                        <div class="col-lg-6 col-12 mb-2">
                            <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush h-100">
                                <div class="wj-surface-card__head">
                                    <t t-call="wujia_portal_layout.wj_card_header">
                                        <t t-set="ch_title">Request an information update</t>
                                        <t t-set="ch_level" t-value="4"/>
                                        <t t-set="ch_class" t-value="'wj-card-header--flush'"/>
                                    </t>
                                </div>
                                <div class="wj-surface-card__body">
                                    <p class="text-muted">
                                        To update store information (address, phone, documents...), please
                                        <a href="/portal/support/new">submit a support request</a> with the details to change. An administrator will approve it before it takes effect.
                                    </p>
                                    <a href="/portal/support/new" class="wj-btn wj-btn--primary">
                                        <i class="fa fa-paper-plane me-1"/>Submit request
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nút "Quay lại" cuối trang đã gỡ: back nay ở page header (UI-PC-BASE-006). -->
                </div>
            </div>
        </t>
    </template>

</odoo>
