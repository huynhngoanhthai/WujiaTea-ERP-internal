<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CMP-SN-001 — mục sidebar PC do CHÍNH module sở hữu route khai; khung
         (wujia_portal_layout) chỉ giữ 3 tiêu đề nhóm + neo `nav_end`. Gỡ module này ⇒ mục biến mất. -->
    <template id="layout_sidenav_home"
              inherit_id="wujia_portal_layout.layout_sidenav"
              priority="10"
              name="Wujia Sidenav — Home">
        <xpath expr="//li[@id='nav_header_finance']" position="before">
            <t t-set="ni_active" t-value="_p == '/portal'"/>
            <li t-attf-class="nav-item #{ni_active and 'active' or ''}" id="nav_item_home">
                <t t-call="wujia_portal_layout.wj_nav_item">
                    <t t-set="ni_href" t-value="'/portal'"/>
                    <t t-set="ni_icon" t-value="'feather icon-home'"/>
                    <t t-set="ni_label">Home</t>
                </t>
            </li>
        </xpath>
    </template>

</odoo>
