<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Store picker overlay — luôn render trong DOM cho user multi-franchise.
         must_pick=True: hiện ngay. must_pick=False: ẩn, click badge top navbar
         JS toggle class wujia-store-overlay (suffix show) để mở. -->
    <template id="store_picker_modal" name="Wujia Portal — Store Picker Modal">
        <div t-if="_wujia_accessible_ids and len(_wujia_accessible_ids) &gt; 1"
             t-attf-class="wujia-store-overlay#{' wujia-store-overlay--show' if _wujia_must_pick else ''}"
             id="wujiaStoreOverlay">
            <!-- WJ-PORTAL-UI-005: hộp là dialog modal có tên (tiêu đề) + mô tả (câu dẫn);
                 focus/Tab/Esc/inert nền do store_picker.js quản lý. -->
            <div class="wujia-store-card" role="dialog" aria-modal="true"
                 aria-labelledby="wujiaStoreTitle" aria-describedby="wujiaStoreIntro">
                <div class="wujia-store-header">
                    <span id="wujiaStoreTitle">
                        <i class="fa fa-building me-1" aria-hidden="true"/>
                        <t t-if="_wujia_must_pick">Select the store to work on</t>
                        <t t-else="">Switch the store you work on</t>
                    </span>
                    <!-- Nút đóng chỉ hiện khi user đã pick (không bắt buộc) -->
                    <button t-if="not _wujia_must_pick" type="button"
                            class="wj-iconbtn wj-iconbtn--ghost wj-iconbtn--sm wujia-store-close"
                            data-action="close-store-picker"
                            aria-label="Close" title="Close"><i class="feather icon-x"/></button>
                </div>
                <form action="/portal/franchise/switch" method="POST"
                      class="wujia-store-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-att-value="request.httprequest.full_path or '/portal'"/>
                    <div class="wujia-store-body">
                        <p class="wujia-store-intro" id="wujiaStoreIntro">
                            <t t-if="_wujia_must_pick">
                                You belong to several stores. Please select the store to work on so that only its data (orders, returns, notifications) is shown.
                            </t>
                            <t t-else="">
                                You are working at
                                <strong t-out="_wujia_active_franchise.name if _wujia_active_franchise else ''"/>. Select another store to switch the data shown.
                            </t>
                        </p>
                        <div class="wujia-store-list">
                            <t t-foreach="all_accessible_franchises" t-as="f">
                                <label t-attf-class="wujia-store-item#{' wujia-store-item--active' if f.id == _wujia_active_fid else ''}">
                                    <input type="radio" name="franchise_id"
                                           t-att-value="f.id"
                                           t-att-checked="'checked' if f.id == _wujia_active_fid else None"
                                           required="required"
                                           class="wujia-store-radio"/>
                                    <span class="wujia-store-info">
                                        <strong t-out="f.name"/>
                                        <small t-if="f.code" class="wujia-store-code">
                                            (<t t-out="f.code"/>)
                                        </small>
                                        <small t-if="f.address" class="wujia-store-addr"
                                               t-out="f.address"/>
                                    </span>
                                    <span t-if="f.id == _wujia_active_fid"
                                          class="wujia-store-current-badge">current</span>
                                </label>
                            </t>
                        </div>
                    </div>
                    <div class="wujia-store-footer">
                        <button t-if="not _wujia_must_pick" type="button"
                                class="wj-btn wj-btn--secondary me-2"
                                data-action="close-store-picker">Cancel</button>
                        <button type="submit" class="wj-btn wj-btn--primary">
                            <i class="fa fa-check me-1" aria-hidden="true"/>
                            <t t-if="_wujia_must_pick">Confirm</t>
                            <t t-else="">Switch store</t>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- CSS inline — đảm bảo render bất kể asset bundle status. -->
        <style t-if="_wujia_accessible_ids and len(_wujia_accessible_ids) &gt; 1">
            .wujia-store-overlay {
                position: fixed !important; top: 0 !important; left: 0 !important;
                width: 100% !important; height: 100% !important;
                background: rgba(0, 0, 0, 0.55) !important;
                z-index: 99999 !important;
                display: none !important;
                align-items: center !important; justify-content: center !important;
                padding: 20px;
            }
            .wujia-store-overlay.wujia-store-overlay--show { display: flex !important; }
            .wujia-store-card {
                background: #fff; border-radius: 12px; max-width: 560px;
                width: 100%; max-height: 90vh; overflow-y: auto;
                box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                font-family: inherit;
            }
            .wujia-store-header {
                background: var(--wujia-primary); color: #fff; padding: 14px 20px;
                font-size: 1.05rem; font-weight: 600;
                border-radius: 12px 12px 0 0;
                display: flex; align-items: center; justify-content: space-between;
            }
            /* Context hook: the × button sits on the primary header ⇒ only COLOR changes,
               shape (32×32, radius 8) comes from the `wj-iconbtn` atom. */
            .wujia-store-close { color: #fff; opacity: 0.85; }
            .wujia-store-close:hover { color: #fff; opacity: 1; background: rgba(255, 255, 255, 0.16); }
            .wujia-store-body { padding: 20px; }
            .wujia-store-intro { color: var(--wujia-text-secondary); margin-bottom: 16px; line-height: 1.5; }
            .wujia-store-list { display: flex; flex-direction: column; gap: 8px; }
            .wujia-store-item {
                display: flex; align-items: center; gap: 12px;
                padding: 12px 14px; border: 1px solid var(--wujia-border);
                border-radius: 8px; cursor: pointer; margin: 0;
                transition: all 0.15s ease;
            }
            .wujia-store-item:hover { background: var(--wujia-bg-page); border-color: var(--wujia-primary); }
            .wujia-store-item--active,
            .wujia-store-item:has(.wujia-store-radio:checked) {
                background: var(--wujia-primary-light); border-color: var(--wujia-primary); border-width: 2px;
            }
            .wujia-store-radio { margin: 0; cursor: pointer; }
            .wujia-store-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
            .wujia-store-info strong { font-size: 1rem; color: var(--wujia-text-primary); }
            .wujia-store-code { color: var(--wujia-text-secondary); }
            .wujia-store-addr { color: var(--wujia-text-secondary); font-size: 0.85rem; }
            .wujia-store-current-badge {
                background: var(--wujia-success); color: #fff;
                font-size: 0.75rem; padding: 3px 8px; border-radius: 12px;
            }
            .wujia-store-footer {
                padding: 14px 20px; text-align: right;
                border-top: 1px solid var(--wujia-border);
            }
        </style>
    </template>

</odoo>
