<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_info_request_list" name="Wujia Portal — Info Request List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_gutter" t-value="'list'"/>
            <t t-set="title">Information update requests</t>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/info-request'"/>
                <t t-set="wjl_slots" t-value="'wj-inf-body'"/>
            </t>
            <div class="content-wrapper">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Information update requests</t>
                    <t t-set="ph_create_url" t-value="'/portal/info-request/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Update information</t>
                    <t t-set="ph_create_url" t-value="'/portal/info-request/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>

                <t t-if="no_franchise" t-call="wujia_portal_base.wj_store_scope_prompt">
                    <t t-set="sp_scope" t-value="store_scope"/>
                </t>

                <div t-if="not no_franchise" class="content-body">
                    <!-- Màn này KHÔNG tách PC/mobile ⇒ thanh lọc phải hợp cả hai khổ. -->
                    <t t-set="_inf_t_status">Status</t>
                    <t t-set="_inf_t_all_status">All statuses</t>
                    <t t-set="_inf_t_type">Information type</t>
                    <t t-set="_inf_t_all_type">All information types</t>
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'pc'"/>
                        <t t-set="fb_action" t-value="'/portal/info-request'"/>
                        <t t-set="fb_selects"
                           t-value="[{'name': 'state', 'value': state,
                                      'label': _inf_t_status,
                                      'all_label': _inf_t_all_status,
                                      'options': [(kv[0], kv[1][0]) for kv in state_labels.items()]},
                                     {'name': 'request_type', 'value': request_type,
                                      'label': _inf_t_type,
                                      'all_label': _inf_t_all_type,
                                      'options': request_type_options}]"/>
                    </t>

                    <!-- Vùng swap AJAX: bảng + pager (bộ lọc ngoài, JS đồng bộ theo URL). -->
                    <div id="wj-inf-body">
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_density" t-value="'regular'"/>
                        <t t-set="sc_class" t-value="'wujia-content-card'"/>
                    <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Request list</t>
                        <t t-set="ch_level" t-value="4"/>
                        <!-- Màn này KHÔNG tách PC/mobile (không có d-none d-lg-*) nên
                             KHÔNG bake ch_platform: 'pc' sẽ nuốt mất tiêu đề ở mobile. -->
                        <t t-set="ch_icon" t-value="'edit'"/>
                        <t t-set="ch_meta">
                            <span class="wj-card-header__meta"><t t-set="_n" t-value="len(requests)"/><t t-out="_n"/> <t t-if="_n == 1">result</t><t t-else="">results</t></span>
                        </t>
                    </t>
                    <t t-call="wujia_portal_layout.wj_data_list">
                        <t t-set="dl_table_class" t-value="'wujia-content-card-table'"/>
                        <t t-set="dl_bleed" t-value="True"/>
                        <t t-set="dl_empty" t-value="not requests"/>
                        <t t-set="dl_state">
                            <div class="wujia-empty-state">
                                <i class="feather icon-edit"/>
                                <p>No requests yet. <a href="/portal/info-request/new">Create the first request</a>.</p>
                            </div>
                        </t>
                            <thead>
                                <tr>
                                    <th scope="col">Code</th>
                                    <th scope="col">Created on</th>
                                    <th scope="col">Store</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">New value</th>
                                    <th scope="col">Severity</th>
                                    <th scope="col" class="text-center">Status</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="requests" t-as="rec">
                                    <td><a t-attf-href="/portal/info-request/#{rec.id}" t-out="rec.name"/></td>
                                    <td t-out="rec.request_date and rec.request_date.strftime('%d/%m/%Y %H:%M') or ''"/>
                                    <td t-out="rec.franchise_id.name or '—'"/>
                                    <td t-out="dict(request_type_options).get(rec.request_type, '—')"/>
                                    <td class="text-truncate" style="max-width: 200px;" t-att-title="rec.new_value or ''" t-out="rec.new_value or '—'"/>
                                    <td>
                                        <span t-if="rec.priority == 'urgent'" class="wujia-badge wujia-badge-danger">Urgent</span>
                                        <span t-else="" class="wujia-badge wujia-badge-muted">Normal</span>
                                    </td>
                                    <td class="text-center">
                                        <t t-set="lbl" t-value="state_labels.get(rec.state, (rec.state, 'wj-status-badge--neutral'))"/>
                                        <span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/>
                                    </td>
                                    <td class="text-end">
                                        <a t-attf-href="/portal/info-request/#{rec.id}"
                                           class="wj-iconbtn wj-iconbtn--secondary wj-iconbtn--sm"
                                           aria-label="View request details" title="View request details">
                                            <i class="fa fa-eye"/>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                    </t>
                    </t>

                    <t t-call="wujia_portal_layout.wj_pagination"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
