<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_info_request_detail" name="Wujia Portal — Info Request Detail">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'standard'"/>
            <t t-set="title">Request details</t>
            <div class="content-wrapper">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Information update requests / Request details</t>
                    <t t-set="ph_title" t-value="rec.name"/>
                    <t t-set="ph_back_url" t-value="'/portal/info-request'"/>
                </t>
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Request details</t>
                    <t t-set="ph_back_url" t-value="'/portal/info-request'"/>
                </t>
                <!-- Status badge dời khỏi header (spec title-only) → block riêng dưới header -->
                <t t-set="lbl" t-value="state_labels.get(rec.state, (rec.state, 'state-draft'))"/>
                <div class="mb-2"><span t-attf-class="wj-status-badge #{lbl[1]}" t-out="lbl[0]"/></div>

                <div t-if="message" class="alert alert-info m-3">
                    <t t-if="message == 'created'">Request created.</t>
                    <t t-elif="message == 'cancelled'">The request has been cancelled.</t>
                    <t t-else=""><t t-out="message"/></t>
                </div>

                <div class="content-body">
                    <div class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush">
                        <div class="wj-surface-card__body">
                            <div class="row g-2">
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Store</label>
                                    <div class="fw-bold" t-out="rec.franchise_id.name or '—'"/>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Information type</label>
                                    <div class="fw-bold">
                                        <t t-set="rt_opt" t-value="request_type_labels.get(rec.request_type, '—')"/>
                                        <t t-out="rt_opt"/>
                                        <span t-if="rec.field_target" class="text-muted ms-1">
                                            (<t t-out="rec.field_target"/>)
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Created by</label>
                                    <div t-out="rec.created_by_user_id.name or '—'"/>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Severity</label>
                                    <div>
                                        <span t-if="rec.priority == 'urgent'" class="wujia-badge wujia-badge-danger">Urgent</span>
                                        <span t-else="" class="wujia-badge wujia-badge-muted">Normal</span>
                                    </div>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Created on</label>
                                    <div t-out="rec.request_date and rec.request_date.strftime('%d/%m/%Y %H:%M') or '—'"/>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="small text-muted">Sent on</label>
                                    <div t-out="rec.submitted_date and rec.submitted_date.strftime('%d/%m/%Y %H:%M') or '—'"/>
                                </div>

                                <div class="col-12">
                                    <label class="small text-muted">Old value</label>
                                    <pre class="form-control bg-light mb-0" style="white-space: pre-wrap;"
                                         t-out="rec.old_value or '—'"/>
                                </div>
                                <div class="col-12">
                                    <label class="small text-muted">New value</label>
                                    <pre class="form-control mb-0" style="white-space: pre-wrap;"
                                         t-out="rec.new_value or '—'"/>
                                </div>
                                <div class="col-12" t-if="rec.note">
                                    <label class="small text-muted">Note</label>
                                    <pre class="form-control bg-light mb-0" style="white-space: pre-wrap;"
                                         t-out="rec.note"/>
                                </div>

                                <div class="col-12" t-if="rec.attachment_ids">
                                    <label class="small text-muted">Evidence</label>
                                    <ul class="list-unstyled mb-0">
                                        <li t-foreach="rec.attachment_ids" t-as="att">
                                            <a t-attf-href="/portal/info-request/#{rec.id}/attachment/#{att.id}"
                                               class="text-decoration-none">
                                                <i class="fa fa-paperclip me-1"/>
                                                <t t-out="att.name"/>
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                                <div class="col-12" t-if="rec.state == 'rejected' and rec.refuse_reason">
                                    <label class="small text-muted">Rejection reason</label>
                                    <pre class="form-control bg-light text-danger mb-0"
                                         style="white-space: pre-wrap;"
                                         t-out="rec.refuse_reason"/>
                                </div>
                                <div class="col-12" t-if="rec.state == 'approved' and rec.reviewer_id">
                                    <label class="small text-muted">Reviewer</label>
                                    <div>
                                        <t t-out="rec.reviewer_id.name"/>
                                        <span class="text-muted ms-2" t-if="rec.reviewed_date">
                                            (<t t-out="rec.reviewed_date.strftime('%d/%m/%Y %H:%M')"/>)
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Nút "Quay lại" ở footer đã gỡ: chỉ MỘT nút back / màn, nằm ở
                             page header (UI-PC-BASE-006). Block này dùng chung PC+mobile
                             nên bản điện thoại cũng bớt 1 nút back trùng. -->
                        <div class="wj-surface-card__foot text-end">
                            <t t-set="_inf_t_confirm">Withdraw this request?</t>
                            <form t-if="rec.state in ('draft', 'submitted') and rec.created_by_user_id.id == request.env.uid"
                                  method="post"
                                  t-attf-action="/portal/info-request/#{rec.id}/cancel"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="wj-btn wj-btn--danger"
                                        t-att-data-wj-msg-confirm="_inf_t_confirm"
                                        onclick="return confirm(this.getAttribute('data-wj-msg-confirm'));">
                                    <i class="fa fa-times me-1"/>Withdraw request
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
