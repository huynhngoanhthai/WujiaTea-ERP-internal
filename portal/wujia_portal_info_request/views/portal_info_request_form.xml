<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_info_request_form" name="Wujia Portal — Info Request Form">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="pc_width" t-value="'narrow'"/>
            <t t-set="title">Create information update request</t>
            <div class="content-wrapper">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_crumb">Information update requests / Create request</t>
                    <t t-set="ph_title">Create information update request</t>
                    <t t-set="ph_back_url" t-value="'/portal/info-request'"/>
                </t>
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'back'"/>
                    <t t-set="ph_title">Create request</t>
                    <t t-set="ph_back_url" t-value="'/portal/info-request'"/>
                </t>

                <div class="content-body">
                    <div t-if="error" class="alert alert-danger" role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/> <t t-out="error"/>
                    </div>

                    <form method="post" action="/portal/info-request/new"
                          enctype="multipart/form-data" class="wj-surface-card wj-surface-card--section wj-surface-card--compact wj-surface-card--flush wj-mform" id="info-request-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="wj-surface-card__body">
                            <div class="row g-2">
                                <div class="col-md-6 col-12">
                                    <label class="form-label" for="info-franchise-id">Store <span class="text-danger">*</span></label>
                                    <select name="franchise_id" id="info-franchise-id"
                                            class="form-select" required="required">
                                        <option value="">— Select store —</option>
                                        <t t-foreach="franchises" t-as="f">
                                            <option t-att-value="f.id"
                                                    t-att-selected="'selected' if str(values.get('franchise_id')) == str(f.id) else None"
                                                    t-out="f.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="form-label" for="info-request-type">Information type <span class="text-danger">*</span></label>
                                    <select name="request_type" id="info-request-type"
                                            class="form-select" required="required">
                                        <option value="">— Select type —</option>
                                        <t t-foreach="request_type_options" t-as="rt">
                                            <option t-att-value="rt[0]"
                                                    t-att-selected="'selected' if values.get('request_type') == rt[0] else None"
                                                    t-out="rt[1]"/>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6 col-12" id="info-field-target-wrap"
                                     t-att-style="'' if values.get('request_type') == 'other' else 'display:none;'">
                                    <label class="form-label" for="info-field-target">Technical field name (when "Other" is selected)</label>
                                    <input type="text" name="field_target" id="info-field-target"
                                           class="form-control"
                                           placeholder="e.g. tax_code, website, ..."
                                           t-att-value="values.get('field_target') or ''"/>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label class="form-label" for="info-priority">Severity</label>
                                    <select id="info-priority" name="priority" class="form-select">
                                        <option value="normal"
                                                t-att-selected="'selected' if values.get('priority', 'normal') == 'normal' else None">
                                            Normal
                                        </option>
                                        <option value="urgent"
                                                t-att-selected="'selected' if values.get('priority') == 'urgent' else None">
                                            Urgent
                                        </option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="info-old-value">Current value</label>
                                    <textarea id="info-old-value" rows="2"
                                              class="form-control bg-light"
                                              readonly="readonly"
                                              placeholder="Select a store and information type to see the current value..."/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="info-new-value">New value <span class="text-danger">*</span></label>
                                    <textarea id="info-new-value" name="new_value" rows="3" class="form-control"
                                              required="required"
                                              placeholder="Enter the new value to update..."
                                              t-out="values.get('new_value') or ''"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="info-note">Note</label>
                                    <textarea id="info-note" name="note" rows="3" class="form-control"
                                              placeholder="Reason or extra context for HQ review..."
                                              t-out="values.get('note') or ''"/>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="info-attachments">Evidence (optional)</label>
                                    <input type="file" id="info-attachments" name="attachments" class="form-control"
                                           multiple="multiple"/>
                                    <small class="text-muted">PDF / JPG / PNG, up to 5MB per file, up to 6 files.</small>
                                </div>
                            </div>
                        </div>
                        <div class="wj-surface-card__foot text-end">
                            <a href="/portal/info-request" class="wj-btn wj-btn--secondary me-2">Cancel</a>
                            <button type="submit" name="action" value="draft"
                                    class="wj-btn wj-btn--outline me-2">Save draft</button>
                            <button type="submit" name="action" value="submit" class="wj-btn wj-btn--primary">
                                <i class="fa fa-paper-plane me-1"/>Submit request
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <script type="text/javascript">
            //<![CDATA[
            (function () {
                function onChange() {
                    var fid = document.getElementById('info-franchise-id').value;
                    var rt = document.getElementById('info-request-type').value;
                    var ft = (document.getElementById('info-field-target') || {value: ''}).value;
                    var oldBox = document.getElementById('info-old-value');
                    var wrap = document.getElementById('info-field-target-wrap');
                    if (wrap) {
                        wrap.style.display = (rt === 'other') ? '' : 'none';
                    }
                    if (!fid || !rt) {
                        oldBox.value = '';
                        return;
                    }
                    var body = JSON.stringify({
                        jsonrpc: '2.0',
                        method: 'call',
                        params: {request_type: rt, field_target: ft},
                    });
                    fetch('/portal/info-request/franchise/' + fid + '/values', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: body,
                    }).then(function (r) {
                        return r.json();
                    }).then(function (j) {
                        // nested ifs on purpose: QWeb escapes boolean operators inside inline scripts
                        var v = '';
                        if (j) {
                            if (j.result) {
                                v = j.result.old_value || '';
                            }
                        }
                        oldBox.value = v;
                    }).catch(function () {
                        oldBox.value = '';
                    });
                }
                document.addEventListener('DOMContentLoaded', function () {
                    var fr = document.getElementById('info-franchise-id');
                    var rt = document.getElementById('info-request-type');
                    var ft = document.getElementById('info-field-target');
                    if (fr) fr.addEventListener('change', onChange);
                    if (rt) rt.addEventListener('change', onChange);
                    if (ft) ft.addEventListener('change', onChange);
                    onChange();
                });
            })();
            //]]>
            </script>
        </t>
    </template>

</odoo>
