<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone Mobile Kanban View for Info Update Requests -->
    <record id="view_wujia_info_update_request_kanban" model="ir.ui.view">
        <field name="name">wujia.info.update.request.kanban</field>
        <field name="model">wujia.info.update.request</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name"/>
                <field name="franchise_id"/>
                <field name="request_type"/>
                <field name="new_value"/>
                <field name="priority"/>
                <field name="request_date"/>
                <field name="created_by_user_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Request Code + State Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="name"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.state.raw_value == 'approved' and 'wj_mobile_badge--success' or
                                    record.state.raw_value == 'submitted' and 'wj_mobile_badge--warning' or
                                    record.state.raw_value == 'reviewing' and 'wj_mobile_badge--info' or
                                    record.state.raw_value == 'rejected' and 'wj_mobile_badge--danger' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <field name="state"/>
                                </span>
                            </div>

                            <!-- Row 2: Title (Store Name) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="franchise_id"/>
                            </div>

                            <!-- Row 3: Request Type & Urgent Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__meta text-nowrap text-muted">
                                    <i class="fa fa-tag me-1" title="Request Type"/>
                                    <field name="request_type"/>
                                </span>
                                <t t-if="record.priority.raw_value == 'urgent'">
                                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-0 small">
                                        <i class="fa fa-bolt me-1" title="Priority"/>
                                        <field name="priority"/>
                                    </span>
                                </t>
                            </div>

                            <!-- Row 4: Request Date + Created By User -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-calendar me-1" title="Request Date"/>
                                    <field name="request_date" widget="date"/>
                                </span>
                                <span class="wj_mobile_card__subvalue text-nowrap">
                                    <i class="fa fa-user me-1" title="Created By"/>
                                    <field name="created_by_user_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode Configuration on Window Action -->
    <record id="wujia_info_request.action_wujia_info_update_request" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_info_request.view_wujia_info_update_request_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_info_update_request_kanban'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_info_request.view_wujia_info_update_request_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
