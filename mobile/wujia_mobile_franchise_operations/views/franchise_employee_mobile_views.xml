<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Franchise Employees -->
    <record id="view_wujia_franchise_employee_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.franchise.employee.kanban.mobile</field>
        <field name="model">wujia.franchise.employee</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="primary_franchise_id"/>
                <field name="active"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Code + Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.active.raw_value and 'wj_mobile_badge--success' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <t t-if="record.active.raw_value">Active</t>
                                    <t t-else="">Archived</t>
                                </span>
                            </div>

                            <!-- Row 2: Title (Name) + Avatar -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="wj_mobile_card__title mb-0">
                                    <field name="name"/>
                                </div>
                                <t t-if="record.image_1920.raw_value">
                                    <field name="image_1920" widget="image" class="rounded-circle ms-2"
                                           options="{'size': [32, 32]}"/>
                                </t>
                            </div>

                            <!-- Row 3: Phone & Email -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-phone me-1" title="Phone"/>
                                    <field name="phone"/>
                                </span>
                                <span class="wj_mobile_card__meta text-nowrap text-muted">
                                    <i class="fa fa-envelope-o me-1" title="Email"/>
                                    <field name="email"/>
                                </span>
                            </div>

                            <!-- Row 4: Primary Store -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap text-truncate">
                                    <i class="fa fa-map-marker me-1" title="Primary Store"/>
                                    <field name="primary_franchise_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_franchise_operations.action_wujia_franchise_employee" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_employee_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_franchise_employee_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_employee_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
