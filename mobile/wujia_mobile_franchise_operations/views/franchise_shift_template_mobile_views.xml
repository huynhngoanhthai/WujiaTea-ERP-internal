<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Shift Templates -->
    <record id="view_wujia_franchise_shift_template_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.franchise.shift.template.kanban.mobile</field>
        <field name="model">wujia.franchise.shift.template</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="franchise_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="planned_hours"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Code + Scope Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.franchise_id.raw_value and 'wj_mobile_badge--info' or
                                    'wj_mobile_badge--success'
                                }">
                                    <t t-if="record.franchise_id.raw_value">Store Specific</t>
                                    <t t-else="">Global</t>
                                </span>
                            </div>

                            <!-- Row 2: Title (Shift Name) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="name"/>
                            </div>

                            <!-- Row 3: Working Hours -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-clock-o me-1" title="Working Hours"/>
                                    <field name="start_time" widget="float_time"/> - <field name="end_time" widget="float_time"/>
                                </span>
                            </div>

                            <!-- Row 4: Store Scope + Duration -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap text-truncate me-2">
                                    <t t-if="record.franchise_id.raw_value">
                                        <i class="fa fa-map-marker me-1" title="Store"/>
                                        <field name="franchise_id"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-globe me-1" title="Scope"/> All Stores
                                    </t>
                                </span>
                                <div class="text-end text-nowrap ms-2">
                                    <span class="wj_mobile_card__subvalue text-nowrap">
                                        <field name="planned_hours"/> hrs
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_franchise_operations.action_wujia_franchise_shift_template" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_shift_template_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_franchise_shift_template_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_shift_template_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
