<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Store Assignments -->
    <record id="view_wujia_franchise_employee_assignment_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.franchise.employee.assignment.kanban.mobile</field>
        <field name="model">wujia.franchise.employee.assignment</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="employee_id"/>
                <field name="franchise_id"/>
                <field name="job_position"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="is_primary"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Employee Name + Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="employee_id"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.state.raw_value == 'working' and 'wj_mobile_badge--success' or
                                    record.state.raw_value == 'scheduled' and 'wj_mobile_badge--info' or
                                    record.state.raw_value == 'suspended' and 'wj_mobile_badge--warning' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <field name="state"/>
                                </span>
                            </div>

                            <!-- Row 2: Store + Primary Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="wj_mobile_card__title mb-0">
                                    <field name="franchise_id"/>
                                </div>
                                <t t-if="record.is_primary.raw_value">
                                    <span class="badge bg-primary-subtle text-primary small">Primary</span>
                                </t>
                            </div>

                            <!-- Row 3: Position -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__meta text-nowrap text-muted">
                                    <i class="fa fa-briefcase me-1" title="Position"/>
                                    <field name="job_position"/>
                                </span>
                            </div>

                            <!-- Row 4: Duration -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-calendar me-1" title="Duration"/>
                                    <field name="date_from" widget="date"/> - <field name="date_to" widget="date"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_franchise_operations.action_wujia_franchise_employee_assignment" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_employee_assignment_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_franchise_employee_assignment_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_franchise_operations.view_wujia_franchise_employee_assignment_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
