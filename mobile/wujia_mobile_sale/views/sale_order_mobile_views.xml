<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Sales Orders (Standard Odoo Fields) -->
    <record id="view_sale_order_kanban_wujia_mobile" model="ir.ui.view">
        <field name="name">sale.order.kanban.wujia.mobile</field>
        <field name="model">sale.order</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name" />
                <field name="partner_id" />
                <field name="date_order" />
                <field name="amount_total" />
                <field name="currency_id" />
                <field name="state" />
                <field name="mobile_badge_class" />
                <field name="mobile_card_title" />
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Top Row: Document Reference and Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="name" />
                                </span>
                                <span
                                    t-attf-class="wj_mobile_badge #{record.mobile_badge_class.raw_value or 'wj_mobile_badge--neutral'}">
                                    <field name="state" />
                                </span>
                            </div>

                            <!-- Title Row: Customer Name -->
                            <div class="wj_mobile_card__title mb-2">
                                <field name="mobile_card_title" />
                            </div>

                            <!-- Footer Row: Calendar Icon & Date on Left, Total Amount on Right -->
                            <div class="d-flex align-items-end justify-content-between pt-1">
                                <span class="wj_mobile_card__meta text-nowrap"
                                    style="white-space: nowrap !important;">
                                    <i class="fa fa-calendar-o me-1" title="Order Date" />
                                    <field name="date_order" widget="date" />
                                </span>
                                <div class="text-end text-nowrap ms-2">
                                    <span class="wj_mobile_card__value font-weight-bold"
                                        style="color: #111827;">
                                        <field name="amount_total" widget="monetary" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile Form View Enhancements for Sales Orders -->
    <record id="view_sale_order_form_wujia_mobile" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.wujia.mobile</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">35</field>
        <field name="arch" type="xml">
            <!-- Mobile Sticky Bottom Action Bar -->
            <xpath expr="//sheet" position="before">
                <div class="o_wujia_mb_sticky_actions d-mb-flex d-none">
                    <button name="action_confirm" id="action_confirm_mobile"
                        string="Confirm" class="btn btn-primary" type="object"
                        context="{'validate_analytic': True}"
                        invisible="state != 'sent'" />
                    <button name="action_confirm" id="action_confirm_mobile_draft"
                        string="Confirm" class="btn btn-primary" type="object"
                        context="{'validate_analytic': True}"
                        invisible="state != 'draft'" />
                    <button name="action_cancel" type="object" string="Cancel"
                        class="btn btn-outline-secondary"
                        invisible="state not in ['draft', 'sent', 'sale']" />
                </div>
            </xpath>

            <!-- Hide desktop sale_header on mobile devices -->
            <xpath expr="//group[@name='sale_header']" position="attributes">
                <attribute name="class" add="d-mb-none" separator=" " />
            </xpath>

            <!-- Insert mobile form section right after sale_header -->
            <xpath expr="//group[@name='sale_header']" position="after">
                <div class="d-none d-mb-block w-100 o_wujia_mobile_form">
                    <h3 class="text-center fw-bold wujia-mobile-title">Order Information</h3>
                    <div class="wujia-mobile-list">
                        <div class="wujia-mobile-row">
                            <label for="partner_id" string="Customer" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <field name="partner_id" readonly="state in ['cancel','sale']" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon">
                            <label for="partner_invoice_id" string="Invoice Address" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-file-text-o" /></span>
                                <field name="partner_invoice_id" options="{'no_quick_create': True}" readonly="state == 'cancel' or locked" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon">
                            <label for="partner_shipping_id" string="Delivery Address" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-truck" /></span>
                                <field name="partner_shipping_id" options="{'no_quick_create': True}" readonly="state == 'cancel' or locked" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon" invisible="state == 'sale'">
                            <label for="validity_date" string="Expiration" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-calendar" /></span>
                                <field name="validity_date" readonly="state in ['cancel','sale']" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon" invisible="state in ['sale','cancel']">
                            <label for="date_order" string="Quotation Date" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-calendar-o" /></span>
                                <field name="date_order" nolabel="1" readonly="state in ['cancel','sale']" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon">
                            <label for="pricelist_id" string="Pricelist" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-tags" /></span>
                                <field name="pricelist_id" options="{'no_open': True, 'no_create': True}" readonly="state in ['cancel','sale']" class="wujia-mobile-field" />
                            </div>
                        </div>
                        <div class="wujia-mobile-row has-icon">
                            <label for="payment_term_id" string="Payment Terms" class="o_form_label wujia-mobile-label" />
                            <div class="wujia-mobile-content">
                                <span class="wujia-mobile-icon"><i class="fa fa-credit-card" /></span>
                                <field name="payment_term_id" placeholder="Immediate" options="{'no_open': True, 'no_create': True}" class="wujia-mobile-field" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Update Sales Orders Window Action: Desktop defaults to List (sequence 1), Mobile auto-switches to Kanban (sequence 2) -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sale.view_order_tree'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_sale_order_kanban_wujia_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form'), 'sequence': 3})
        ]" />
    </record>

</odoo>
