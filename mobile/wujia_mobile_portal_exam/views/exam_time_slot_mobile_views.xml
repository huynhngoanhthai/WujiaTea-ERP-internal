<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Exam Time Slots -->
    <record id="view_wujia_exam_time_slot_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.exam.time.slot.kanban.mobile</field>
        <field name="model">wujia.exam.time.slot</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="time_from"/>
                <field name="time_to"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Time Slot Code + Active Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.active.raw_value and 'wj_mobile_badge--success' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <t t-if="record.active.raw_value">Active</t>
                                    <t t-else="">Archived</t>
                                </span>
                            </div>

                            <!-- Row 2: Title (Slot Name) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="name"/>
                            </div>

                            <!-- Row 3: Time Range -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-clock-o me-1" title="Time Range"/>
                                    <field name="time_from" widget="float_time"/> - <field name="time_to" widget="float_time"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_exam.action_wujia_exam_time_slot" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_exam.view_wujia_exam_time_slot_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_exam_time_slot_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_exam.view_wujia_exam_time_slot_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
