<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Exam Registrations -->
    <record id="view_wujia_exam_registration_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.exam.registration.kanban.mobile</field>
        <field name="model">wujia.exam.registration</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name"/>
                <field name="session_id"/>
                <field name="course_id"/>
                <field name="franchise_id"/>
                <field name="requester_user_id"/>
                <field name="participant_count"/>
                <field name="request_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Registration Code + Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="name"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.state.raw_value == 'confirmed' and 'wj_mobile_badge--success' or
                                    record.state.raw_value == 'submitted' and 'wj_mobile_badge--warning' or
                                    record.state.raw_value == 'rejected' and 'wj_mobile_badge--danger' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <field name="state"/>
                                </span>
                            </div>

                            <!-- Row 2: Title (Store / Franchise) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="franchise_id"/>
                            </div>

                            <!-- Row 3: Session & Request Date -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__meta text-nowrap text-truncate me-2">
                                    <i class="fa fa-graduation-cap me-1" title="Exam Session"/>
                                    <field name="session_id"/>
                                </span>
                                <span class="wj_mobile_card__meta text-nowrap text-muted">
                                    <i class="fa fa-calendar me-1" title="Request Date"/>
                                    <field name="request_date" widget="date"/>
                                </span>
                            </div>

                            <!-- Row 4: Requester + Participant Count -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap text-truncate me-2">
                                    <i class="fa fa-user me-1" title="Requester"/>
                                    <field name="requester_user_id"/>
                                </span>
                                <div class="text-end text-nowrap ms-2">
                                    <span class="wj_mobile_card__value text-primary font-weight-bold">
                                        <field name="participant_count"/> candidates
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_exam.action_wujia_exam_registration" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_exam.view_wujia_exam_registration_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_exam_registration_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_exam.view_wujia_exam_registration_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
