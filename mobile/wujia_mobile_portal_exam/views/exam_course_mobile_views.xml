<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Exam Courses -->
    <record id="view_wujia_exam_course_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.exam.course.kanban.mobile</field>
        <field name="model">wujia.exam.course</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="session_count"/>
                <field name="max_participants_per_registration"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Course Code + Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.state.raw_value == 'published' and 'wj_mobile_badge--success' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <field name="state"/>
                                </span>
                            </div>

                            <!-- Row 2: Title (Course Name) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="name"/>
                            </div>

                            <!-- Row 3: Session Count + Max Participants -->
                            <div class="d-flex align-items-end justify-content-between pt-2 border-top">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-cubes me-1" title="Sessions"/>
                                    <field name="session_count"/> sessions
                                </span>
                                <span class="wj_mobile_card__subvalue text-nowrap">
                                    Max: <field name="max_participants_per_registration"/> / reg
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dual-Device View Mode on Action Window -->
    <record id="wujia_exam.action_wujia_exam_course" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_exam.view_wujia_exam_course_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_exam_course_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_exam.view_wujia_exam_course_form'), 'sequence': 3})
        ]"/>
    </record>

</odoo>
