<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mobile Kanban View for Franchise Store Master -->
    <record id="view_wujia_franchise_management_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.franchise.management.kanban.mobile</field>
        <field name="model">wujia.franchise.management</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="code" />
                <field name="name" />
                <field name="display_name" />
                <field name="area_id" />
                <field name="franchise_start_date" />
                <field name="franchise_end_date" />
                <field name="remaining_days" />
                <field name="member_count" />
                <field name="status" />
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <!-- Row 1: Store Code + Status Badge -->
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code" />
                                </span>
                                <span
                                    t-attf-class="wj_mobile_badge #{
                                    record.status.raw_value == 'active' and 'wj_mobile_badge--success' or
                                    record.status.raw_value == 'draft' and 'wj_mobile_badge--warning' or
                                    record.status.raw_value in ['locked', 'expired'] and 'wj_mobile_badge--danger' or
                                    'wj_mobile_badge--neutral'
                                }">
                                    <field name="status" />
                                </span>
                            </div>

                            <!-- Row 2: Display Name (Title) -->
                            <div class="wj_mobile_card__title mb-1">
                                <field name="display_name" />
                            </div>

                            <!-- Row 3: Info Footer (Row 3a: Expiration Date & Remaining Days; Row 3b: Area & Member Count) -->
                            <div class="pt-2 border-top overflow-hidden">
                                <div class="d-flex align-items-center justify-content-between mb-1 overflow-hidden">
                                    <span class="wj_mobile_card__meta text-nowrap me-2 overflow-hidden text-truncate">
                                        <t t-if="record.franchise_end_date.raw_value">
                                            <i class="fa fa-calendar me-1" title="Contract Expiration" />
                                            <field name="franchise_end_date" widget="date" />
                                        </t>
                                    </span>
                                    <span class="wj_mobile_card__value text-primary font-weight-bold text-nowrap flex-shrink-0 ms-auto">
                                        <t t-esc="record.remaining_days.value" /> days left
                                    </span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between overflow-hidden">
                                    <span class="wj_mobile_card__meta text-nowrap me-2 overflow-hidden text-truncate">
                                        <t t-if="record.area_id.raw_value">
                                            <i class="fa fa-map-marker me-1" title="Area" />
                                            <field name="area_id" />
                                        </t>
                                    </span>
                                    <span class="wj_mobile_card__subvalue text-nowrap flex-shrink-0 ms-auto">
                                        <i class="fa fa-users me-1" title="Members" />
                                        <field name="member_count" /> members
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile Kanban View for Operational Areas -->
    <record id="view_res_area_kanban_mobile" model="ir.ui.view">
        <field name="name">res.area.kanban.mobile</field>
        <field name="model">res.area</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="manager_user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                            </div>
                            <div class="wj_mobile_card__title mb-1">
                                <field name="name"/>
                            </div>
                            <div class="pt-2 border-top overflow-hidden">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <t t-if="record.manager_user_id.raw_value">
                                        <i class="fa fa-user me-1" title="Manager"/>
                                        <field name="manager_user_id"/>
                                    </t>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile Kanban View for Wards / Communes -->
    <record id="view_res_ward_kanban_mobile" model="ir.ui.view">
        <field name="name">res.ward.kanban.mobile</field>
        <field name="model">res.ward</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    <field name="code"/>
                                </span>
                            </div>
                            <div class="wj_mobile_card__title mb-1">
                                <field name="name"/>
                            </div>
                            <div class="pt-2 border-top overflow-hidden">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <t t-if="record.state_id.raw_value">
                                        <i class="fa fa-map-marker me-1" title="Province"/>
                                        <field name="state_id"/>
                                    </t>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile Kanban View for Franchise Members -->
    <record id="view_wujia_franchise_member_kanban_mobile" model="ir.ui.view">
        <field name="name">wujia.franchise.member.kanban.mobile</field>
        <field name="model">wujia.franchise.member</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="wj_mobile_kanban" sample="1">
                <field name="user_id"/>
                <field name="franchise_id"/>
                <field name="role"/>
                <field name="is_currently_valid"/>
                <templates>
                    <t t-name="card">
                        <div class="wj_mobile_card">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="wj_mobile_card__code">
                                    Role: <field name="role"/>
                                </span>
                                <span t-attf-class="wj_mobile_badge #{
                                    record.is_currently_valid.raw_value and 'wj_mobile_badge--success' or 'wj_mobile_badge--neutral'
                                }">
                                    <t t-if="record.is_currently_valid.raw_value">Valid</t>
                                    <t t-else="">Invalid</t>
                                </span>
                            </div>
                            <div class="wj_mobile_card__title mb-1">
                                <field name="user_id"/>
                            </div>
                            <div class="pt-2 border-top overflow-hidden">
                                <span class="wj_mobile_card__meta text-nowrap">
                                    <i class="fa fa-store me-1" title="Store"/>
                                    <field name="franchise_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Update Action Window for Store Master -->
    <record id="wujia_franchise.action_franchise_management" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_franchise.view_franchise_management_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_franchise_management_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_franchise.view_franchise_management_form'), 'sequence': 3})
        ]" />
    </record>

    <!-- Update Action Window for Operational Areas -->
    <record id="wujia_core.action_res_area" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_core.view_res_area_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_res_area_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_core.view_res_area_form'), 'sequence': 3})
        ]" />
    </record>

    <!-- Update Action Window for Wards / Communes -->
    <record id="wujia_core.action_res_ward" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_core.view_res_ward_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_res_ward_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_core.view_res_ward_form'), 'sequence': 3})
        ]" />
    </record>

    <!-- Update Action Window for Franchise Members -->
    <record id="wujia_franchise.action_wujia_franchise_member" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('wujia_franchise.view_wujia_franchise_member_list'), 'sequence': 1}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wujia_franchise_member_kanban_mobile'), 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('wujia_franchise.view_wujia_franchise_member_form'), 'sequence': 3})
        ]" />
    </record>

</odoo>
