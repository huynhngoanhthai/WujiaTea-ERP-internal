<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege (Odoo 19 Settings → Users → Access Rights) -->
    <record model="res.groups.privilege" id="res_groups_privilege_dynamic_dashboard_ai_nexgen">
        <field name="name">Dynamic Dashboard</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_extra"/>
    </record>

    <!-- Roles: User → Manager → Analysis Manager → Administrator -->
    <record id="group_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Can open and interact with dashboards (view, drill, export, todo).</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard_ai_nexgen"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Can create and edit dashboards, items, KPIs, analyses, and filters.</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard_ai_nexgen"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
    </record>

    <record id="group_analysis_manager" model="res.groups">
        <field name="name">Analysis Manager</field>
        <field name="sequence">25</field>
        <field name="comment">Can manage data marts and advanced analysis data sources.</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard_ai_nexgen"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_manager'))]"/>
    </record>

    <record id="group_dashboard_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="comment">Full access: settings, external connections, and all dashboard features.</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard_ai_nexgen"/>
        <field name="implied_ids" eval="[(4, ref('group_analysis_manager'))]"/>
        <!-- Admin / root always get full access by default (Odoo standard) -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="0">
        <!-- ========== Multi-company rules (Odoo 19 domain style) ========== -->
        <record id="dynamic_dashboard_ai_nexgen_comp_rule" model="ir.rule">
            <field name="name">Dashboard: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_item_comp_rule" model="ir.rule">
            <field name="name">Dashboard Item: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_filter_comp_rule" model="ir.rule">
            <field name="name">Dashboard Filter: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_filter"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_todo_comp_rule" model="ir.rule">
            <field name="name">Dashboard Todo: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_todo"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_item_color_comp_rule" model="ir.rule">
            <field name="name">Dashboard Item Color: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_item_color"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_item_source_comp_rule" model="ir.rule">
            <field name="name">Dashboard Item Source: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_item_source"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_target_line_comp_rule" model="ir.rule">
            <field name="name">Dashboard Target Line: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_target_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_report_comp_rule" model="ir.rule">
            <field name="name">Dashboard Report: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_share_comp_rule" model="ir.rule">
            <field name="name">Dashboard Share: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_share"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_connection_comp_rule" model="ir.rule">
            <field name="name">Dashboard Connection: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_connection"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_analysis_comp_rule" model="ir.rule">
            <field name="name">Dashboard Analysis: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_analysis"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_analysis_metric_comp_rule" model="ir.rule">
            <field name="name">Dashboard Analysis Metric: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_analysis_metric"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_analysis_dimension_comp_rule" model="ir.rule">
            <field name="name">Dashboard Analysis Dimension: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_analysis_dimension"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_analysis_filter_comp_rule" model="ir.rule">
            <field name="name">Dashboard Analysis Filter: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_analysis_filter"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_mart_comp_rule" model="ir.rule">
            <field name="name">Dashboard Mart: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_mart"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_kpi_comp_rule" model="ir.rule">
            <field name="name">Dashboard KPI: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_kpi"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_kpi_target_comp_rule" model="ir.rule">
            <field name="name">Dashboard KPI Target: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_kpi_target"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_number_system_comp_rule" model="ir.rule">
            <field name="name">Dashboard Number System: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_number_system"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_number_system_line_comp_rule" model="ir.rule">
            <field name="name">Dashboard Number System Line: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_number_system_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_date_filter_comp_rule" model="ir.rule">
            <field name="name">Dashboard Date Filter: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_date_filter"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="dynamic_dashboard_ai_nexgen_demo_record_comp_rule" model="ir.rule">
            <field name="name">Dashboard Demo Record: multi-company</field>
            <field name="model_id" ref="model_dynamic_dashboard_demo_record"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- ========== Group-based dashboard visibility ========== -->
        <!-- Users only see dashboards with no group restriction or their groups -->
        <record id="dynamic_dashboard_ai_nexgen_group_rule" model="ir.rule">
            <field name="name">Dashboard: allowed groups (users)</field>
            <field name="model_id" ref="model_dynamic_dashboard"/>
            <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
        </record>
        <!-- Managers/admins see all dashboards in their companies (OR with user rule) -->
        <record id="dynamic_dashboard_ai_nexgen_manager_visibility_rule" model="ir.rule">
            <field name="name">Dashboard: managers see all (company still applies)</field>
            <field name="model_id" ref="model_dynamic_dashboard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
        </record>

        <!-- Users only see items with no group restriction or their groups -->
        <record id="dynamic_dashboard_ai_nexgen_item_group_rule" model="ir.rule">
            <field name="name">Dashboard Item: allowed groups (users)</field>
            <field name="model_id" ref="model_dynamic_dashboard_item"/>
            <field name="domain_force">['|', ('allowed_group_ids', '=', False), ('allowed_group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
        </record>
        <!-- Managers/admins see all items in their companies (OR with user rule) -->
        <record id="dynamic_dashboard_ai_nexgen_item_manager_visibility_rule" model="ir.rule">
            <field name="name">Dashboard Item: managers see all</field>
            <field name="model_id" ref="model_dynamic_dashboard_item"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
        </record>

        <record id="dynamic_dashboard_ai_nexgen_user_preference_rule" model="ir.rule">
            <field name="name">User Dashboard Preferences</field>
            <field name="model_id" ref="model_dynamic_dashboard_user_preference"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
