<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_dashboard_ai_nexgen_mart_list" model="ir.ui.view">
        <field name="name">dynamic.dashboard.mart.list</field>
        <field name="model">dynamic.dashboard.mart</field>
        <field name="arch" type="xml">
            <list string="Data Marts" multi_edit="1" sample="1"
                  decoration-muted="not active"
                  decoration-danger="last_status == 'error'"
                  decoration-success="last_status == 'ok'">
                <field name="name"/>
                <field name="source_type"/>
                <field name="target_table"/>
                <field name="schedule_hours" optional="show"/>
                <field name="last_status" widget="badge"
                          decoration-success="last_status == 'ok'"
                          decoration-danger="last_status == 'error'"
                          decoration-info="last_status == 'never'"/>
                <field name="last_run" optional="show"/>
                <field name="row_count" optional="show"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_dashboard_ai_nexgen_mart_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.mart.form</field>
        <field name="model">dynamic.dashboard.mart</field>
        <field name="arch" type="xml">
            <form string="Data Mart">
                <header>
                    <button name="action_run_now" type="object" string="Run Now"
                            class="btn-primary" icon="fa-play"/>
                    <field name="last_status" widget="statusbar" statusbar_visible="never,ok,error"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales Fact Table" class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="active" invisible="1"/>
                            <field name="source_type"/>
                            <field name="target_table" placeholder="e.g. dd_mart_sales"/>
                            <field name="schedule_hours"/>
                            <field name="external_connection_id" options="{'no_create': True}"/>
                            <field name="notify_user_ids" widget="many2many_tags"
                                      options="{'no_create': True}"
                                      placeholder="Notify on failure…"/>
                            <field name="company_id" groups="base.group_multi_company"
                                      options="{'no_create': True}"/>
                        </group>
                        <group string="Last Run">
                            <field name="last_run"/>
                            <field name="row_count"/>
                            <field name="last_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Query" name="query" invisible="source_type != 'sql'">
                            <field name="query" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
                        </page>
                        <page string="Python" name="python" invisible="source_type != 'python'">
                            <field name="python_code" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dynamic_dashboard_ai_nexgen_mart_search" model="ir.ui.view">
        <field name="name">dynamic.dashboard.mart.search</field>
        <field name="model">dynamic.dashboard.mart</field>
        <field name="arch" type="xml">
            <search string="Data Marts">
                <field name="name"/>
                <field name="target_table"/>
                <field name="source_type"/>
                <field name="external_connection_id"/>
                <field name="last_status"/>
                <field name="notify_user_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="filter_sql" string="SQL" domain="[('source_type', '=', 'sql')]"/>
                <filter name="filter_python" string="Python" domain="[('source_type', '=', 'python')]"/>
                <filter name="filter_ok" string="Last Status: OK" domain="[('last_status', '=', 'ok')]"/>
                <filter name="filter_error" string="Last Status: Error" domain="[('last_status', '=', 'error')]"/>
                <filter name="filter_never" string="Never Run" domain="[('last_status', '=', 'never')]"/>
                <group>
                    <filter name="group_source" string="Source Type" context="{'group_by': 'source_type'}"/>
                    <filter name="group_status" string="Last Status" context="{'group_by': 'last_status'}"/>
                    <filter name="group_connection" string="Connection" context="{'group_by': 'external_connection_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
                <searchpanel>
                    <field name="source_type" enable_counters="1"/>
                    <field name="last_status" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_mart" model="ir.actions.act_window">
        <field name="name">Data Marts</field>
        <field name="res_model">dynamic.dashboard.mart</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dynamic_dashboard_ai_nexgen_mart_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a data mart to cache SQL/Python results
            </p>
            <p>
                Refresh on a schedule and reuse cached tables in analyses and items.
            </p>
        </field>
    </record>
</odoo>
