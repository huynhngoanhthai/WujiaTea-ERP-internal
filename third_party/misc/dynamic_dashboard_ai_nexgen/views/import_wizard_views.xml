<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dynamic_dashboard_ai_nexgen_import_wizard_view_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.import.wizard.form</field>
        <field name="model">dynamic.dashboard.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Dashboard">
                <div class="alert alert-info" role="alert">
                    Upload a dashboard JSON export to recreate its layout and items.
                </div>
                <group>
                    <field name="import_file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_import" model="ir.actions.act_window">
        <field name="name">Import Dashboard</field>
        <field name="res_model">dynamic.dashboard.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
