<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dynamic_dashboard_ai_nexgen_date_filter_view_list" model="ir.ui.view">
        <field name="name">dynamic.dashboard.date.filter.list</field>
        <field name="model">dynamic.dashboard.date.filter</field>
        <field name="arch" type="xml">
            <list string="Custom Date Filters" multi_edit="1"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="offset_start"/>
                <field name="offset_end"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dynamic_dashboard_ai_nexgen_date_filter_view_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.date.filter.form</field>
        <field name="model">dynamic.dashboard.date.filter</field>
        <field name="arch" type="xml">
            <form string="Custom Date Filter">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Last 45 Days" class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Offsets (days)">
                            <field name="active" invisible="1"/>
                            <field name="offset_start"/>
                            <field name="offset_end"/>
                        </group>
                        <group string="Settings">
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"
                                      options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Offsets are days relative to today. Example: start=-44, end=0 → last 45 days including today.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dynamic_dashboard_ai_nexgen_date_filter_view_search" model="ir.ui.view">
        <field name="name">dynamic.dashboard.date.filter.search</field>
        <field name="model">dynamic.dashboard.date.filter</field>
        <field name="arch" type="xml">
            <search string="Custom Date Filters">
                <field name="name"/>
                <field name="offset_start"/>
                <field name="offset_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="filter_past" string="Starts in Past" domain="[('offset_start', '&lt;', 0)]"/>
                <filter name="filter_includes_today" string="Includes Today" domain="[('offset_end', '&gt;=', 0)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_date_filter" model="ir.actions.act_window">
        <field name="name">Custom Date Filters</field>
        <field name="res_model">dynamic.dashboard.date.filter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="dynamic_dashboard_ai_nexgen_date_filter_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define reusable relative date ranges
            </p>
        </field>
    </record>
</odoo>
