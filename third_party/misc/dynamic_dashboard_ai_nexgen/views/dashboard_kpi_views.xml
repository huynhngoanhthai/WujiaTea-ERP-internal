<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_dashboard_ai_nexgen_kpi_list" model="ir.ui.view">
        <field name="name">dynamic.dashboard.kpi.list</field>
        <field name="model">dynamic.dashboard.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs" multi_edit="1" sample="1"
                  decoration-muted="not active"
                  decoration-danger="achievement &lt; 100 and target_value"
                  decoration-success="achievement &gt;= 100">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="computation_mode"/>
                <field name="current_value" optional="show"/>
                <field name="target_value" optional="show"/>
                <field name="achievement" widget="progressbar" optional="show"/>
                <field name="unit" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="alert_enabled" optional="hide"/>
                <field name="last_computed" optional="hide"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_dashboard_ai_nexgen_kpi_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.kpi.form</field>
        <field name="model">dynamic.dashboard.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <header>
                    <button name="action_compute_now" type="object" string="Compute Now"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_export_targets" type="object" string="Export Targets"
                            class="btn-secondary" icon="fa-download"/>
                    <button name="action_import_targets_wizard" type="object" string="Import Targets"
                            class="btn-secondary" icon="fa-upload"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Revenue" class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Definition">
                            <field name="active" invisible="1"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="computation_mode"/>
                            <field name="unit" placeholder="e.g. %, USD"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"
                                      options="{'no_create': True}"/>
                        </group>
                        <group string="Results">
                            <field name="current_value"/>
                            <field name="target_value"/>
                            <field name="achievement" widget="progressbar"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="last_computed"/>
                        </group>
                    </group>
                    <group string="Model Computation" invisible="computation_mode != 'model'">
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="measure_field_id"/>
                            <field name="aggregation"/>
                        </group>
                        <group>
                            <field name="date_filter_field_id"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                        </group>
                    </group>
                    <group string="Formula" invisible="computation_mode != 'formula'">
                        <field name="formula" placeholder="e.g. {child1} / {child2} * 100"/>
                    </group>
                    <notebook>
                        <page string="Children" name="children">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list string="Child KPIs" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="computation_mode"/>
                                    <field name="current_value"/>
                                    <field name="target_value" optional="show"/>
                                    <field name="achievement" widget="progressbar" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Targets" name="targets">
                            <field name="target_ids" context="{'default_kpi_id': id}">
                                <list editable="bottom" string="Targets">
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="target_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alerts" name="alerts">
                            <group>
                                <group string="Threshold">
                                    <field name="alert_enabled"/>
                                    <field name="alert_threshold_pct" invisible="not alert_enabled"/>
                                    <field name="alert_cooldown_hours" invisible="not alert_enabled"/>
                                </group>
                                <group string="Recipients">
                                    <field name="alert_user_ids" widget="many2many_tags"
                                              options="{'no_create': True}"
                                              invisible="not alert_enabled"/>
                                    <field name="alert_last_notified" invisible="not alert_enabled"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dynamic_dashboard_ai_nexgen_kpi_search" model="ir.ui.view">
        <field name="name">dynamic.dashboard.kpi.search</field>
        <field name="model">dynamic.dashboard.kpi</field>
        <field name="arch" type="xml">
            <search string="KPIs">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="computation_mode"/>
                <field name="model_id"/>
                <field name="measure_field_id"/>
                <field name="aggregation"/>
                <field name="currency_id"/>
                <field name="unit"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="filter_root" string="Root KPIs" domain="[('parent_id', '=', False)]"/>
                <filter name="filter_children" string="Child KPIs" domain="[('parent_id', '!=', False)]"/>
                <filter name="filter_mode_model" string="Mode: Model" domain="[('computation_mode', '=', 'model')]"/>
                <filter name="filter_mode_formula" string="Mode: Formula" domain="[('computation_mode', '=', 'formula')]"/>
                <filter name="filter_mode_children" string="Mode: Children" domain="[('computation_mode', '=', 'children')]"/>
                <filter name="filter_alerts" string="Alerts Enabled" domain="[('alert_enabled', '=', True)]"/>
                <group>
                    <filter name="group_parent" string="Parent KPI" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_mode" string="Computation Mode" context="{'group_by': 'computation_mode'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
                <searchpanel>
                    <field name="computation_mode" enable_counters="1"/>
                    <field name="company_id" groups="base.group_multi_company" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_kpi_target_import_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.kpi.target.import.form</field>
        <field name="model">dynamic.dashboard.kpi.target.import</field>
        <field name="arch" type="xml">
            <form string="Import Targets">
                <group>
                    <field name="kpi_id" options="{'no_create': True}"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">dynamic.dashboard.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dynamic_dashboard_ai_nexgen_kpi_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define hierarchical KPIs
            </p>
            <p>
                Track targets, compute from models or formulas, and alert when performance drops.
            </p>
        </field>
    </record>
</odoo>
