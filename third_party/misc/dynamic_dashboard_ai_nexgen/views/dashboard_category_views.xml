<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_dashboard_ai_nexgen_category_list" model="ir.ui.view">
        <field name="name">dynamic.dashboard.category.list</field>
        <field name="model">dynamic.dashboard.category</field>
        <field name="arch" type="xml">
            <list string="Dashboard Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="dashboard_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_dashboard_ai_nexgen_category_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.category.form</field>
        <field name="model">dynamic.dashboard.category</field>
        <field name="arch" type="xml">
            <form string="Dashboard Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="dashboard_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_category" model="ir.actions.act_window">
        <field name="name">Dashboard Categories</field>
        <field name="res_model">dynamic.dashboard.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
