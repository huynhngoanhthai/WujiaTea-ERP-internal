<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dynamic_dashboard_ai_nexgen_item_move_view_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.item.move.form</field>
        <field name="model">dynamic.dashboard.item.move</field>
        <field name="arch" type="xml">
            <form string="Move / Duplicate Item">
                <group>
                    <field name="item_id" readonly="1" force_save="1"/>
                    <field name="action" widget="radio"/>
                    <field name="dashboard_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dynamic_dashboard_ai_nexgen_item_move" model="ir.actions.act_window">
        <field name="name">Move / Duplicate Item</field>
        <field name="res_model">dynamic.dashboard.item.move</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dynamic_dashboard_item"/>
        <field name="binding_view_types">form</field>
        <field name="context">{
            'default_item_id': active_id,
            'default_dashboard_id': False,
        }</field>
    </record>
</odoo>
