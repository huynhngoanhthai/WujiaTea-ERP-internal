<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dynamic_dashboard_ai_nexgen.Dashboard">
        <div t-attf-class="dynamic-dashboard-container o_action {{state.tvActive &amp;&amp; state.tvHideChrome ? 'dd-tv-mode' : ''}} {{state.editMode ? 'dd-editing' : ''}} {{state.stickyNavbar ? 'dd-sticky-nav' : ''}}"
             t-att-dir="state.isRtl ? 'rtl' : 'ltr'"
             t-attf-style="background-color: {{state.backgroundColor || '#E9ECEF'}};">

            <!-- ========== Top Navbar (analytics control strip) ========== -->
            <div t-attf-class="dd-navbar {{state.tvActive &amp;&amp; state.tvHideChrome ? 'd-none' : ''}}">
                <div class="dd-navbar-inner">
                    <!-- Brand / title -->
                    <div class="dd-navbar-brand">
                        <div class="dd-brand-icon">
                            <i class="fa fa-th-large"/>
                        </div>
                        <div class="dd-brand-text min-w-0">
                            <div class="dd-brand-title text-truncate">
                                <t t-esc="state.selectedDashboard ? state.selectedDashboard.name : _t('My Dashboard')"/>
                            </div>
                            <div class="dd-brand-meta">
                                <span t-if="state.selectedDashboard and state.selectedDashboard.category" class="dd-chip dd-chip-cat">
                                    <t t-esc="state.selectedDashboard.category"/>
                                </span>
                                <span class="dd-meta-muted">
                                    <t t-esc="state.items.length"/> <t t-esc="_t('items')"/>
                                </span>
                                <span t-if="state.lastRefreshed" class="dd-meta-muted">
                                    · <t t-esc="_t('Updated')"/> <t t-esc="state.lastRefreshed"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Primary CTA -->
                    <div class="dd-navbar-cta" t-if="state.canEdit">
                        <button class="dd-btn-primary" t-on-click="createNewItem">
                            <i class="fa fa-plus"/> <span><t t-esc="_t('Add Item')"/></span>
                        </button>
                    </div>
                </div>

                <!-- Floating control toolbar -->
                <div class="dd-toolbar">
                    <div class="dd-toolbar-left">
                        <div class="dd-select-wrap" t-if="state.dashboards.length">
                            <i class="fa fa-folder-o dd-select-icon"/>
                            <select class="dd-select" t-on-change="onDashboardChange"
                                    t-att-title="_t('Switch dashboard')">
                                <t t-foreach="getDashboardGroups()" t-as="grp" t-key="grp.key">
                                    <optgroup t-if="grp.label" t-att-label="grp.label">
                                        <t t-foreach="grp.dashboards" t-as="dash" t-key="dash.id">
                                            <option t-att-value="dash.id"
                                                    t-att-selected="state.selectedDashboard and state.selectedDashboard.id === dash.id ? 'selected' : undefined">
                                                <t t-esc="dash.name"/>
                                            </option>
                                        </t>
                                    </optgroup>
                                    <t t-else="">
                                        <t t-foreach="grp.dashboards" t-as="dash" t-key="dash.id">
                                            <option t-att-value="dash.id"
                                                    t-att-selected="state.selectedDashboard and state.selectedDashboard.id === dash.id ? 'selected' : undefined">
                                                <t t-esc="dash.name"/>
                                            </option>
                                        </t>
                                    </t>
                                </t>
                            </select>
                        </div>

                        <div class="dd-select-wrap">
                            <i class="fa fa-calendar dd-select-icon"/>
                            <select class="dd-select" t-on-change="onDateFilterChange"
                                    t-att-value="state.globalDateFilter"
                                    t-att-title="_t('Date filter')">
                                <t t-foreach="state.dateFilterOptions" t-as="opt" t-key="opt.value">
                                    <option t-att-value="opt.value" t-esc="opt.label"/>
                                </t>
                                <t t-foreach="state.customDateFilters" t-as="cdf" t-key="cdf.id">
                                    <option t-att-value="cdf.key" t-esc="cdf.name"/>
                                </t>
                            </select>
                        </div>

                        <!-- Theme Selector (Only in Edit Mode or if user wants to change it quickly) -->
                        <div class="dd-select-wrap" t-if="state.selectedDashboard and state.canEdit">
                            <i class="fa fa-paint-brush dd-select-icon"/>
                            <select class="dd-select" t-on-change="onDashboardThemeChange" t-att-title="_t('Chart Theme')">
                                <option value="" t-att-selected="!state.selectedDashboard.chart_theme ? 'selected' : undefined">Item Default Theme</option>
                                <option value="default" t-att-selected="state.selectedDashboard.chart_theme == 'default' ? 'selected' : undefined">Default</option>
                                <option value="cool" t-att-selected="state.selectedDashboard.chart_theme == 'cool' ? 'selected' : undefined">Cool</option>
                                <option value="warm" t-att-selected="state.selectedDashboard.chart_theme == 'warm' ? 'selected' : undefined">Warm</option>
                                <option value="neon" t-att-selected="state.selectedDashboard.chart_theme == 'neon' ? 'selected' : undefined">Neon</option>
                                <option value="pastel" t-att-selected="state.selectedDashboard.chart_theme == 'pastel' ? 'selected' : undefined">Pastel</option>
                                <option value="corporate" t-att-selected="state.selectedDashboard.chart_theme == 'corporate' ? 'selected' : undefined">Corporate</option>
                                <option value="vibrant" t-att-selected="state.selectedDashboard.chart_theme == 'vibrant' ? 'selected' : undefined">Vibrant</option>
                                <option value="ocean" t-att-selected="state.selectedDashboard.chart_theme == 'ocean' ? 'selected' : undefined">Ocean</option>
                                <option value="sunset" t-att-selected="state.selectedDashboard.chart_theme == 'sunset' ? 'selected' : undefined">Sunset</option>
                            </select>
                        </div>

                        <label class="dd-compare" t-att-title="_t('Compare with previous period')">
                            <input type="checkbox" t-att-checked="state.globalCompare" t-on-change="onCompareChange"/>
                            <span><t t-esc="_t('Compare')"/></span>
                        </label>
                    </div>

                    <div class="dd-toolbar-right">
                        <div class="dd-icon-group">
                            <button class="dd-icon-btn" t-on-click="refreshAll" t-att-title="_t('Refresh')">
                                <i t-attf-class="fa fa-refresh {{state.refreshing ? 'fa-spin' : ''}}"/>
                            </button>
                            <button t-if="state.canEdit"
                                    t-attf-class="dd-icon-btn {{state.editMode ? 'is-active' : ''}}"
                                    t-on-click="toggleEditMode"
                                    t-att-title="state.editMode ? _t('Save layout') : _t('Edit layout')">
                                <i t-attf-class="fa #{state.editMode ? 'fa-check' : 'fa-arrows'}"/>
                            </button>
                            <button t-if="state.canEdit"
                                    class="dd-icon-btn"
                                    t-on-click="autoArrangeLayout"
                                    t-att-title="_t('Auto Arrange Layout')">
                                <i class="fa fa-magic"/>
                            </button>
                            <button class="dd-icon-btn" t-on-click="toggleBookmark"
                                    t-att-title="isBookmarked ? _t('Remove bookmark') : _t('Bookmark')"
                                    t-attf-class="dd-icon-btn {{isBookmarked ? 'is-bookmarked' : ''}}">
                                <i t-attf-class="fa #{isBookmarked ? 'fa-star' : 'fa-star-o'}"/>
                            </button>

                            <div class="dropdown">
                                <button class="dd-icon-btn dropdown-toggle" data-bs-toggle="dropdown"
                                        aria-expanded="false" t-att-title="_t('More actions')">
                                    <i class="fa fa-ellipsis-v"/>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dd-dropdown">
                                    <li>
                                        <a class="dropdown-item" href="#" t-on-click.prevent="exportPNG">
                                            <i class="fa fa-file-image-o me-2 text-success"/> <t t-esc="_t('Export PNG')"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" t-on-click.prevent="exportPDF">
                                            <i class="fa fa-file-pdf-o me-2 text-danger"/> <t t-esc="_t('Export PDF')"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" t-on-click.prevent="sendEmail">
                                            <i class="fa fa-envelope me-2 text-warning"/> <t t-esc="_t('Send Email')"/>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"/></li>
                                    <li>
                                        <a class="dropdown-item" href="#" t-on-click.prevent="startPresentMode">
                                            <i class="fa fa-play me-2 text-primary"/> <t t-esc="_t('Present Mode')"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" t-on-click.prevent="toggleTvMode">
                                            <i class="fa fa-television me-2 text-info"/> <t t-esc="_t('TV Mode')"/>
                                        </a>
                                    </li>
                                    <li t-if="state.canEdit"><hr class="dropdown-divider"/></li>
                                    <li t-if="state.canEdit">
                                        <a class="dropdown-item" href="#" t-on-click.prevent="shareFromViewer">
                                            <i class="fa fa-share-alt me-2"/> <t t-esc="_t('Share Link')"/>
                                        </a>
                                    </li>
                                    <li t-if="state.canEdit">
                                        <a class="dropdown-item" href="#" t-on-click.prevent="openDashboardConfig">
                                            <i class="fa fa-cog me-2"/> <t t-esc="_t('Configure')"/>
                                        </a>
                                    </li>
                                    <li t-if="state.canEdit">
                                        <a class="dropdown-item" href="#" t-on-click.prevent="duplicateDashboard">
                                            <i class="fa fa-copy me-2"/> <t t-esc="_t('Duplicate')"/>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="dd-ai-box" t-if="state.canEdit">
                            <input type="text" class="dd-ai-input"
                                   t-att-placeholder="_t('Keyword (optional)…')"
                                   t-att-value="state.aiKeyword"
                                   t-on-input="(ev) => this.state.aiKeyword = ev.target.value"
                                   t-on-keydown="onAiKeydown"
                                   t-on-focus="closeAiMenu"/>
                            <button type="button" class="dd-ai-btn" t-on-click.stop="onAiButtonClick"
                                    t-att-title="_t('AI Feature')"
                                    t-att-aria-expanded="state.aiMenuOpen ? 'true' : 'false'">
                                <i class="fa fa-magic"/>
                            </button>
                            <div t-if="state.aiMenuOpen" class="dd-ai-menu" role="menu">
                                <button type="button" class="dd-ai-menu-item" role="menuitem"
                                        t-on-click.stop="openAiCreateDashboard">
                                    <i class="fa fa-magic me-2 text-primary"/>
                                    <t t-esc="_t('Create Dashboard with AI')"/>
                                </button>
                                <button type="button" class="dd-ai-menu-item" role="menuitem"
                                        t-on-click.stop="openAiGenerateItems">
                                    <i class="fa fa-th me-2 text-success"/>
                                    <t t-esc="_t('Generate Items with AI')"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Category chips -->
                <div t-if="getCategories().length > 1" class="dd-category-bar">
                    <button t-attf-class="dd-chip {{!state.categoryFilter ? 'is-active' : ''}}"
                            t-on-click="() => this.setCategoryFilter(null)">
                        <t t-esc="_t('All')"/>
                    </button>
                    <t t-foreach="getCategories()" t-as="cat" t-key="cat">
                        <button t-attf-class="dd-chip {{state.categoryFilter === cat ? 'is-active' : ''}}"
                                t-on-click="() => this.setCategoryFilter(cat)">
                            <t t-esc="cat"/>
                        </button>
                    </t>
                </div>

                <!-- Custom filters -->
                <div t-if="state.customFilters.length" class="dd-filter-bar">
                    <span class="dd-filter-label"><i class="fa fa-filter me-1"/> <t t-esc="_t('Filters')"/></span>
                    <t t-foreach="state.customFilters" t-as="cfilter" t-key="cfilter.id">
                        <button t-attf-class="dd-chip {{state.activeCustomFilters.includes(cfilter.id) ? 'is-active' : ''}}"
                                t-on-click="() => this.toggleCustomFilter(cfilter.id)">
                            <t t-esc="cfilter.name"/>
                        </button>
                    </t>
                    <button t-if="state.activeCustomFilters.length"
                            class="dd-chip dd-chip-clear"
                            t-on-click="clearCustomFilters">
                        <i class="fa fa-times"/> <t t-esc="_t('Clear')"/>
                    </button>
                </div>

                <!-- Edit mode banner -->
                <div t-if="state.editMode" class="dd-edit-banner">
                    <i class="fa fa-arrows me-2"/>
                    <t t-esc="_t('Edit layout: drag and resize widgets, then click the check to save.')"/>
                </div>
            </div>

            <!-- TV bar -->
            <div t-if="state.tvActive" class="dd-tv-bar d-flex align-items-center gap-2 px-3 py-2 bg-dark text-white">
                <span class="badge bg-info"><t t-esc="_t('TV Mode')"/></span>
                <select class="form-select form-select-sm" style="width: auto;" t-on-change="onTvModeTypeChange" t-att-value="state.tvModeType">
                    <option value="dashboard"><t t-esc="_t('Rotate Dashboards')"/></option>
                    <option value="item"><t t-esc="_t('Slideshow Items')"/></option>
                </select>
                <label class="small mb-0"><t t-esc="_t('Interval')"/></label>
                <select class="form-select form-select-sm" style="width: auto;" t-on-change="onTvIntervalChange" t-att-value="state.tvIntervalSec">
                    <option value="5">5s</option>
                    <option value="10">10s</option>
                    <option value="15">15s</option>
                    <option value="30">30s</option>
                    <option value="60">60s</option>
                </select>
                <button class="btn btn-sm btn-outline-light" t-on-click="toggleTvPause" t-att-title="state.tvPaused ? _t('Play') : _t('Pause')">
                    <i t-attf-class="fa #{state.tvPaused ? 'fa-play' : 'fa-pause'}"/>
                </button>
                <button class="btn btn-sm btn-outline-light" t-on-click="advanceTvSlide" t-att-title="_t('Next')">
                    <i class="fa fa-step-forward"/>
                </button>
                <button class="btn btn-sm btn-danger ms-auto" t-on-click="toggleTvMode" t-att-title="_t('Exit TV Mode')">
                    <i class="fa fa-times"/> <t t-esc="_t('Exit')"/>
                </button>
            </div>

            <!-- Presenter notes (from dashboard form Present Notes field) -->
            <div t-if="state.presentMode and state.presentNotes"
                 class="dd-present-notes alert alert-warning mb-0 rounded-0 border-0 border-bottom">
                <div class="d-flex gap-2 align-items-start px-3 py-2">
                    <i class="fa fa-sticky-note-o mt-1"/>
                    <div class="flex-grow-1" style="white-space: pre-wrap;" t-esc="state.presentNotes"/>
                </div>
            </div>

            <!-- Content -->
            <div class="o_content">
                <div class="dashboard-items-container dd-canvas p-3">
                    <t t-if="state.items.length > 0">
                        <div class="grid-stack" t-ref="grid">
                            <t t-foreach="state.items" t-as="item" t-key="item.id">
                                <div t-attf-class="grid-stack-item {{isTvFocused(item.id) ? '' : 'dd-tv-dimmed'}}"
                                     t-att-gs-x="item.grid_x"
                                     t-att-gs-y="item.grid_y"
                                     t-att-gs-w="item.grid_w"
                                     t-att-gs-h="item.grid_h"
                                     t-att-gs-id="item.id"
                                     t-att-data-item-id="item.id">
                                <div class="grid-stack-item-content">
                                    <div t-if="state.editMode" class="dd-drag-handle" t-att-title="_t('Drag to move')">
                                        <i class="fa fa-arrows"/>
                                        <span><t t-esc="_t('Drag')"/></span>
                                    </div>
                                    <DynamicDashboardItem
                                        item="item"
                                        itemId="item.id"
                                        itemType="item.item_type"
                                        globalDateFilter="state.globalDateFilter"
                                        globalCompare="state.globalCompare"
                                        customFilterDomains="getCustomFilterDomains(item.id)"
                                        prefetchedData="getItemPayload(item.id)"
                                        awaitingBatch="state.awaitingPayloads"
                                        canEdit="state.canEdit"
                                        refreshKey="state.refreshKey"/>
                                </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <div t-elif="state.selectedDashboard" class="dd-empty">
                        <div class="dd-empty-icon"><i class="fa fa-pie-chart"/></div>
                        <h3><t t-esc="_t('Build your first chart')"/></h3>
                        <p><t t-esc="_t('This dashboard has no items yet. Add a tile, KPI, chart, list, or map to get started.')"/></p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <button t-if="state.canEdit" class="dd-btn-primary" t-on-click="createNewItem">
                                <i class="fa fa-plus"/> <t t-esc="_t('Add Item')"/>
                            </button>
                            <button t-if="state.canEdit" class="dd-btn-ghost" t-on-click="openAiGenerateItems">
                                <i class="fa fa-magic"/> <t t-esc="_t('Generate Items with AI')"/>
                            </button>
                            <button t-if="state.canEdit" class="dd-btn-ghost" t-on-click="openAiCreateDashboard">
                                <i class="fa fa-magic"/> <t t-esc="_t('Create Dashboard with AI')"/>
                            </button>
                        </div>
                    </div>
                    <div t-else="" class="dd-empty">
                        <div class="dd-empty-icon"><i class="fa fa-th-large"/></div>
                        <h3><t t-esc="_t('No dashboards yet')"/></h3>
                        <p><t t-esc="_t('Create a dashboard to start visualizing your data.')"/></p>
                        <button t-if="state.canEdit" class="dd-btn-primary" t-on-click="createNewDashboard">
                            <i class="fa fa-plus"/> <t t-esc="_t('New Dashboard')"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
