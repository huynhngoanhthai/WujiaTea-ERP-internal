<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_dashboard_reports" model="ir.cron">
            <field name="name">Dashboard: Send Scheduled Reports</field>
            <field name="model_id" ref="model_dynamic_dashboard_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reports()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="priority">20</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_compute_kpis" model="ir.cron">
            <field name="name">Dashboard: Compute KPIs &amp; Alerts</field>
            <field name="model_id" ref="model_dynamic_dashboard_kpi"/>
            <field name="state">code</field>
            <field name="code">model._cron_compute_kpis()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="priority">25</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_refresh_marts" model="ir.cron">
            <field name="name">Dashboard: Refresh Data Marts</field>
            <field name="model_id" ref="model_dynamic_dashboard_mart"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_marts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="priority">30</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
