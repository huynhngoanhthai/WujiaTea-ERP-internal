<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Multi-company isolation rules for eh_account_base.
    Auto-generated by hardening pass; one ir.rule per concrete model.
-->
<odoo noupdate="0">
    <data>

        <record id="rule_eh_account_report_execution_company" model="ir.rule">
            <field name="name">eh.account.report.execution: company isolation</field>
            <field name="model_id" ref="model_eh_account_report_execution"/>
            <field name="domain_force">[('scope_accessible', '=', True)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_account_report_saved_view_company" model="ir.rule">
            <field name="name">eh.account.report.saved_view: visible own or shared</field>
            <field name="model_id" ref="model_eh_account_report_saved_view"/>
            <!-- Company isolation, then own-OR-shared. The previous
                 ('user_id','=',user.id) AND clause hid every shared view
                 owned by another user, breaking the shared-view feature.
                 This mirrors saved_view.list_for()'s own domain. -->
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_eh_account_report_saved_view_owner_mutation" model="ir.rule">
            <field name="name">eh.account.report.saved_view: owner mutation</field>
            <field name="model_id" ref="model_eh_account_report_saved_view"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_eh_account_report_annotation_company" model="ir.rule">
            <field name="name">eh.account.report.annotation: company isolation</field>
            <field name="model_id" ref="model_eh_account_report_annotation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_account_report_wizard_company" model="ir.rule">
            <field name="name">eh.account.report.wizard: company isolation</field>
            <field name="model_id" ref="model_eh_account_report_wizard"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_account_report_fold_state_owner" model="ir.rule">
            <field name="name">eh.account.report.fold.state: owner isolation</field>
            <field name="model_id" ref="model_eh_account_report_fold_state"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
