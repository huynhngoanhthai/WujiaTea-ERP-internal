msgid ""
"%(move)s has approval request %(req)s in state %(state)s. Posting is blocked"
" until the request is approved."
msgstr ""
"%(move)s a une demande d'approbation %(req)s à l'état %(state)s. La "
"comptabilisation est bloquée jusqu'à l'approbation de la demande."

#. module: eh_account_approval
