msgid ""
"%(move)s has approval request %(req)s in state %(state)s. Posting is blocked"
" until the request is approved."
msgstr ""
"%(move)s में %(state)s स्थिति में अनुमोदन अनुरोध %(req)s है। अनुरोध अनुमोदित"
" होने तक पोस्टिंग अवरुद्ध है।"

#. module: eh_account_approval
#. odoo-python
#: code:addons/eh_account_approval/models/account_move.py:0
