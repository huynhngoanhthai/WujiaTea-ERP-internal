msgstr ""
"Você não é um aprovador elegível para a(s) etapa(s) pendente(s) da "
"solicitação %s."

#. module: eh_account_approval
#. odoo-python
#: code:addons/eh_account_approval/models/approval_request.py:0
msgid ""
"You submitted request %s and cannot approve or reject your own request. "
"Segregation of duties requires a different approver to sign off."
msgstr ""
"Você enviou a solicitação %s e não pode aprovar ou rejeitar sua própria "
"solicitação. A segregação de funções exige que um aprovador diferente faça a"
" validação."

