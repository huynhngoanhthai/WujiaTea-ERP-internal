#. module: eh_account_approval
#. odoo-python
#: code:addons/eh_account_approval/models/account_move.py:0
msgid ""
"%(move)s has approval request %(req)s in state %(state)s. Posting is blocked"
" until the request is approved."
msgstr ""
"%(move)s ha una richiesta di approvazione %(req)s nello stato %(state)s. La "
"registrazione è bloccata finché la richiesta non viene approvata."

#. module: eh_account_approval
#. odoo-python
#: code:addons/eh_account_approval/models/account_move.py:0
msgid ""
"%(move)s requires approval per policy %(policy)s before posting. Click "
"'Request Approval' to start."
msgstr ""
"%(move)s richiede l'approvazione in base alla politica %(policy)s prima "
"della registrazione. Fare clic su \"Richiedi approvazione\" per iniziare."

