"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;\">\n"
"                                    ร้องขอโดย\n"
"                                </td>\n"
"                                <td style=\"padding:10px 14px;border-bottom:1px solid #e1e4e8;text-align:right;\" t-out=\"object.requested_by_id.name\"/>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;\">\n"
"                                    ครบกำหนด\n"
"                                </td>\n"
"                                <td style=\"padding:10px 14px;text-align:right;\" t-out=\"object.due_at and object.due_at.strftime('%Y-%m-%d %H:%M') or '(no SLA)'\"/>\n"
"                            </tr>\n"
"                        </table>\n"
"\n"
"                        <p style=\"margin:0 0 18px 0;font-size:14px;line-height:1.55;\">\n"
"                            เปิดคำขอใน Odoo เพื่ออนุมัติ ปฏิเสธ หรือแสดงความคิดเห็น\n"
"                        </p>\n"
"\n"
"                        <div style=\"margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;\">\n"
"                            ERP Heritage Accounting Suite\n"
"                        </div>\n"
"                    </div>\n"
"                </div>"

