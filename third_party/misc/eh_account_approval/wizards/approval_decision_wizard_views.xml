<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_eh_approval_decision_wizard_form" model="ir.ui.view">
        <field name="name">eh.approval.decision.wizard.form</field>
        <field name="model">eh.approval.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Approval Decision">
                <group>
                    <field name="request_id"/>
                    <field name="decision"/>
                    <field name="comment" placeholder="Enter approval comment or rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Record Decision" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
