<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Approval reminder email — sent by the SLA cron when a
            request crosses the reminder threshold. The template
            renders against an eh.approval.request record so the
            approver sees the move number, amount, requester, and
            time remaining inside the body without opening Odoo.

            HTML wrapper uses the suite's brand palette (charcoal
            navy + parchment + amber) and avoids any external CSS
            or webfonts so the email renders identically in
            Outlook desktop, Apple Mail, Gmail, and mobile clients.
        -->

        <record id="email_template_eh_approval_reminder" model="mail.template">
            <field name="name">EH Approval Reminder</field>
            <field name="model_id" ref="model_eh_approval_request"/>
            <field name="subject">Reminder: approval awaiting your sign-off — {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email or user.email }}</field>
            <field name="partner_to">{{ ','.join(str(p.id) for p in object.pending_group_user_ids.mapped('partner_id')) }}</field>
            <field name="lang">{{ object.requested_by_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;background-color:#FBF8F2;font-family:'Segoe UI',Roboto,Arial,sans-serif;color:#1A2C3D;">
                    <div style="max-width:640px;margin:0 auto;padding:24px;background-color:#FBF8F2;">
                        <div style="border-top:3px solid #C9A372;padding-top:18px;">
                            <h1 style="margin:0 0 6px 0;font-size:20px;color:#1A2C3D;letter-spacing:-0.01em;">
                                Approval awaiting your sign-off
                            </h1>
                            <p style="margin:0 0 18px 0;color:#6c757d;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">
                                ERP Heritage Accounting Suite
                            </p>
                        </div>

                        <p style="margin:0 0 14px 0;font-size:15px;line-height:1.55;">
                            Hello,
                        </p>
                        <p style="margin:0 0 14px 0;font-size:15px;line-height:1.55;">
                            <strong t-out="object.name"/> on
                            <strong t-out="object.move_id.name"/> is awaiting
                            sign-off from
                            <strong t-out="object.pending_group_id.name or ', '.join(object.pending_group_user_ids.mapped('name'))"/>.
                        </p>

                        <table style="width:100%;border-collapse:collapse;margin:18px 0;background:#fff;border:1px solid #e1e4e8;border-radius:6px;">
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Amount
                                </td>
                                <td style="padding:10px 14px;font-weight:600;border-bottom:1px solid #e1e4e8;text-align:right;"
                                    t-out="'{:,.2f}'.format(object.submitted_amount or 0.0)"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid #e1e4e8;">
                                    Requested by
                                </td>
                                <td style="padding:10px 14px;border-bottom:1px solid #e1e4e8;text-align:right;"
                                    t-out="object.requested_by_id.name"/>
                            </tr>
                            <tr>
                                <td style="padding:10px 14px;color:#6c757d;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;">
                                    Due
                                </td>
                                <td style="padding:10px 14px;text-align:right;"
                                    t-out="object.due_at and object.due_at.strftime('%Y-%m-%d %H:%M') or '(no SLA)'"/>
                            </tr>
                        </table>

                        <p style="margin:0 0 18px 0;font-size:14px;line-height:1.55;">
                            Open the request in Odoo to approve, reject, or comment.
                        </p>

                        <div style="margin-top:32px;padding-top:14px;border-top:1px solid #C9A372;text-align:center;font-size:11px;color:#6c757d;letter-spacing:0.05em;">
                            ERP Heritage Accounting Suite
                        </div>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>
