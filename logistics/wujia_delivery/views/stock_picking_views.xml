<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_wujia_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.wujia.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="franchise_id" options="{'no_create_edit': True}"/>
                <field name="area_id" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Dispatch" name="wujia_delivery">
                    <group>
                        <group string="Trip">
                            <field name="batch_id" readonly="1"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="provider_id" readonly="1"/>
                            <field name="delivery_sequence"/>
                            <field name="delivery_status" widget="badge"
                                   decoration-info="delivery_status in ('assigned', 'loaded')"
                                   decoration-warning="delivery_status == 'delivering'"
                                   decoration-success="delivery_status == 'done'"
                                   decoration-muted="delivery_status == 'cancelled'"/>
                        </group>
                        <group string="Cost (allocated)">
                            <field name="shipping_cost" readonly="1"/>
                            <field name="drop_fee" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="delivery_note" placeholder="Delivery note for this trip..."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree_wujia_delivery" model="ir.ui.view">
        <field name="name">stock.picking.list.wujia.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="franchise_id" optional="show"/>
                <field name="area_id" optional="hide"/>
                <field name="vehicle_id" optional="hide"/>
                <field name="delivery_status" optional="hide" widget="badge"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_search_wujia_delivery" model="ir.ui.view">
        <field name="name">stock.picking.search.wujia.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="franchise_id"/>
                <field name="area_id"/>
                <field name="vehicle_id"/>
                <field name="provider_id"/>
            </xpath>
            <xpath expr="//filter[@name='available']" position="after">
                <separator/>
                <filter string="Waiting for dispatch" name="filter_pending_delivery"
                        domain="[('delivery_status', '=', 'pending')]"/>
                <filter string="In transit" name="filter_delivering"
                        domain="[('delivery_status', '=', 'delivering')]"/>
                <filter string="Has a franchise store" name="filter_has_franchise"
                        domain="[('franchise_id', '!=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Store" name="group_franchise"
                        context="{'group_by': 'franchise_id'}"/>
                <filter string="Area" name="group_area"
                        context="{'group_by': 'area_id'}"/>
                <filter string="Carrier" name="group_provider"
                        context="{'group_by': 'provider_id'}"/>
                <filter string="Delivery status" name="group_delivery_status"
                        context="{'group_by': 'delivery_status'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_stock_picking_wujia_delivery" model="ir.actions.act_window">
        <field name="name">Delivery Orders</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_id.code', '=', 'outgoing')]</field>
        <field name="context">{'search_default_filter_has_franchise': 1, 'contact_display': 'partner_address'}</field>
    </record>

    <!-- BE-003: Dedicated List View for Pending Dispatch (Phiếu chờ sắp xe) -->
    <record id="view_stock_picking_tree_pending_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.tree.pending.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Pending Dispatch" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="franchise_id" optional="show"/>
                <field name="partner_state_id" optional="show"/>
                <field name="area_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="location_dest_id" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="planned_weight" optional="show" widget="float"/>
                <field name="state" optional="show" widget="badge"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state in ('confirmed', 'waiting')"/>
                <field name="origin" optional="show"/>
                <field name="batch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- BE-003: Dedicated Search View for Pending Dispatch -->
    <record id="view_stock_picking_search_pending_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.search.pending.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Pending Dispatch">
                <field name="name" string="Transfer" filter_domain="['|', ('name', 'ilike', self), ('origin', 'ilike', self)]"/>
                <field name="franchise_id"/>
                <field name="partner_id"/>
                <field name="partner_state_id"/>
                <field name="area_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="picking_type_id"/>
                <field name="origin"/>
                <separator/>
                <filter string="Due Today / Overdue" name="filter_due_or_overdue"
                        domain="['|', ('scheduled_date', '&lt;=', current_date), ('scheduled_date', '=', False)]"/>
                <separator/>
                <filter string="Waiting" name="filter_waiting"
                        domain="[('state', 'in', ('waiting', 'confirmed'))]"/>
                <filter string="Ready" name="filter_ready"
                        domain="[('state', '=', 'assigned')]"/>
                <separator/>
                <group>
                    <filter string="Scheduled Date" name="group_scheduled_date"
                            context="{'group_by': 'scheduled_date:day'}"/>
                    <filter string="Province/State" name="group_province"
                            context="{'group_by': 'partner_state_id'}"/>
                    <filter string="Area" name="group_area"
                            context="{'group_by': 'area_id'}"/>
                    <filter string="Franchise Store" name="group_franchise"
                            context="{'group_by': 'franchise_id'}"/>
                    <filter string="Source Location" name="group_location"
                            context="{'group_by': 'location_id'}"/>
                    <filter string="Operation Type" name="group_picking_type"
                            context="{'group_by': 'picking_type_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- BE-003: Action Phiếu chờ sắp xe — requires_transport_planning=True, batch_id=False, state in ('waiting','confirmed','assigned') -->
    <record id="action_stock_picking_pending_dispatch" model="ir.actions.act_window">
        <field name="name">Pending Dispatch</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('batch_id', '=', False),
            ('state', 'in', ('waiting', 'confirmed', 'assigned')),
            ('picking_type_id.requires_transport_planning', '=', True)
        ]</field>
        <field name="context">{
            'search_default_filter_due_or_overdue': 1,
            'contact_display': 'partner_address'
        }</field>
        <field name="search_view_id" ref="view_stock_picking_search_pending_dispatch"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_stock_picking_tree_pending_dispatch')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pickings waiting for transport planning</p>
            <p>Pickings requiring transport planning that are waiting, confirmed, or assigned, and not yet added to a batch.</p>
        </field>
    </record>

    <!-- BE-002: Theo dõi giao hàng — all outgoing, group by store/vehicle/batch/date -->
    <record id="action_stock_picking_delivery_tracking" model="ir.actions.act_window">
        <field name="name">Delivery Tracking</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_id.code', '=', 'outgoing')]</field>
        <field name="context">{'contact_display': 'partner_address'}</field>
        <field name="search_view_id" ref="view_stock_picking_search_wujia_delivery"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No delivery orders found</p>
            <p>Track all outgoing deliveries. Group by Store, Vehicle, Batch or Date.</p>
        </field>
    </record>

</odoo>
