<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        BE-002: wujia_delivery menu items — mounted under wujia_fleet's 4-group structure.
          Group 1: Dispatch
            - Pending Dispatch Pickings  (NEW action)
            - Batches
            - Delivery Tracking          (NEW action)
          Group 4: Reports
            - Carrier Expense Report
            - Franchise Shipping Cost Report
    -->

    <!-- Set default action of Root App menu to Pending Dispatch -->
    <menuitem id="wujia_fleet.menu_wujia_fleet_root"
              action="action_stock_picking_pending_dispatch"/>

    <!-- ── Group 1: Dispatch ─────────────────────────────────── -->
    <menuitem id="menu_wujia_delivery_pending_dispatch"
              name="Pending Dispatch"
              parent="wujia_fleet.menu_wujia_fleet_dispatch_root"
              action="action_stock_picking_pending_dispatch"
              sequence="10"/>

    <menuitem id="menu_wujia_delivery_batch"
              name="Batches"
              parent="wujia_fleet.menu_wujia_fleet_dispatch_root"
              action="action_stock_picking_batch_wujia_delivery"
              sequence="20"/>

    <menuitem id="menu_wujia_delivery_tracking"
              name="Delivery Tracking"
              parent="wujia_fleet.menu_wujia_fleet_dispatch_root"
              action="action_stock_picking_delivery_tracking"
              sequence="30"/>

    <!-- ── Group 4: Reports ───────────────────────────────────── -->
    <menuitem id="menu_wujia_delivery_report_fleet"
              name="Carrier Expense Report"
              parent="wujia_fleet.menu_wujia_fleet_report_root"
              action="action_wujia_fleet_shipping_report"
              sequence="10"/>

    <menuitem id="menu_wujia_delivery_report_franchise"
              name="Franchise Shipping Cost Report"
              parent="wujia_fleet.menu_wujia_fleet_report_root"
              action="action_wujia_franchise_shipping_report"
              sequence="20"/>

</odoo>
