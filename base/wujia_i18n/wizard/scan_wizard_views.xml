<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wujia_i18n_scan_wizard_form" model="ir.ui.view">
        <field name="name">wujia.i18n.scan.wizard.form</field>
        <field name="model">wujia.i18n.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan terms">
                <p class="text-muted">Reads the strings of the selected modules (same source as the .pot export) and adds them to the catalog. Edited translations are never overwritten.</p>
                <group>
                    <field name="module_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="lang_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_scan" type="object" string="Scan" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wujia_i18n_scan_wizard" model="ir.actions.act_window">
        <field name="name">Scan terms</field>
        <field name="res_model">wujia.i18n.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
