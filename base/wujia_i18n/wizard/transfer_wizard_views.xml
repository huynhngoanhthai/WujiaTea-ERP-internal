<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wujia_i18n_transfer_wizard_form" model="ir.ui.view">
        <field name="name">wujia.i18n.transfer.wizard.form</field>
        <field name="model">wujia.i18n.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Import / export translations">
                <field name="mode" invisible="1"/>
                <div invisible="mode != 'import'">
                    <p class="text-muted">CSV with columns key,option,VN,CN,TH (the option column may be missing). Rows are matched by reference, otherwise by source text. Identical translations are skipped.</p>
                    <group>
                        <field name="file" filename="filename" required="mode == 'import'"/>
                        <field name="filename" invisible="1"/>
                        <field name="overwrite_edited"/>
                        <field name="src_mode" widget="radio"/>
                        <field name="apply_now"/>
                    </group>
                </div>
                <div invisible="mode != 'export'">
                    <p class="text-muted">The .po zip is for developers: copy each module's i18n folder into the source, commit, deploy, then restart so Python/JavaScript strings take effect.</p>
                    <group>
                        <field name="export_format" widget="radio"/>
                        <field name="module_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="lang_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="only_edited" invisible="export_format != 'csv'"/>
                    </group>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" invisible="mode != 'import'"/>
                    <button name="action_export" type="object" string="Export" class="btn-primary" invisible="mode != 'export'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wujia_i18n_import_wizard" model="ir.actions.act_window">
        <field name="name">Import translations</field>
        <field name="res_model">wujia.i18n.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'import'}</field>
    </record>

    <record id="action_wujia_i18n_export_wizard" model="ir.actions.act_window">
        <field name="name">Export translations</field>
        <field name="res_model">wujia.i18n.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'export'}</field>
    </record>
</odoo>
