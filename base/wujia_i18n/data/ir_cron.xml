<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- J-T5: chạy khi wizard "Machine translate" xếp hàng (_trigger); lịch ngày chỉ là lưới an toàn. -->
    <record id="ir_cron_wujia_i18n_mt" model="ir.cron">
        <field name="name">Translation Tool: machine translation queue</field>
        <field name="model_id" ref="model_wujia_i18n_value"/>
        <field name="state">code</field>
        <field name="code">model._wj_mt_run_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
