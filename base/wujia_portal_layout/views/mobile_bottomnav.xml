<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- WJ_Mobile_FooterActionBar (BA UI Component Registry v3 §2.10) — thanh điều
         hướng dưới cùng, dùng chung mọi trang portal (Sprint 11, item 10.1).
         Mobile-only (d-lg-none); desktop không đổi.

         F5a: khung chỉ giữ nút "Thêm" + sheet; TAB và DÒNG SHEET do module sở hữu
         route chèn vào (`position="before"` nút Thêm / dòng Tài khoản, thứ tự theo
         priority). Tab nào sáng thì bật cờ `_bnav_hit`; nút "Thêm" render SAU CÙNG
         nên đọc được cờ đủ và sáng khi KHÔNG tab nào sáng (hành vi Sprint 11).
         Phải là CỜ, không phải danh sách tiền tố: tab Trang chủ khớp TUYỆT ĐỐI
         '/portal' nên nếu góp tiền tố thì mọi route con đều "khớp" và "Thêm" chết.
         `t-set` bên trong `t-call` không ra được scope ngoài nên phải làm thế này. -->
    <template id="mobile_bottomnav" name="Wujia Mobile — Footer Action Bar">
        <t t-set="_bnav_path" t-value="request.httprequest.path or ''"/>
        <t t-set="_bnav_hit" t-value="False"/>
        <nav class="wujia-mhome-bottomnav d-lg-none">
            <!-- Tab của module chèn vào đây, trước nút "Thêm". -->
            <!-- "Thêm" mở sheet; wujia_mobile_more_sheet.js bắt [data-wujia-more].
                 <button> để Space kích hoạt được (WJ-PORTAL-UI-004). -->
            <button type="button" data-wujia-more="toggle" aria-haspopup="dialog"
                    aria-expanded="false"
                    t-attf-class="wujia-mhome-nav-item #{not _bnav_hit and 'is-active' or ''}">
                <i class="feather icon-grid"/>
                <span class="wujia-mhome-nav-label">More</span>
            </button>
        </nav>

        <!-- WJ_Mobile_MoreBottomSheet_Simple_v1 (Figma WJ_MoreBottom 4477:242) —
             sheet nằm trên thanh nav cố định, backdrop phủ phần còn lại. Ẩn cho tới
             khi JS thêm .is-open. Dùng thẻ <a> thuần: điều hướng tải lại trang nên
             sheet tự đóng. -->
        <div class="wujia-msheet-backdrop d-lg-none" data-wujia-more="close"/>
        <div class="wujia-msheet d-lg-none" role="dialog" aria-modal="true" aria-label="More features">
            <div class="wujia-msheet-handle"/>
            <button type="button" class="wujia-msheet-close" data-wujia-more="close" aria-label="Close">
                <i class="feather icon-x"/>
            </button>
            <div class="wujia-msheet-title">More features</div>
            <div class="wujia-msheet-subtitle">Other tools for your store</div>
            <div class="wujia-msheet-list">
                <!-- CMP-SN-001: dòng của module chèn TRƯỚC neo ẩn `msheet_end`, thứ tự theo
                     priority. Tài khoản / Hồ sơ cửa hàng nằm ở avatar, không có trong sheet (BA:
                     tránh trùng). Neo là phần tử có id bền — neo theo vị trí (`/a[1]`) sẽ đảo thứ tự
                     khi nhiều module cùng chèn. -->
                <span id="msheet_end" hidden="hidden"/>
            </div>
        </div>
    </template>

</odoo>
