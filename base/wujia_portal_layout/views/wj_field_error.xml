<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ô lỗi dưới một control: id `<fe_for>-err`, ẩn tới khi lỗi (server: fe_show; client: wj_form_validate.js). -->
    <template id="wj_field_error" name="Wujia — Field error">
        <p t-att-id="'%s-err' % fe_for" class="wj-field-error" t-att-hidden="None if fe_show else 'hidden'">
            <i class="feather icon-alert-circle wj-field-error__icon" aria-hidden="true"/>
            <span t-out="fe_msg"/>
        </p>
    </template>

    <!-- Hộp tổng lỗi đầu form: danh sách + link do wj_form_validate.js dựng; `{n}` = số ô lỗi. -->
    <template id="wj_error_summary" name="Wujia — Form error summary">
        <t t-set="_es_title">Please fix {n} field(s) below.</t>
        <div class="wj-error-summary" role="alert" tabindex="-1" hidden="hidden"
             data-wj-error-summary="1" t-att-data-wj-msg-title="_es_title">
            <i class="feather icon-alert-circle wj-error-summary__icon" aria-hidden="true"/>
            <div class="wj-error-summary__body">
                <p class="wj-error-summary__title"/>
                <ul class="wj-error-summary__list"/>
            </div>
        </div>
    </template>

</odoo>
