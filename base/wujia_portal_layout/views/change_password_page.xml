<odoo>
    <data>
        <template id="wujia_portal_layout.change_password_page">
            <t t-call="wujia_portal_layout.app_layout">
                <t t-set="pc_width" t-value="'standard'"/>

                <!-- ===== Desktop (>=992px) — Figma wujia_pc_05..08_change_password_v3.
                     4 state qua error/message; viền đỏ field suy từ nội dung error. ===== -->
                <t t-set="acct_page" t-value="'password'"/>
                <t t-set="acct_title">Change password</t>
                <t t-set="acct_subtitle">Secure your portal account</t>
                <t t-set="acct_store_code" t-value="franchise_code"/>
                <t t-set="acct_store_name" t-value="franchise_name"/>
                <t t-set="acct_role_label" t-value="role_label"/>
                <t t-set="err_old" t-value="error_field == 'old'"/>
                <t t-set="err_confirm" t-value="error_field == 'confirm'"/>
                <t t-set="err_new" t-value="error_field == 'new'"/>

                <t t-call="wujia_portal_layout.pc_account_layout">
                    <div t-if="error" class="wj-pc-acct-banner is-error" role="alert" t-out="error"/>
                    <div t-if="message" class="wj-pc-acct-banner is-ok" role="status" t-out="message"/>

                    <div class="wj-pc-acct-pw-grid">
                        <!-- Form card -->
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_class" t-value="'wj-pc-card'"/>
                            <div class="wj-pc-card__head">
                                <div>
                                    <h3 class="wj-pc-acct-panel-title">Password details</h3>
                                    <p class="wj-pc-acct-panel-sub">Enter your current and new password to update your account.</p>
                                </div>
                            </div>
                            <form method="POST" class="novalidate wj-pc-acct-pw-form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="wj-pc-acct-pw-field">
                                    <label for="pc-old-password">Current password</label>
                                    <div t-attf-class="wj-pc-acct-pw-input #{err_old and 'is-error' or ''}">
                                        <input type="password" id="pc-old-password" name="old-password"
                                               class="wj-pc-control" placeholder="••••••••" required="required"/>
                                        <button type="button" class="wj-pc-acct-eye" data-wujia-pwd-toggle="true">Show</button>
                                    </div>
                                    <span t-if="err_old" class="wj-pc-acct-field-err">Current password is incorrect.</span>
                                </div>

                                <div class="wj-pc-acct-pw-field">
                                    <label for="pc-new-password">New password</label>
                                    <div t-attf-class="wj-pc-acct-pw-input #{err_new and 'is-error' or ''}">
                                        <input type="password" id="pc-new-password" name="new-password"
                                               class="wj-pc-control" placeholder="At least 8 characters"
                                               minlength="8" required="required"/>
                                        <button type="button" class="wj-pc-acct-eye" data-wujia-pwd-toggle="true">Show</button>
                                    </div>
                                    <span t-if="err_new" class="wj-pc-acct-field-err" t-out="error"/>
                                </div>

                                <div class="wj-pc-acct-pw-field">
                                    <label for="pc-con-password">Confirm new password</label>
                                    <div t-attf-class="wj-pc-acct-pw-input #{err_confirm and 'is-error' or ''}">
                                        <input type="password" id="pc-con-password" name="con-password"
                                               class="wj-pc-control" placeholder="Re-enter new password"
                                               minlength="8" required="required"/>
                                        <button type="button" class="wj-pc-acct-eye" data-wujia-pwd-toggle="true">Show</button>
                                    </div>
                                    <span t-if="err_confirm" class="wj-pc-acct-field-err">Password confirmation does not match.</span>
                                </div>

                                <div class="wj-pc-acct-pw-actions">
                                    <a href="/portal/change-password" class="wj-btn wj-btn--secondary">Cancel</a>
                                    <button type="submit"
                                            t-attf-class="wj-btn wj-btn--primary #{message and 'is-disabled' or ''}">
                                        Save password
                                    </button>
                                </div>
                            </form>
                        </t>

                        <!-- Aside: security tips + help -->
                        <div style="display:flex;flex-direction:column;gap:24px;">
                            <t t-call="wujia_portal_layout.wj_surface_card">
                                <t t-set="sc_class" t-value="'wj-pc-card'"/>
                                <div class="wj-pc-card__head">
                                    <h3 class="wj-pc-acct-panel-title">Security tips</h3>
                                </div>
                                <ul class="wj-pc-acct-sec-list">
                                    <li>Use at least 8 characters for your new password.</li>
                                    <li>Mix letters, numbers and special characters.</li>
                                    <li>Do not reuse easy-to-guess passwords.</li>
                                    <li>Do not share your password via messages or group chats.</li>
                                </ul>
                            </t>
                            <t t-call="wujia_portal_layout.wj_surface_card">
                                <t t-set="sc_class" t-value="'wj-pc-card'"/>
                                <div class="wj-pc-card__head">
                                    <h3 class="wj-pc-acct-panel-title">Need help?</h3>
                                </div>
                                <t t-set="wj_txt">If you forgot your current password or your account is locked, please contact the {brand} administrator for help.</t>
                                <p class="wj-pc-acct-help-text" t-out="wj_txt.replace('{brand}', wj_brand['name'])"/>
                                <div class="wj-pc-acct-help-note">Support requests are handled according to account permissions.</div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- ===== Mobile (<992px) — Figma Mobile_Account_Info màn 03 "Đổi mật khẩu".
                     BlankShell .wujia-mpage NGOÀI .content-wrapper. POST cùng route
                     /portal/change-password (field old-/new-/con-password GIỮ NGUYÊN). ===== -->
                <div class="d-lg-none wujia-mpage wujia-maccount">
                    <t t-call="wujia_portal_layout.wj_page_header">
                        <t t-set="ph_platform" t-value="'m'"/>
                        <t t-set="ph_variant" t-value="'title'"/>
                        <t t-set="ph_title">Change password</t>
                    </t>

                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_variant" t-value="'section'"/>
                        <t t-set="sc_class" t-value="'wujia-mdash-card'"/>
                        <h2 class="wujia-maccount-cardtitle">Password details</h2>

                        <div t-if="error" class="wujia-maccount-alert is-error" role="alert" t-out="error"/>
                        <div t-if="message" class="wujia-maccount-alert is-ok" role="status" t-out="message"/>

                        <form method="POST" class="wujia-maccount-form novalidate">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="wujia-maccount-field">
                                <label for="m-old-password">Current password</label>
                                <div class="wujia-maccount-pwd">
                                    <input type="password" id="m-old-password" name="old-password"
                                           class="wujia-maccount-input" placeholder="••••••••"
                                           required="required"/>
                                    <button type="button" class="wujia-maccount-eye"
                                            data-wujia-pwd-toggle="true" aria-label="Show/hide password">
                                        <i class="feather icon-eye"/>
                                    </button>
                                </div>
                            </div>

                            <div class="wujia-maccount-field">
                                <label for="m-new-password">New password</label>
                                <div class="wujia-maccount-pwd">
                                    <input type="password" id="m-new-password" name="new-password"
                                           class="wujia-maccount-input" placeholder="••••••••"
                                           minlength="8" required="required"/>
                                    <button type="button" class="wujia-maccount-eye"
                                            data-wujia-pwd-toggle="true" aria-label="Show/hide password">
                                        <i class="feather icon-eye"/>
                                    </button>
                                </div>
                            </div>

                            <div class="wujia-maccount-field">
                                <label for="m-con-password">Re-enter new password</label>
                                <div class="wujia-maccount-pwd">
                                    <input type="password" id="m-con-password" name="con-password"
                                           class="wujia-maccount-input" placeholder="••••••••"
                                           minlength="8" required="required"/>
                                    <button type="button" class="wujia-maccount-eye"
                                            data-wujia-pwd-toggle="true" aria-label="Show/hide password">
                                        <i class="feather icon-eye"/>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="wj-btn wj-btn--primary wj-btn--lg wj-btn--block wujia-maccount-submit">
                                Save password
                            </button>
                        </form>
                    </t>
                </div>
            </t>
        </template>
    </data>
</odoo>
