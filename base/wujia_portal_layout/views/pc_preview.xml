<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sprint PC-1 — dev-only gallery of the wj-pc-* desktop component layer.
         Reference for QA vs BA pc_source_ui_v1_4 SVGs + screen-rework copy source. -->
    <template id="pc_preview_page" name="Wujia PC — Component Gallery (dev)">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="title">PC Components (dev)</t>
            <div class="content-wrapper">
                <div class="wj-pc-preview" style="max-width:1320px;margin:0 auto;padding:8px 0 64px;">

                    <!-- Page header -->
                    <div class="wj-pc-page-header">
                        <div>
                            <h1 class="wj-pc-page-header__title">PC Component Gallery</h1>
                            <p class="wj-pc-page-header__crumb">Sprint PC-1 · BA pc_source_ui_v1_4 · dev-only</p>
                        </div>
                        <div class="wj-pc-page-header__actions">
                            <a href="#" class="wj-pc-btn wj-pc-btn--secondary"><i class="feather icon-download"/>Export</a>
                            <a href="#" class="wj-pc-btn wj-pc-btn--primary"><i class="feather icon-plus"/>Create</a>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Buttons (h42 · radius 12)</h5>
                    <div style="display:flex;gap:12px;flex-wrap:wrap;">
                        <a href="#" class="wj-pc-btn wj-pc-btn--primary"><i class="feather icon-plus"/>Create</a>
                        <a href="#" class="wj-pc-btn wj-pc-btn--secondary"><i class="feather icon-download"/>Export</a>
                        <a href="#" class="wj-pc-btn wj-pc-btn--primary"><i class="feather icon-search"/>Find</a>
                        <a href="#" class="wj-pc-btn wj-pc-btn--secondary">Reset</a>
                        <a href="#" class="wj-pc-btn wj-pc-btn--ghost">View</a>
                        <a href="#" class="wj-pc-btn wj-pc-btn--danger">Delete</a>
                    </div>

                    <!-- Status badges -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Status badges CMP-SB-001 (h28 · min-w84 · r14 · 13/600)</h5>
                    <div style="display:flex;gap:12px;flex-wrap:wrap;">
                        <span class="wj-status-badge wj-status-badge--pending">Submitted</span>
                        <span class="wj-status-badge wj-status-badge--processing">Delivering</span>
                        <span class="wj-status-badge wj-status-badge--success">Finished</span>
                        <span class="wj-status-badge wj-status-badge--pending">Awaiting confirmation</span>
                        <span class="wj-status-badge wj-status-badge--danger">Cancelled</span>
                    </div>

                    <!-- Metric cards -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Metric cards (h96 · icon 52)</h5>
                    <div class="wj-pc-metric-grid">
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-pc-metric-card__icon--blue"><i class="feather icon-shopping-bag"/></span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Today's orders</span>
                                <span class="wj-pc-metric-card__value">12</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-pc-metric-card__icon--yellow"><i class="feather icon-clock"/></span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Processing</span>
                                <span class="wj-pc-metric-card__value">08</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-pc-metric-card__icon--green"><i class="feather icon-check-circle"/></span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Finished</span>
                                <span class="wj-pc-metric-card__value">36</span>
                            </span>
                        </t>
                        <t t-call="wujia_portal_layout.wj_surface_card">
                            <t t-set="sc_variant" t-value="'summary'"/>
                            <t t-set="sc_body" t-value="'flush'"/>
                            <t t-set="sc_class" t-value="'wj-pc-metric-card'"/>
                            <span class="wj-pc-metric-card__icon wj-pc-metric-card__icon--red"><i class="feather icon-alert-circle"/></span>
                            <span class="wj-pc-metric-card__body">
                                <span class="wj-pc-metric-card__label">Needs attention</span>
                                <span class="wj-pc-metric-card__value">03</span>
                            </span>
                        </t>
                    </div>

                    <!-- Filter bar -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Filter bar (CMP-FB-001 · control h42)</h5>
                    <t t-call="wujia_portal_layout.wj_filter_bar">
                        <t t-set="fb_platform" t-value="'pc'"/>
                        <t t-set="fb_action" t-value="'/portal/_pc-preview'"/>
                        <t t-set="wj_fb_ph">Search by order code, product name, content...</t>
                        <t t-set="fb_search" t-value="{'name': 'q', 'placeholder': wj_fb_ph}"/>
                        <t t-set="fb_dates" t-value="{'from': '', 'to': ''}"/>
                        <t t-set="wj_fb_all">Status</t>
                        <t t-set="wj_fb_draft">Draft</t>
                        <t t-set="wj_fb_sale">Confirmed</t>
                        <t t-set="fb_selects"
                           t-value="[{'name': 'state', 'all_label': wj_fb_all,
                                      'options': [('draft', wj_fb_draft), ('sale', wj_fb_sale)]}]"/>
                        <t t-set="fb_reset_url" t-value="'/portal/_pc-preview'"/>
                    </t>

                    <!-- Data table -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Data table (header 50 · row 58)</h5>
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_class" t-value="'wj-pc-card'"/>
                        <div class="wj-pc-card__head">
                            <div>
                                <h3 class="wj-pc-card__title">Order list</h3>
                                <p class="wj-pc-card__subtitle">Track purchase orders of the active store</p>
                            </div>
                            <a href="#" class="wj-pc-btn wj-pc-btn--primary"><i class="feather icon-plus"/>Create</a>
                        </div>
                        <table class="wj-pc-table">
                            <thead>
                                <tr>
                                    <th>Code</th><th>Content</th><th>Date</th>
                                    <th>Status</th><th>Amount</th><th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="wj-pc-td--code">SO0241</td>
                                    <td>Ingredient purchase order</td>
                                    <td class="wj-pc-td--muted">10/06/2026</td>
                                    <td><span class="wj-status-badge wj-status-badge--pending">Submitted</span></td>
                                    <td class="wj-pc-td--amount">2,450,000 VND</td>
                                    <td><a href="#" class="wj-pc-link">View</a></td>
                                </tr>
                                <tr>
                                    <td class="wj-pc-td--code">SO0240</td>
                                    <td>Packaging top-up</td>
                                    <td class="wj-pc-td--muted">09/06/2026</td>
                                    <td><span class="wj-status-badge wj-status-badge--processing">Delivering</span></td>
                                    <td class="wj-pc-td--amount">860,000 VND</td>
                                    <td><a href="#" class="wj-pc-link">View</a></td>
                                </tr>
                                <tr>
                                    <td class="wj-pc-td--code">SO0239</td>
                                    <td>Week 24 recurring order</td>
                                    <td class="wj-pc-td--muted">08/06/2026</td>
                                    <td><span class="wj-status-badge wj-status-badge--success">Finished</span></td>
                                    <td class="wj-pc-td--amount">4,120,000 VND</td>
                                    <td><a href="#" class="wj-pc-link">View</a></td>
                                </tr>
                                <tr>
                                    <td class="wj-pc-td--code">SO0238</td>
                                    <td>June POSM</td>
                                    <td class="wj-pc-td--muted">05/06/2026</td>
                                    <td><span class="wj-status-badge wj-status-badge--pending">Awaiting confirmation</span></td>
                                    <td class="wj-pc-td--amount">1,340,000 VND</td>
                                    <td><a href="#" class="wj-pc-link">View</a></td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- Pagination — component thật CMP-PGNT-001 (pgn do controller dựng) -->
                        <t t-call="wujia_portal_layout.wj_pagination"/>
                    </t>

                    <!-- Form fields -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Form fields (h42)</h5>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:680px;">
                        <div class="wj-pc-field">
                            <label class="wj-pc-field__label">Store name</label>
                            <input type="text" class="wj-pc-control" placeholder="Enter store name"/>
                        </div>
                        <div class="wj-pc-field">
                            <label class="wj-pc-field__label">Status</label>
                            <select class="wj-pc-control"><option>Select status</option></select>
                        </div>
                        <div class="wj-pc-field" style="grid-column:1 / -1;">
                            <label class="wj-pc-field__label">Note</label>
                            <textarea class="wj-pc-control" placeholder="Textarea / note"/>
                        </div>
                    </div>

                    <!-- Empty state -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Empty state</h5>
                    <div class="wj-pc-empty" style="max-width:720px;">
                        <span class="wj-pc-empty__icon"><i class="feather icon-file-text"/></span>
                        <h3 class="wj-pc-empty__title">No data yet</h3>
                        <p class="wj-pc-empty__sub">Records will appear here once available.</p>
                        <a href="#" class="wj-pc-btn wj-pc-btn--primary"><i class="feather icon-plus"/>Create</a>
                    </div>

                    <!-- Modal (inline preview — backdrop tint shown as a relative box) -->
                    <h5 style="margin:24px 0 12px;color:#6B7280;">Modal (panel 420 · backdrop #111827/0.18)</h5>
                    <div style="position:relative;background:rgba(17,24,39,0.18);border-radius:16px;padding:40px;display:flex;justify-content:center;">
                        <div class="wj-pc-modal__panel">
                            <h3 class="wj-pc-modal__title">Confirm action</h3>
                            <p class="wj-pc-modal__body">Are you sure you want to perform this action?</p>
                            <hr class="wj-pc-modal__divider"/>
                            <div class="wj-pc-modal__note">A summary or warning is shown here.</div>
                            <div class="wj-pc-modal__actions">
                                <a href="#" class="wj-pc-btn wj-pc-btn--secondary">Cancel</a>
                                <a href="#" class="wj-pc-btn wj-pc-btn--primary">Confirm</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
