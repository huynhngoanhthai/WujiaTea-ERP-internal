<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WJ_PageHeader — component chuẩn hoá header portal (spec WJ_PageHeader v1.0).
         3 variant: title / back / create. Gọi trong từng block nền tảng bằng t-call,
         truyền props qua t-set. ph_platform='m' (mobile) | 'pc'. Visibility (d-lg-none /
         d-none d-lg-flex) bake sẵn — an toàn đặt trong block đã responsive.
         ph_crumb (tuỳ chọn, CHỈ pc): breadcrumb "Cha / Con" trên tiêu đề — nav riêng ngoài
         <header> để giữ nguyên flex-row bên trong (UI-PC-BASE-007). -->
    <template id="wj_page_header" name="Wujia — Page Header component">
        <t t-set="_ph_vis" t-value="'d-flex d-lg-none' if ph_platform == 'm' else 'd-none d-lg-flex'"/>
        <nav t-if="ph_crumb and ph_platform == 'pc'" class="wj-page-header__crumb d-none d-lg-block"
             aria-label="Breadcrumb" t-out="ph_crumb"/>
        <header t-attf-class="wj-page-header wj-page-header--#{ph_platform} wj-page-header--#{ph_variant or 'title'} #{_ph_vis}">
            <!-- CMP-BPH-001: href qua _wj_back_url (return_url validated → referer list cha
                 giữ filter/page → fallback list cha). Icon arrow-left ở PC, chevron ở mobile. -->
            <a t-if="ph_variant == 'back'"
               t-att-href="request.env['ir.http']._wj_back_url(ph_back_url)"
               class="wj-page-header__back" aria-label="Back">
                <i t-attf-class="feather icon-#{'arrow-left' if ph_platform == 'pc' else 'chevron-left'}"/>
                <!-- Nhãn chỉ hiện ở PC (nút chữ 122×40); mobile ẩn bằng CSS để giữ nút
                     tròn 42×42 + vùng chạm 44. -->
                <span class="wj-page-header__back-label">Back</span>
            </a>
            <h1 class="wj-page-header__title" t-att-title="ph_title" t-out="ph_title"/>
            <!-- ph_meta (CMP-PG-001): markup thô, KHÔNG bọc element — 3 route có meta là slot
                 swap của wj_ajax_list (replaceWith theo id). Caller tự gắn wj-page-header__meta. -->
            <t t-if="ph_meta" t-out="ph_meta"/>
            <div t-if="ph_variant == 'create' and ph_can_create"
                 class="wj-page-header__actions">
                <a t-att-href="ph_create_url or '#'" class="wj-page-header__create">
                    <i class="feather icon-plus"/>
                    <t t-set="_ph_t_create">Create</t>
                    <span t-out="ph_create_label or _ph_t_create"/>
                </a>
            </div>
        </header>
    </template>
</odoo>
