msgstr "Logo công ty"

#. module: wujia_core
msgid "Company logo, used in the desktop sidebar and login page."
msgstr "Logo công ty, dùng ở thanh bên máy tính và trang đăng nhập."

#. module: wujia_core
msgid "Company name"
msgstr "Tên công ty"

#. module: wujia_core
msgid "Config Settings"
