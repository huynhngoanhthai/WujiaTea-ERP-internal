#. module: wujia_core
msgid "<span class=\"o_stat_text\">View wards</span>"
msgstr ""

#. module: wujia_core
msgid ""
"A ward belongs to a province and can be assigned to a business area to "
"aggregate delivery data."
msgstr ""
"Phường/Xã thuộc tỉnh/thành, có thể gán vào khu vực kinh doanh để tổng hợp dữ"
" liệu giao hàng."

#. module: wujia_core
msgid "Active"
msgstr "Đang hoạt động"

#. module: wujia_core
msgid "Administrative code, e.g. 27001."
msgstr "Mã hành chính, ví dụ 27001."

#. module: wujia_core
msgid ""
"An area groups wards for operational purposes: delivery, store management, "
"reporting."
msgstr ""
"Khu vực gom nhóm các phường/xã cho mục đích vận hành: giao hàng, quản lý cửa"
" hàng, báo cáo."

#. module: wujia_core
msgid "Archived"
msgstr "Lưu trữ"

#. module: wujia_core
msgid "Area"
msgstr "Khu vực"

