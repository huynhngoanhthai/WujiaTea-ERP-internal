#. module: wujia_core
#. odoo-python
#: code:addons/wujia_core/models/res_company.py
msgid "Primary color must be a hex code like #28A9DF."
msgstr "Màu chủ đạo phải là mã hex, ví dụ #28A9DF."

#. module: wujia_core
msgid "Province"
msgstr "Tỉnh/Thành"

#. module: wujia_core
msgid "Provinces aggregated from the wards of this area — updated automatically."
msgstr "Danh sách tỉnh/thành tổng hợp từ phường/xã thuộc khu vực — cập nhật tự động."

#. module: wujia_core
msgid "Sales / Operation Area"
msgstr "Sales / Operation Area — Khu vực"

#. module: wujia_core
msgid "Sequence"
msgstr "Thứ tự"

#. module: wujia_core
msgid "Shown in the browser tab, logo alt text and login page. Empty = company name."
msgstr ""
"Hiện trên tab trình duyệt, chữ thay thế của logo và trang đăng nhập. Để "
"trống = tên công ty."

#. module: wujia_core
msgid "Square image, at least 180×180. Empty = company logo."
msgstr "Ảnh vuông, tối thiểu 180×180. Để trống = logo công ty."

#. module: wujia_core
msgid "Ward"
msgstr "Ward / Phường — Xã"

#. module: wujia_core
msgid "Ward code"
msgstr "Mã phường/xã"

#. module: wujia_core
msgid "Ward code must be unique within each province."
msgstr "Mã phường/xã phải duy nhất trong từng tỉnh/thành."

#. module: wujia_core
msgid "Ward name"
msgstr "Tên phường/xã"

#. module: wujia_core
msgid "Wards"
msgstr "Phường/Xã"

#. module: wujia_core
msgid "Wards belonging to this area — picked from the res.ward catalog."
msgstr "Danh sách phường/xã thuộc khu vực — chọn từ danh mục res.ward."

#. module: wujia_core
#. odoo-python
#: code:addons/wujia_core/models/res_area.py
#, python-format
msgid "Wards of %s"
msgstr "Phường/Xã thuộc %s"

#. module: wujia_core
msgid "e.g. HCMC districts 1-3"
msgstr "VD: TP HCM Quận 1-3"

#. module: wujia_core
msgid "e.g. KV-HCM-01."
msgstr "Ví dụ KV-HCM-01."

