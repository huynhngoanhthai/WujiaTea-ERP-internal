<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wujia_mobile" model="ir.module.category">
        <field name="name">Wujia Mobile Experience</field>
        <field name="description">Security category for Wujia Mobile UI experience and views.</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_wujia_mobile" model="res.groups.privilege">
        <field name="name">Wujia Mobile Experience Access</field>
        <field name="category_id" ref="module_category_wujia_mobile"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_wujia_mobile_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_wujia_mobile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Grants access to Wujia mobile core UI layouts, responsive views, and components.</field>
    </record>
</odoo>
