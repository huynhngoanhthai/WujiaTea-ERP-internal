<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_compensation_process_wizard_form" model="ir.ui.view">
        <field name="name">wujia.compensation.process.wizard.form</field>
        <field name="model">wujia.compensation.process.wizard</field>
        <field name="arch" type="xml">
            <form string="Process compensation">
                <div class="alert alert-info" role="status"
                     invisible="skipped_count == 0">
                    <field name="skipped_count" class="oe_inline"/> requests skipped (not eligible: not approved / not a compensation / already fully allocated).
                </div>
                <p>
                    Each store will get <b>1 compensation order (zero-value SO)</b>. Delivered quantities are proposed FIFO — open each line to review the allocation and adjust it if needed.
                </p>
                <field name="skipped_count" invisible="1"/>
                <!-- UAT-BH-001: mọi field hiển-thị-để-đọc PHẢI có force_save="1",
                     nếu không web client bỏ khỏi vals khi tạo wizard ⇒ action_confirm
                     nhận nhóm rỗng. Chỉ delivery_qty là ô HQ được sửa. -->
                <field name="group_ids" nolabel="1">
                    <list create="false" delete="false">
                        <field name="franchise_id" readonly="1" force_save="1"/>
                        <field name="compensation_product_id" readonly="1" force_save="1"/>
                        <field name="policy" readonly="1" force_save="1"/>
                        <field name="total_claim_qty" readonly="1" force_save="1"/>
                        <field name="claim_uom_id" readonly="1" force_save="1"/>
                        <field name="suggested_delivery_qty" readonly="1" force_save="1"/>
                        <field name="delivery_qty"/>
                        <field name="delivery_uom_id" readonly="1" force_save="1"/>
                        <field name="unit_qty" column_invisible="1" force_save="1"/>
                    </list>
                    <form string="Compensation SO group">
                        <group>
                            <group>
                                <field name="franchise_id" readonly="1" force_save="1"/>
                                <field name="compensation_product_id" readonly="1" force_save="1"/>
                                <field name="delivery_uom_id" readonly="1" force_save="1"/>
                                <field name="policy" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="claim_uom_id" readonly="1" force_save="1"/>
                                <field name="unit_qty" readonly="1" force_save="1"
                                       invisible="policy != 'accumulate'"/>
                                <field name="total_claim_qty" readonly="1" force_save="1"/>
                                <field name="suggested_delivery_qty" readonly="1" force_save="1"/>
                                <field name="delivery_qty"/>
                            </group>
                        </group>
                        <separator string="FIFO allocation"/>
                        <field name="line_ids" nolabel="1" readonly="1" force_save="1">
                            <list>
                                <field name="request_id" readonly="1" force_save="1"/>
                                <field name="request_remaining_qty" readonly="1" force_save="1"/>
                                <field name="allocate_qty" readonly="1" force_save="1"/>
                                <field name="request_uom_id" readonly="1" force_save="1"/>
                            </list>
                        </field>
                    </form>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Create compensation SO"
                            class="btn-primary"/>
                    <button string="Cancel request" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action "Xử lý bù hàng" trong menu Actions của list Yêu cầu bù hàng -->
    <record id="action_open_compensation_wizard" model="ir.actions.act_window">
        <field name="name">Process compensation</field>
        <field name="res_model">wujia.compensation.process.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_wujia_return_request"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids"
               eval="[(4, ref('wujia_return.group_return_manager'))]"/>
    </record>

</odoo>
