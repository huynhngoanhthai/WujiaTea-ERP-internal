<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Master data: 5 loại lỗi phổ biến (BA). System data, KHÔNG phải demo. -->

    <record id="issue_type_packaging" model="wujia.return.issue.type">
        <field name="code">PKG</field>
        <field name="name">Damaged packaging</field>
        <field name="note">Packaging torn, dented or wet on delivery</field>
        <field name="sequence">10</field>
    </record>

    <record id="issue_type_wrong_product" model="wujia.return.issue.type">
        <field name="code">WRG</field>
        <field name="name">Wrong product</field>
        <field name="note">Delivered product differs from the order</field>
        <field name="sequence">20</field>
    </record>

    <record id="issue_type_expired" model="wujia.return.issue.type">
        <field name="code">EXP</field>
        <field name="name">Expired / near expiry</field>
        <field name="note">Product expired or near expiry per policy</field>
        <field name="sequence">30</field>
    </record>

    <record id="issue_type_short_qty" model="wujia.return.issue.type">
        <field name="code">SHT</field>
        <field name="name">Short quantity</field>
        <field name="note">Delivered less than the ordered quantity</field>
        <field name="sequence">40</field>
    </record>

    <record id="issue_type_other" model="wujia.return.issue.type">
        <field name="code">OTH</field>
        <field name="name">Other issue</field>
        <field name="note">Other cases — describe in the note</field>
        <field name="sequence">99</field>
    </record>

</odoo>
