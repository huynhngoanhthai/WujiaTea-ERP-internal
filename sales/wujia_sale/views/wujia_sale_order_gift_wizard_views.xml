<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wujia_sale_order_gift_wizard_form" model="ir.ui.view">
        <field name="name">wujia.sale.order.gift.wizard.form</field>
        <field name="model">wujia.sale.order.gift.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Gift Products">
                <sheet>
                    <group>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        <label for="quantity"/>
                        <div class="o_row">
                            <field name="quantity" class="oe_inline"/>
                            <field name="uom_id" class="oe_inline"/>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_gift" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wujia_sale_order_gift_wizard" model="ir.actions.act_window">
        <field name="name">Add Gift Products</field>
        <field name="res_model">wujia.sale.order.gift.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
