<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_wujia_order_window_list" model="ir.ui.view">
        <field name="name">wujia.order.window.list</field>
        <field name="model">wujia.order.window</field>
        <field name="arch" type="xml">
            <list string="Ordering time windows" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="area_ids" widget="many2many_tags"/>
                <field name="order_time_from" widget="float_time"/>
                <field name="order_time_to" widget="float_time"/>
                <field name="is_overnight"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_wujia_order_window_form" model="ir.ui.view">
        <field name="name">wujia.order.window.form</field>
        <field name="model">wujia.order.window</field>
        <field name="arch" type="xml">
            <form string="Ordering time windows">
                <sheet>
                    <widget name="web_ribbon" title="Crosses midnight"
                            bg_color="text-bg-warning"
                            invisible="not is_overnight"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="area_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="order_time_from" widget="float_time"/>
                            <field name="order_time_to" widget="float_time"/>
                            <field name="is_overnight"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_wujia_order_window_search" model="ir.ui.view">
        <field name="name">wujia.order.window.search</field>
        <field name="model">wujia.order.window</field>
        <field name="arch" type="xml">
            <search string="Ordering time windows">
                <field name="name"/>
                <field name="area_ids"/>
                <filter name="active" string="In use" domain="[('active','=',True)]"/>
                <filter name="overnight" string="Overnight" domain="[('is_overnight','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wujia_order_window" model="ir.actions.act_window">
        <field name="name">Ordering time windows</field>
        <field name="res_model">wujia.order.window</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_order_window_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an ordering time window</p>
            <p>
                One window can apply to several areas, and an area can have several windows (e.g. Morning + Evening). Hours are checked in each store's own timezone; ordering is allowed while at least one matching window is open. An area without any window falls back to the default configuration in Settings.
            </p>
        </field>
    </record>

    <record id="view_franchise_management_form_order_tz" model="ir.ui.view">
        <field name="name">wujia.franchise.management.form.order.tz</field>
        <field name="model">wujia.franchise.management</field>
        <field name="inherit_id" ref="wujia_franchise.view_franchise_management_form"/>
        <field name="arch" type="xml">
            <field name="area_id" position="after">
                <field name="tz"/>
            </field>
        </field>
    </record>

    <!-- Menu: Sales > Configuration > Wujia Portal > Khung giờ đặt hàng -->
    <menuitem id="menu_wujia_portal_config_root"
              name="Wujia Portal"
              parent="sale.menu_sale_config"
              sequence="50"/>

    <menuitem id="menu_wujia_order_window"
              name="Ordering time windows"
              parent="menu_wujia_portal_config_root"
              action="action_wujia_order_window"
              sequence="10"/>

</odoo>
