#. module: wujia_order_window
#: model_terms:ir.ui.view,arch_db:wujia_order_window.res_config_settings_view_form_wujia_portal_window
msgid ""
"Enable/disable the portal ordering time window. Off = ordering allowed at "
"any time."
msgstr ""
"Bật/tắt giới hạn khung giờ đặt hàng cho portal. Tắt = cho phép đặt mọi lúc."

#. module: wujia_order_window
#: model:ir.model.fields,help:wujia_order_window.field_res_config_settings__portal_order_time_limit_enabled
msgid ""
"Enable/disable the portal ordering time window. When off, ordering is "
"allowed at any time regardless of `wujia.order.window`."
msgstr ""
"Bật/tắt giới hạn khung giờ đặt hàng cho portal. Nếu tắt thì cho phép đặt mọi "
"lúc, bất kể `wujia.order.window`."

#. module: wujia_order_window
#: model:ir.model.constraint,message:wujia_order_window.constraint_wujia_order_window_order_time_to_range
