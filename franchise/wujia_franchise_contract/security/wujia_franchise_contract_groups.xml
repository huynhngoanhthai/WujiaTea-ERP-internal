<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_franchise_contract" model="res.groups.privilege">
        <field name="name">Wujia Franchise Contract</field>
        <field name="category_id" ref="wujia_franchise.module_category_wujia"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_franchise_contract_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_franchise_contract"/>
        <field name="comment">View franchise store contract data.</field>
    </record>

    <record id="group_franchise_contract_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_franchise_contract"/>
        <field name="implied_ids" eval="[(4, ref('group_franchise_contract_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Manage franchise store contracts, create/edit/cancel contracts.</field>
    </record>

</odoo>
