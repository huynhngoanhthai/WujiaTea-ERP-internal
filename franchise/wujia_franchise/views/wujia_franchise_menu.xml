<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Cấu trúc Menu theo bản vẽ thiết kế:
        QUẢN LÝ NHƯỢNG QUYỀN
          ├─ Operation
          │   ├─ Franchise Management   (wujia.franchise.management)
          │   └─ Franchise Member       (wujia.franchise.member)
          ├─ Giám sát cửa hàng
          │   ├─ Phiếu giám sát
          │   ├─ Supervision Schedule
          │   ├─ Franchise Store cần giám sát
          │   ├─ Chờ xử lý khắc phục
          │   ├─ Lịch sử giám sát
          │   ├─ Cấu hình giám sát
          │   │   ├─ Inspection Template         (action_wujia_franchise_inspection_template)
          │   │   ├─ Danh mục tiêu chí           (action_wujia_franchise_inspection_category)
          │   │   ├─ Thư viện câu hỏi kiểm tra
          │   │   └─ Xếp hạng giám sát
          │   └─ Báo cáo
          │       ├─ Phân tích kết quả giám sát
          │       └─ Phân tích tiêu chí vi phạm
          └─ Configuration / Cấu hình
              └─ Area Management
                  ├─ Area
                  ├─ Province / City
                  └─ Ward
    -->

    <menuitem id="menu_wujia_root"
        name="Franchise Management"
        web_icon="wujia_franchise,static/description/icon.png"
        sequence="20"
        groups="group_franchise_user" />

    <!-- 1. Vận hành / Operation -->
    <menuitem id="menu_wujia_operation_root"
        name="Operations"
        parent="menu_wujia_root"
        sequence="10" />

    <menuitem id="menu_wujia_franchise_management"
        name="Franchise Management"
        parent="menu_wujia_operation_root"
        action="action_franchise_management"
        sequence="10" />

    <menuitem id="menu_wujia_franchise_member"
        name="Franchise Members"
        parent="menu_wujia_operation_root"
        action="action_wujia_franchise_member"
        sequence="20" />

    <!-- 4. Cấu hình -->
    <menuitem id="menu_wujia_config_root"
        name="Configuration"
        parent="menu_wujia_root"
        sequence="90"
        groups="group_franchise_manager" />


    <!-- Area Management -->
    <menuitem id="menu_wujia_config_area_root"
        name="Area Management"
        parent="menu_wujia_config_root"
        sequence="10" />

    <menuitem id="menu_wujia_config_area"
        name="Areas"
        parent="menu_wujia_config_area_root"
        action="wujia_core.action_res_area"
        sequence="10" />

    <menuitem id="menu_wujia_config_state"
        name="Provinces / Cities"
        parent="menu_wujia_config_area_root"
        action="base.action_country_state"
        sequence="20" />

    <menuitem id="menu_wujia_config_ward"
        name="Wards / Communes"
        parent="menu_wujia_config_area_root"
        action="wujia_core.action_res_ward"
        sequence="30" />

</odoo>