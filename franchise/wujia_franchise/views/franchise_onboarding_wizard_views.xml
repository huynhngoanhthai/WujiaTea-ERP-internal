<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_franchise_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">wujia.franchise.onboarding.wizard.form</field>
        <field name="model">wujia.franchise.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Store onboarding">
                <field name="mode" invisible="1"/>
                <field name="franchise_id" invisible="1"/>

                <group string="Store information" invisible="mode != 'store' or franchise_id">
                    <group>
                        <field name="code" placeholder="H010"
                               required="mode == 'store' and not franchise_id"/>
                        <field name="name" placeholder="e.g. 219 Vinh Vien store"
                               required="mode == 'store' and not franchise_id"/>
                        <field name="area_id" options="{'no_create_edit': True}"/>
                        <field name="state_id"/>
                        <field name="address"/>
                    </group>
                    <group>
                        <field name="franchise_start_date"/>
                        <field name="franchise_end_date"
                               required="mode == 'store' and not franchise_id"/>
                        <field name="opening_date"/>
                        <field name="phone" widget="phone"/>
                        <field name="email" widget="email"/>
                    </group>
                </group>

                <group string="Store Partner details" invisible="franchise_id and mode == 'member'">
                    <field name="partner_mode" widget="radio"/>
                    <field name="partner_id" invisible="partner_mode != 'existing'"
                           required="partner_mode == 'existing' and not franchise_id"
                           options="{'no_create_edit': True}"/>
                    <field name="partner_warning" readonly="1" nolabel="1" colspan="2"
                           invisible="not partner_warning"/>
                    <group invisible="partner_mode != 'new'">
                        <group>
                            <field name="partner_name"
                                   required="partner_mode == 'new' and not franchise_id"/>
                            <field name="partner_phone" widget="phone"/>
                            <field name="partner_email" widget="email"/>
                        </group>
                        <group>
                            <field name="partner_vat"/>
                            <field name="partner_street"/>
                        </group>
                    </group>
                    <field name="duplicate_partner_ids" nolabel="1" colspan="2"
                           invisible="partner_mode != 'new' or not duplicate_partner_ids">
                        <list create="false" delete="false">
                            <field name="display_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="vat"/>
                        </list>
                    </field>
                    <field name="duplicate_ack"
                           invisible="partner_mode != 'new' or not duplicate_partner_ids"/>
                </group>

                <group string="Store user list">
                    <field name="member_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="user_mode"/>
                            <field name="user_id" options="{'no_create': True}"
                                   readonly="user_mode != 'existing'"
                                   required="user_mode == 'existing'"/>
                            <field name="user_name" readonly="user_mode != 'new'"
                                   required="user_mode == 'new'"/>
                            <field name="user_login" readonly="user_mode != 'new'"
                                   required="user_mode == 'new'"/>
                            <field name="user_email" readonly="user_mode != 'new'"/>
                            <field name="user_phone" readonly="user_mode != 'new'"/>
                            <field name="role"/>
                            <field name="is_primary_owner"/>
                            <field name="date_from"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_franchise_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Store onboarding</field>
        <field name="res_model">wujia.franchise.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
