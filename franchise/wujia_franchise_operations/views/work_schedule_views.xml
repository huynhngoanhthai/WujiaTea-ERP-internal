<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wujia_franchise_work_schedule_list" model="ir.ui.view">
        <field name="name">wujia.franchise.work.schedule.list</field>
        <field name="model">wujia.franchise.work.schedule</field>
        <field name="arch" type="xml">
            <list string="Work Schedules" decoration-muted="state == 'cancelled'">
                <field name="name" readonly="1" decoration-bf="1"/>
                <field name="franchise_id"/>
                <field name="employee_id"/>
                <field name="work_date"/>
                <field name="shift_template_id"/>
                <field name="planned_start" widget="datetime"/>
                <field name="planned_end" widget="datetime"/>
                <field name="planned_hours"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_work_schedule_calendar" model="ir.ui.view">
        <field name="name">wujia.franchise.work.schedule.calendar</field>
        <field name="model">wujia.franchise.work.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Work Schedules"
                      date_start="planned_start"
                      date_stop="planned_end"
                      color="employee_id"
                      mode="week"
                      event_limit="5">
                <field name="employee_id"/>
                <field name="franchise_id"/>
                <field name="shift_template_id"/>
                <field name="planned_hours"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_wujia_franchise_work_schedule_form" model="ir.ui.view">
        <field name="name">wujia.franchise.work.schedule.form</field>
        <field name="model">wujia.franchise.work.schedule</field>
        <field name="arch" type="xml">
            <form string="Work Schedule">
                <header>
                    <button name="action_confirm" string="Confirm Schedule" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel Schedule" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Store &amp; Employee">
                            <field name="franchise_id" readonly="state != 'draft'"/>
                            <field name="assignment_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                        <group string="Shift &amp; Date">
                            <field name="work_date" readonly="state != 'draft'"/>
                            <field name="shift_template_id" readonly="state != 'draft'"/>
                            <field name="planned_start" readonly="state != 'draft'"/>
                            <field name="planned_end" readonly="state != 'draft'"/>
                            <field name="planned_hours" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Confirmation Trail" invisible="state != 'confirmed'">
                        <group>
                            <field name="confirmed_by_id"/>
                            <field name="confirmed_date"/>
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="note" placeholder="Shift assignment note..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wujia_franchise_work_schedule_search" model="ir.ui.view">
        <field name="name">wujia.franchise.work.schedule.search</field>
        <field name="model">wujia.franchise.work.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="franchise_id"/>
                <field name="employee_id"/>
                <field name="shift_template_id"/>
                <field name="work_date"/>
                <filter string="Work Date" name="filter_work_date" date="work_date"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Store" name="group_store" context="{'group_by': 'franchise_id'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Shift Template" name="group_shift" context="{'group_by': 'shift_template_id'}"/>
                <filter string="Work Date" name="group_date" context="{'group_by': 'work_date'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_wujia_franchise_work_schedule" model="ir.actions.act_window">
        <field name="name">Work Schedules</field>
        <field name="res_model">wujia.franchise.work.schedule</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_work_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan a work schedule for a franchise employee!
            </p>
        </field>
    </record>

    <record id="action_wujia_franchise_work_schedule_server" model="ir.actions.server">
        <field name="name">Work Schedules</field>
        <field name="model_id" ref="model_wujia_franchise_work_schedule"/>
        <field name="state">code</field>
        <field name="code">action = model.action_get_work_schedules()</field>
    </record>

    <menuitem id="menu_wujia_franchise_work_schedule"
              name="Work Schedules"
              parent="menu_wujia_franchise_scheduling_root"
              action="action_wujia_franchise_work_schedule_server"
              sequence="10"/>

</odoo>
