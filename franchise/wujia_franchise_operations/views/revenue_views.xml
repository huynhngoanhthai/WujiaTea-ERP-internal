<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wujia_franchise_revenue_list" model="ir.ui.view">
        <field name="name">wujia.franchise.revenue.list</field>
        <field name="model">wujia.franchise.revenue</field>
        <field name="arch" type="xml">
            <list string="Daily Revenue Declarations" decoration-muted="state == 'cancelled'">
                <field name="name" readonly="1" decoration-bf="1" />
                <field name="franchise_id" />
                <field name="business_date" />
                <field name="amount" widget="monetary" sum="Total Revenue" />
                <field name="currency_id" column_invisible="True" />
                <field name="source" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-muted="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_revenue_pivot" model="ir.ui.view">
        <field name="name">wujia.franchise.revenue.pivot</field>
        <field name="model">wujia.franchise.revenue</field>
        <field name="arch" type="xml">
            <pivot string="Revenue Analysis" sample="1">
                <field name="franchise_id" type="row" />
                <field name="business_date" interval="month" type="col" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_wujia_franchise_revenue_graph" model="ir.ui.view">
        <field name="name">wujia.franchise.revenue.graph</field>
        <field name="model">wujia.franchise.revenue</field>
        <field name="arch" type="xml">
            <graph string="Revenue Analysis" type="bar" sample="1">
                <field name="franchise_id" />
                <field name="amount" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_wujia_franchise_revenue_form" model="ir.ui.view">
        <field name="name">wujia.franchise.revenue.form</field>
        <field name="model">wujia.franchise.revenue</field>
        <field name="arch" type="xml">
            <form string="Daily Revenue Declaration">
                <header>
                    <button name="action_confirm" string="Confirm Revenue" type="object"
                        class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_draft" string="Reset to Draft" type="object"
                        invisible="state == 'draft'" />
                    <button name="action_cancel" string="Cancel Revenue" type="object"
                        invisible="state == 'cancelled'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,cancelled" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Business Date &amp; Store">
                            <field name="franchise_id" readonly="state != 'draft'" />
                            <field name="business_date" readonly="state != 'draft'" />
                            <field name="source" readonly="state != 'draft'" />
                            <field name="import_file" filename="import_file_name"
                                readonly="state != 'draft'"
                                invisible="source != 'import'"
                                required="source == 'import'" />
                            <field name="import_file_name" invisible="1" />
                            <field name="source_reference" readonly="state != 'draft'" />
                        </group>
                        <group string="Declared Amount">
                            <label for="amount" />
                            <div class="o_row">
                                <field name="amount" widget="monetary" readonly="state != 'draft'" />
                                <button name="action_open_compute_wizard"
                                    string="Auto Calculate from File"
                                    type="object"
                                    icon="fa-calculator"
                                    class="btn btn-outline-secondary btn-sm"
                                    invisible="source != 'import' or not import_file or state != 'draft'" />
                            </div>
                            <field name="currency_id" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group string="Confirmation Trail" invisible="state != 'confirmed'">
                        <group>
                            <field name="confirmed_by_id" />
                            <field name="confirmed_date" />
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="note"
                            placeholder="Daily revenue remarks or reason for zero amount declaration..." />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_wujia_franchise_revenue_search" model="ir.ui.view">
        <field name="name">wujia.franchise.revenue.search</field>
        <field name="model">wujia.franchise.revenue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="franchise_id" />
                <field name="business_date" />
                <separator />
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]" />
                <filter string="Confirmed" name="filter_confirmed"
                    domain="[('state', '=', 'confirmed')]" />
                <filter string="Zero Revenue (Closed/Rain)" name="filter_zero"
                    domain="[('amount', '=', 0)]" />
                <separator />
                <filter string="Import (Excel/CSV)" name="filter_import"
                    domain="[('source', '=', 'import')]" />
                <filter string="Manual Entry" name="filter_manual"
                    domain="[('source', '=', 'manual')]" />
                <separator />
                <filter string="Store" name="group_store" context="{'group_by': 'franchise_id'}" />
                <filter string="Entry Source" name="group_source" context="{'group_by': 'source'}" />
                <filter string="Business Date" name="group_date"
                    context="{'group_by': 'business_date:day'}" />
                <filter string="Month" name="group_month"
                    context="{'group_by': 'business_date:month'}" />
                <filter string="Status" name="group_state" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>

    <record id="action_wujia_franchise_revenue" model="ir.actions.act_window">
        <field name="name">Daily Revenues</field>
        <field name="res_model">wujia.franchise.revenue</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_revenue_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Declare a daily retail revenue for a franchise store!
            </p>
        </field>
    </record>

    <menuitem id="menu_wujia_franchise_revenue"
        name="Daily Revenues"
        parent="menu_wujia_franchise_finance_root"
        action="action_wujia_franchise_revenue"
        sequence="10" />

    <menuitem id="menu_wujia_franchise_revenue_import"
        name="Import Revenue File"
        parent="menu_wujia_franchise_finance_root"
        action="action_wujia_franchise_revenue_import_wizard"
        sequence="20" />

</odoo>