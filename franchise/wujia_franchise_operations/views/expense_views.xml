<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wujia_franchise_expense_list" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.list</field>
        <field name="model">wujia.franchise.expense</field>
        <field name="arch" type="xml">
            <list string="Operating Expenses" decoration-muted="state == 'cancelled'">
                <field name="name" readonly="1" decoration-bf="1"/>
                <field name="franchise_id"/>
                <field name="expense_date"/>
                <field name="category_id"/>
                <field name="amount" widget="monetary" sum="Total Expense"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="description"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_pivot" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.pivot</field>
        <field name="model">wujia.franchise.expense</field>
        <field name="arch" type="xml">
            <pivot string="Expenses Analysis" sample="1">
                <field name="franchise_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_graph" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.graph</field>
        <field name="model">wujia.franchise.expense</field>
        <field name="arch" type="xml">
            <graph string="Expenses Analysis" type="bar" sample="1">
                <field name="franchise_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_form" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.form</field>
        <field name="model">wujia.franchise.expense</field>
        <field name="arch" type="xml">
            <form string="Operating Expense">
                <header>
                    <button name="action_confirm" string="Confirm Expense" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel Expense" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Expense Basic Details">
                            <field name="franchise_id" readonly="state != 'draft'"/>
                            <field name="expense_date" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Financial Amount">
                            <field name="amount" widget="monetary" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Reason and receipt details..." readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Receipt Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Confirmation Audit" name="audit" invisible="state != 'confirmed'">
                            <group>
                                <field name="confirmed_by_id"/>
                                <field name="confirmed_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_search" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.search</field>
        <field name="model">wujia.franchise.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="franchise_id"/>
                <field name="category_id"/>
                <field name="expense_date"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Store" name="group_store" context="{'group_by': 'franchise_id'}"/>
                <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                <filter string="Expense Date" name="group_date" context="{'group_by': 'expense_date'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_wujia_franchise_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">wujia.franchise.expense</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a store operating expense!
            </p>
        </field>
    </record>

    <menuitem id="menu_wujia_franchise_expense"
              name="Expenses"
              parent="menu_wujia_franchise_finance_root"
              action="action_wujia_franchise_expense"
              sequence="20"/>

</odoo>
