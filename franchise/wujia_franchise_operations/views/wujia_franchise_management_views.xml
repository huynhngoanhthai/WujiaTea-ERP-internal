<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_franchise_management_form_inherit_operations" model="ir.ui.view">
        <field name="name">wujia.franchise.management.form.inherit.operations</field>
        <field name="model">wujia.franchise.management</field>
        <field name="inherit_id" ref="wujia_franchise.view_franchise_management_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_store_employees"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users">
                    <field name="employee_count" widget="statinfo" string="Employees"/>
                </button>
                <button name="action_view_store_schedules"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar">
                    <field name="work_schedule_count" widget="statinfo" string="Schedules"/>
                </button>
                <button name="action_view_store_expenses"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="operation_expense_count" widget="statinfo" string="Expenses"/>
                </button>
                <button name="action_view_store_revenues"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart">
                    <field name="operation_revenue_count" widget="statinfo" string="Revenues"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
