<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wujia_franchise_expense_category_list" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.category.list</field>
        <field name="model">wujia.franchise.expense.category</field>
        <field name="arch" type="xml">
            <list string="Expense Categories">
                <field name="sequence" widget="handle"/>
                <field name="code" decoration-bf="1"/>
                <field name="name"/>
                <field name="expense_type"/>
                <field name="active" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_category_form" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.category.form</field>
        <field name="model">wujia.franchise.expense.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Electricity Expense"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Category Details">
                            <field name="code" placeholder="e.g. ELEC"/>
                            <field name="expense_type"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Internal description of what is covered under this expense category..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wujia_franchise_expense_category_search" model="ir.ui.view">
        <field name="name">wujia.franchise.expense.category.search</field>
        <field name="model">wujia.franchise.expense.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="expense_type"/>
            </search>
        </field>
    </record>

    <record id="action_wujia_franchise_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">wujia.franchise.expense.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_expense_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define an operating expense category!
            </p>
        </field>
    </record>

    <menuitem id="menu_wujia_franchise_expense_category"
              name="Expense Categories"
              parent="menu_wujia_franchise_finance_root"
              action="action_wujia_franchise_expense_category"
              sequence="30"/>

</odoo>
