<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Graph View: 
         - Trục Ox: Thời gian (planned_date)
         - Trục Oy: Điểm số (total_score)
         - Các cửa hàng hiển thị thành dạng CỘT ĐÔI / SONG SONG side-by-side (stacked="0")
    -->
    <record id="view_wujia_franchise_inspection_report_graph" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.report.graph</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <graph string="Inspection Results Analysis" type="bar" stacked="0" sample="1">
                <field name="planned_date" interval="day" type="row"/>
                <field name="franchise_id" type="col"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View: Bảng tổng hợp Pivot phân tích kết quả -->
    <record id="view_wujia_franchise_inspection_report_pivot" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.report.pivot</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <pivot string="Inspection Results Analysis" sample="1">
                <field name="planned_date" interval="month" type="row"/>
                <field name="franchise_id" type="col"/>
                <field name="total_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action Phân tích kết quả giám sát -->
    <record id="action_wujia_franchise_inspection_report_result" model="ir.actions.act_window">
        <field name="name">Inspection Results Analysis</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="domain">[('state', 'in', ['done', 'need_remediation'])]</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_search" />
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Summary report analyzing store supervision scores over time!
            </p>
        </field>
    </record>

</odoo>
