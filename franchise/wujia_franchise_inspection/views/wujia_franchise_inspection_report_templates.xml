<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Printable PDF Report (Fully Internationalized) -->
    <template id="report_inspection_document">
        <t t-set="doc_store_name"
            t-value="docs[0].franchise_id.name if (docs and docs[0].franchise_id) else ''" />
        <t t-set="doc_plan_date"
            t-value="docs[0].planned_date.strftime('%d-%m-%Y') if (docs and docs[0].planned_date) else ''" />
        <t t-set="title"
            t-value="'Franchise Inspection Report [%s] [%s]' % (doc_store_name, doc_plan_date)" />
        <t t-call="web.html_container">
            <script type="text/javascript">
                (function() {
                    var title = "Franchise Inspection Report [<t t-esc="doc_store_name" />] [<t t-esc="doc_plan_date" />]";
                    document.title = title;
                    try {
                        if (window.parent &amp;&amp; window.parent.document) {
                            window.parent.document.title = title;
                        }
                    } catch(e) {}
                })();
            </script>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
            <link
                href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,700;0,900;1,400;1,700&amp;family=Noto+Sans+Vietnamese:wght@400;500;600;700;800&amp;display=swap"
                rel="stylesheet" />
            <link rel="stylesheet"
                href="/wujia_franchise_inspection/static/src/css/inspection_report.css?v=1787990418" />
            <script type="text/javascript"
                src="/wujia_franchise_inspection/static/src/js/inspection_report.js?v=1787990418"></script>
            <t t-foreach="docs" t-as="doc">
                <t t-set="selected_lang"
                    t-value="(request and request.params and request.params.get('lang')) or doc.env.context.get('lang') or 'vi_VN'" />
                <t t-set="t" t-value="doc.get_report_translations(selected_lang)" />
                <script id="reportTransJson" type="application/json">
                    <t t-out="json.dumps({'vi_VN': doc.get_report_translations('vi_VN'), 'zh_CN': doc.get_report_translations('zh_CN'), 'th_TH': doc.get_report_translations('th_TH')})" />
                </script>
                <div class="report-article article">
                    <!-- Top Action Bar (hidden on print) -->
                    <div class="report-action-bar no-print" style="margin-bottom: 18px; padding: 10px 16px; background: #eff6ff; border-radius: 8px; border: 1px solid #bfdbfe; display: flex; justify-content: space-between; align-items: center; gap: 14px;">
                        <div style="flex: 1; min-width: 0;">
                            <div class="action-bar-title" style="color: #1e40af; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                                <i class="fa fa-file-pdf"></i>
                                <span data-i18n="Preview Franchise Inspection Report"><t t-out="t.get('Preview Franchise Inspection Report', 'Preview Franchise Inspection Report')" /></span>
                            </div>
                            <div class="action-bar-sub" style="font-size: 11.5px; color: #475569; margin-top: 2px;">
                                <span data-i18n="Click print button below to save PDF file or print directly."><t t-out="t.get('Click print button below to save PDF file or print directly.', 'Click print button below to save PDF file or print directly.')" /></span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                            <button type="button" id="btnPrintReport" class="btn-print-action" style="height: 32px; padding: 0 14px; background: #2563eb; color: #ffffff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 3px rgba(37,99,235,0.3); transition: background 0.2s ease; white-space: nowrap;">
                                <i class="fa fa-print"></i>
                                <span data-i18n="Print / Export PDF"><t t-out="t.get('Print / Export PDF', 'Print / Export PDF')" /></span>
                            </button>
                        </div>
                    </div>

                    <!-- Report Header -->
                    <div class="report-header">
                        <div>
                            <h1 class="report-title">
                                <span data-i18n="FRANCHISE STORE SUPERVISION INSPECTION REPORT"><t t-out="t.get('FRANCHISE STORE SUPERVISION INSPECTION REPORT', 'FRANCHISE STORE SUPERVISION INSPECTION REPORT')" /></span>
                            </h1>
                            <div class="store-name-sub">
                                <t t-esc="doc.franchise_id.name" /> (<t
                                    t-esc="doc.franchise_id.code or '---'" />) </div>
                        </div>
                        <div style="text-align: right;">
                            <div class="report-code-badge">
                                <t t-esc="doc.name" />
                            </div>
                            <div class="report-date-text">
                                <span data-i18n="Inspection Date:"><t t-out="t.get('Inspection Date:', 'Inspection Date:')" /></span>
                                <strong>
                                    <t t-esc="doc.planned_date"
                                        t-options='{"widget": "date", "format": "dd/MM/yyyy"}' />
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- General Info Grid -->
                    <table class="info-grid">
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="Franchise Store:"><t t-out="t.get('Franchise Store:', 'Franchise Store:')" /></span>
                            </td>
                            <td>
                                <strong style="color: #0f172a;">
                                    <t t-esc="doc.franchise_id.name" />
                                </strong>
                            </td>
                            <td class="label-cell">
                                <span data-i18n="Inspector:"><t t-out="t.get('Inspector:', 'Inspector:')" /></span>
                            </td>
                            <td>
                                <t t-esc="doc.inspector_user_id.name" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="Address:"><t t-out="t.get('Address:', 'Address:')" /></span>
                            </td>
                            <td>
                                <t t-esc="doc.franchise_id.address or '---'" />
                            </td>
                            <td class="label-cell">
                                <span data-i18n="Store Representative:"><t t-out="t.get('Store Representative:', 'Store Representative:')" /></span>
                            </td>
                            <td>
                                <t
                                    t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '---'" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="Status:"><t t-out="t.get('Status:', 'Status:')" /></span>
                            </td>
                            <td>
                                <span
                                    t-att-class="'badge-rep-pass' if doc.state == 'done' else 'badge-rep-fail'">
                                    <t t-if="doc.state == 'done'">
                                        <span data-i18n="Completed"><t t-out="t.get('Completed', 'Completed')" /></span>
                                    </t>
                                    <t t-elif="doc.state == 'need_remediation'">
                                        <span data-i18n="Need Remediation"><t t-out="t.get('Need Remediation', 'Need Remediation')" /></span>
                                    </t>
                                    <t t-elif="doc.state == 'in_progress'">
                                        <span data-i18n="In Progress"><t t-out="t.get('In Progress', 'In Progress')" /></span>
                                    </t>
                                    <t t-else="">
                                        <span data-i18n="Draft"><t t-out="t.get('Draft', 'Draft')" /></span>
                                    </t>
                                </span>
                            </td>
                            <td class="label-cell">
                                <span data-i18n="Tested Employee:"><t t-out="t.get('Tested Employee:', 'Tested Employee:')" /></span>
                            </td>
                            <td><t t-esc="doc.test_employee_name or '---'" /><t t-if="doc.tenure"> (<t t-esc="doc.tenure" />)</t></td>
                        </tr>
                    </table>

                    <!-- Summary Score Cards -->
                    <div class="score-container">
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="Checklist Score"><t t-out="t.get('Checklist Score', 'Checklist Score')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.checklist_score" /> / 95</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="Staff Exam"><t t-out="t.get('Staff Exam', 'Staff Exam')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.exam_score" /> / 5</div>
                        </div>
                        <div class="score-box highlight-total">
                            <div class="s-label">
                                <span data-i18n="Total Passed Score"><t t-out="t.get('Total Passed Score', 'Total Passed Score')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.total_score" /> / 100</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="Grade"><t t-out="t.get('Grade', 'Grade')" /></span>
                            </div>
                            <div class="s-val s-val-grade">
                                <t t-esc="doc.grade_id.name if doc.grade_id else '---'" />
                            </div>
                        </div>
                    </div>

                    <!-- Section I: Checklist Criteria -->
                    <h3 class="section-heading">
                        <span data-i18n="I. Checklist Criteria Evaluation Table"><t t-out="t.get('I. Checklist Criteria Evaluation Table', 'I. Checklist Criteria Evaluation Table')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 5%; text-align: center;" data-i18n="STT">
                                    <t t-out="t.get('STT', 'STT')" />
                                </th>
                                <th style="width: 50%;" data-i18n="Criterion Content">
                                    <t t-out="t.get('Criterion Content', 'Criterion Content')" />
                                </th>
                                <th style="width: 12%; text-align: center;" data-i18n="Evaluation">
                                    <t t-out="t.get('Evaluation', 'Evaluation')" />
                                </th>
                                <th style="width: 18%;" data-i18n="Violation Notes">
                                    <t t-out="t.get('Violation Notes', 'Violation Notes')" />
                                </th>
                                <th style="width: 15%; text-align: center;" data-i18n="Evidence Photo">
                                    <t t-out="t.get('Evidence Photo', 'Evidence Photo')" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq_idx" t-value="0" />
                            <t t-foreach="doc.line_ids" t-as="l">
                                <t t-if="l.display_type == 'section'">
                                    <tr class="sec-row">
                                        <td colspan="5" style="padding: 8px 12px;">
                                            <i class="fa fa-folder-open text-primary me-1"></i>
                                            <strong style="color: #0f172a;">
                                                <t t-esc="l.content_snapshot or l.name" />
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-set="seq_idx" t-value="seq_idx + 1" />
                                    <tr
                                        t-attf-class="#{'important-rep-row' if (l.criterion_type_snapshot == 'critical' or (l.deduction_score_snapshot and l.deduction_score_snapshot &gt;= 5.0)) else ''}">
                                        <td style="text-align: center; font-weight: 600;">
                                            <t t-esc="seq_idx" />
                                        </td>
                                        <td>
                                            <t t-esc="l.content_snapshot" />
                                        </td>
                                        <td style="text-align: center; white-space: nowrap;">
                                            <t t-if="l.is_pass">
                                                <span class="badge-rep-pass">✓</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge-rep-fail">✗</span>
                                            </t>
                                        </td>
                                        <td style="font-size: 11px; color: #475569;">
                                            <t t-esc="l.note or '---'" />
                                        </td>
                                        <td style="text-align: center;">
                                            <t t-if="l.evidence_image">
                                                <img class="photo-thumb"
                                                    t-attf-src="/web/image/wujia.franchise.inspection.line/#{l.id}/evidence_image" />
                                            </t>
                                            <t t-else="">
                                                <span style="color: #cbd5e1; font-size: 11px;" data-i18n="None">
                                                    <t t-out="t.get('None', 'None')" />
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Section II: Staff Exam Questions -->
                    <t t-if="doc.exam_line_ids">
                        <h3 class="section-heading">
                            <span data-i18n="II. Staff Knowledge Examination Results"><t t-out="t.get('II. Staff Knowledge Examination Results', 'II. Staff Knowledge Examination Results')" /></span>
                            (<t t-esc="doc.test_employee_name or 'Staff'" />) </h3>
                        <table class="rep-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%; text-align: center;" data-i18n="Code">
                                        <t t-out="t.get('Code', 'Code')" />
                                    </th>
                                    <th style="width: 77%;" data-i18n="Question">
                                        <t t-out="t.get('Question', 'Question')" />
                                    </th>
                                    <th style="width: 15%; text-align: center;" data-i18n="Earned Points">
                                        <t t-out="t.get('Earned Points', 'Earned Points')" />
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.exam_line_ids" t-as="el">
                                    <tr>
                                        <td style="text-align: center; font-weight: 700; color: #2563eb; vertical-align: middle;">
                                            <t t-esc="el.quest_code_snapshot" />
                                        </td>
                                        <td style="line-height: 1.6;">
                                            <t t-out="el.get_formatted_question_html()" />
                                        </td>
                                        <td style="text-align: center; font-weight: 700; white-space: nowrap; vertical-align: middle;">
                                            <span t-att-style="'color: #15803d;' if el.is_correct else 'color: #b91c1c;'">
                                                <t t-if="el.is_correct">✓</t><t t-else="">✗</t> <t t-esc="el.point" /> / <t t-esc="el.quest_id.score if el.quest_id else 1.0" />
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Section III: Attendance &amp; Store Appearance -->
                    <h3 class="section-heading">
                        <span data-i18n="III. Employee Attendance &amp; Remediation Notes"><t t-out="t.get('III. Employee Attendance &amp; Remediation Notes', 'III. Employee Attendance &amp; Remediation Notes')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;" data-i18n="Store Appearance Issues &amp; Key Remediations This Period">
                                    <t t-out="t.get('Store Appearance Issues &amp; Key Remediations This Period', 'Store Appearance Issues &amp; Key Remediations This Period')" />
                                </th>
                                <th style="width: 50%;">
                                    <span data-i18n="List of Employees Present at Inspection"><t t-out="t.get('List of Employees Present at Inspection', 'List of Employees Present at Inspection')" /></span>
                                    (<t t-esc="doc.present_count" /> <span data-i18n="people"><t t-out="t.get('people', 'people')" /></span>)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="remediation-box">
                                    <div class="remediation-box-label">
                                        <span data-i18n="Remediation Content:"><t t-out="t.get('Remediation Content:', 'Remediation Content:')" /></span>
                                    </div>
                                    <div class="remediation-box-content">
                                        <t t-if="doc.store_appearance_issues">
                                            <t t-esc="doc.store_appearance_issues.strip()" />
                                        </t>
                                        <t t-else="">
                                            <span data-i18n="No key store appearance issues recorded."><t t-out="t.get('No key store appearance issues recorded.', 'No key store appearance issues recorded.')" /></span>
                                        </t>
                                    </div>
                                </td>
                                <td class="attendance-list-cell">
                                    <t t-if="doc.attendance_line_ids">
                                        <ul class="attendance-ul">
                                            <t t-foreach="doc.attendance_line_ids" t-as="att">
                                                <li class="attendance-li">
                                                    <t t-if="att.is_present">
                                                        <strong style="color: #0f172a;">
                                                            <t t-esc="att.employee_name" />
                                                        </strong>
                                                        <span
                                                            style="color: #475569; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <span data-i18n="Store Owner"><t t-out="t.get('Store Owner', 'Store Owner')" /></span>
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <span data-i18n="Manager"><t t-out="t.get('Manager', 'Manager')" /></span>
                                                            </t><t
                                                                t-else="">
                                                                <span data-i18n="Staff"><t t-out="t.get('Staff', 'Staff')" /></span>
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #15803d; font-size: 11px; font-weight: 600; margin-left: 4px;" data-i18n="[Present]">
                                                            <t t-out="t.get('[Present]', '[Present]')" />
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <s style="color: #94a3b8; font-weight: 500;">
                                                            <t t-esc="att.employee_name" />
                                                        </s>
                                                        <span
                                                            style="color: #94a3b8; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <span data-i18n="Store Owner"><t t-out="t.get('Store Owner', 'Store Owner')" /></span>
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <span data-i18n="Manager"><t t-out="t.get('Manager', 'Manager')" /></span>
                                                            </t><t
                                                                t-else="">
                                                                <span data-i18n="Staff"><t t-out="t.get('Staff', 'Staff')" /></span>
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #ef4444; font-size: 11px; font-weight: 600; margin-left: 4px;" data-i18n="[Absent]">
                                                            <t t-out="t.get('[Absent]', '[Absent]')" />
                                                        </span>
                                                    </t>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #94a3b8; font-style: italic;" data-i18n="No attendance list recorded">
                                            <t t-out="t.get('No attendance list recorded', 'No attendance list recorded')" />
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Section IV: 3-Month Revenue Report -->
                    <h3 class="section-heading">
                        <span data-i18n="IV. 3-Month Detailed Revenue Report"><t t-out="t.get('IV. 3-Month Detailed Revenue Report', 'IV. 3-Month Detailed Revenue Report')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 16%; text-align: center; white-space: nowrap;" data-i18n="Month / Year">
                                    <t t-out="t.get('Month / Year', 'Month / Year')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="Revenue">
                                    <t t-out="t.get('Revenue', 'Revenue')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="Daily Avg Revenue">
                                    <t t-out="t.get('Daily Avg Revenue', 'Daily Avg Revenue')" />
                                </th>
                                <th style="width: 16%; text-align: right; white-space: nowrap;" data-i18n="Goods Ratio (%)">
                                    <t t-out="t.get('Goods Ratio (%)', 'Goods Ratio (%)')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="Total Mini App Orders">
                                    <t t-out="t.get('Total Mini App Orders', 'Total Mini App Orders')" />
                                </th>
                                <th style="width: 14%; text-align: right; white-space: nowrap;" data-i18n="App Orders Ratio (%)">
                                    <t t-out="t.get('App Orders Ratio (%)', 'App Orders Ratio (%)')" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.report_line_ids">
                                <t t-foreach="doc.report_line_ids" t-as="rl">
                                    <tr>
                                        <td
                                            style="text-align: center; font-weight: 700; color: #1e293b;">
                                            <t
                                                t-esc="rl.date_month.strftime('%m/%Y') if rl.date_month else '---'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue) if rl.revenue else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 600; color: #475569;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue_avg) if rl.revenue_avg else '0'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #0284c7;">
                                            <t t-esc="rl.percent_goods" /> % </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,}'.format(rl.total_app_sale) if rl.total_app_sale else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 700; color: #2563eb;">
                                            <t t-esc="rl.percent_app_sale" /> % </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="6" style="text-align: center; color: #94a3b8; font-style: italic; padding: 14px;" data-i18n="No 3-month revenue statistical data available.">
                                        <t t-out="t.get('No 3-month revenue statistical data available.', 'No 3-month revenue statistical data available.')" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Signatures Block (Never split across pages) -->
                    <div class="sig-block-wrap">
                        <table class="sig-grid">
                            <tr>
                                <td>
                                    <div class="sig-title">
                                        <span data-i18n="STORE REPRESENTATIVE CONFIRMATION"><t t-out="t.get('STORE REPRESENTATIVE CONFIRMATION', 'STORE REPRESENTATIVE CONFIRMATION')" /></span>
                                    </div>
                                    <div class="sig-subtitle">
                                        <span data-i18n="(Signature &amp; Full Name)"><t t-out="t.get('(Signature &amp; Full Name)', '(Signature &amp; Full Name)')" /></span>
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.signature_image">
                                            <span t-field="doc.signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '....................................'" />
                                    </div>
                                </td>
                                <td>
                                    <div class="sig-title">
                                        <span data-i18n="INSPECTOR / SUPERVISOR"><t t-out="t.get('INSPECTOR / SUPERVISOR', 'INSPECTOR / SUPERVISOR')" /></span>
                                    </div>
                                    <div class="sig-subtitle">
                                        <span data-i18n="(Signature &amp; Full Name)"><t t-out="t.get('(Signature &amp; Full Name)', '(Signature &amp; Full Name)')" /></span>
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.inspector_signature_image">
                                            <span t-field="doc.inspector_signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.inspector_user_id.name if doc.inspector_user_id else '....................................'" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Built-in Clean Printable Footer -->
                    <div class="report-print-footer">
                        <div>WujiaTea ERP — <t t-esc="doc.name" /> (<t t-esc="doc.franchise_id.name" />
                            )</div>
                        <div>Inspection Date: <t t-esc="doc.planned_date"
                                t-options='{"widget": "date", "format": "dd/MM/yyyy"}' /></div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_franchise_inspection" model="ir.actions.report">
        <field name="name">Franchise Inspection Report</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">wujia_franchise_inspection.report_inspection_document</field>
        <field name="report_file">wujia_franchise_inspection.report_inspection_document</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="model_wujia_franchise_inspection" />
        <field name="binding_type">report</field>
    </record>
</odoo>