<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action Chờ xử lý khắc phục (Mặc định lọc trạng thái Cần khắc phục) -->
    <record id="action_wujia_franchise_inspection_remediation" model="ir.actions.act_window">
        <field name="name">Pending Remediation</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_search" />
        <field name="context">{'search_default_need_remediation': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inspections pending remediation!
            </p>
        </field>
    </record>

</odoo>
