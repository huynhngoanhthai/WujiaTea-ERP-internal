<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_wujia_franchise_inspection_grade_list" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.grade.list</field>
        <field name="model">wujia.franchise.inspection.grade</field>
        <field name="arch" type="xml">
            <list string="Inspection Grades" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="min_score" />
                <field name="max_score" />
                <field name="description" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wujia_franchise_inspection_grade_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.grade.form</field>
        <field name="model">wujia.franchise.inspection.grade</field>
        <field name="arch" type="xml">
            <form string="Inspection Grade">
                <sheet>
                    <group>
                        <group string="Grade Information">
                            <field name="name" />
                            <field name="sequence" />
                            <field name="color" widget="color_picker" />
                            <field name="active" />
                        </group>
                        <group string="Score Range">
                            <field name="min_score" />
                            <field name="max_score" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wujia_franchise_inspection_grade" model="ir.actions.act_window">
        <field name="name">Inspection Grades</field>
        <field name="res_model">wujia.franchise.inspection.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first inspection grade configuration!
            </p>
            <p>Configure grade levels (A, B, C, D...) based on score ranges.</p>
        </field>
    </record>

</odoo>
