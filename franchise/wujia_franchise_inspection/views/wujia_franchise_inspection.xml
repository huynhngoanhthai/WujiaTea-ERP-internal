<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_wujia_franchise_inspection_list" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.list</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <list string="Franchise Inspections" default_order="id desc">
                <field name="name" />
                <field name="franchise_id" />
                <field name="template_id" />
                <field name="inspector_user_id" />
                <field name="test_employee_name" />
                <field name="planned_date" options="{'format': 'DD/MM/YYYY'}" />
                <field name="total_score"
                    string="Total Score" />
                <field name="checkin_time" optional="show" widget="datetime" string="Check-in GPS" />
                <button name="action_open_google_maps" type="object" icon="fa-map-marker"
                    title="View on Google Maps" invisible="not latitude and not longitude" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'in_progress'"
                    decoration-danger="state == 'need_remediation'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'cancel'" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wujia_franchise_inspection_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.form</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <form string="Franchise Inspection">
                <header>
                    <button name="action_start"
                        string="Start Inspection" type="object"
                        class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_need_remediation"
                        string="Need Remediation"
                        type="object"
                        class="btn-warning"
                        invisible="state in ('done', 'cancel', 'need_remediation')" />
                    <button name="action_done" string="Mark Done"
                        type="object" class="btn-success"
                        invisible="state in ('done', 'cancel')" />
                    <button name="action_cancel"
                        string="Cancel" type="object"
                        invisible="state in ('done', 'cancel')" />
                    <button name="action_draft"
                        string="Reset to Draft" type="object"
                        invisible="state in ('draft', 'done')" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,need_remediation,done,cancel" />
                </header>
                <sheet>
                    <!-- SMART BUTTON MỞ NỘI DUNG / CHI TIẾT KHẢO SÁT &amp; GOOGLE MAPS -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_google_maps"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-map-marker"
                            invisible="not latitude and not longitude">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-primary">Google Maps</span>
                                <span class="o_stat_value text-success" style="font-size: 11px;">Located</span>
                            </div>
                        </button>
                        <button name="action_open_inspection_detail"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            string="Inspection Sheets"
                            invisible="state != 'in_progress'">
                        </button>
                        <button name="action_print_pdf"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-danger">PDF Report</span>
                                <span class="o_stat_value" style="font-size: 11px;">Print / Export PDF</span>
                            </div>
                        </button>
                        <button name="action_open_drive_video"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-video-camera"
                            invisible="not video_url">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-success">Drive Video</span>
                                <span class="o_stat_value" style="font-size: 11px;">Xem Video</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Inspection Name" />
                        <h1>
                            <field name="name" readonly="1" force_save="1"
                                placeholder="e.g. PGS-HCM01-0001" />
                        </h1>
                    </div>
                    <group>
                        <group string="Store Information">
                            <field name="franchise_id" options="{'no_create': True}" />
                            <field name="template_id" options="{'no_create': True}" />
                            <field name="schedule_id" options="{'no_create': True}" />
                            <field name="inspector_user_id" options="{'no_create': True}" />
                            <field name="is_google_drive_enabled" invisible="1" />
                            <field name="video_upload_state" invisible="1" />
                            <field name="video_drive_file_id" invisible="1" />
                            <field name="video_filename" invisible="1" />

                            <label for="video_url" string="Video Link (Google Drive)" />
                            <div class="o_row">
                                <field name="video_url" widget="url" placeholder="https://drive.google.com/file/d/..." />
                                <button name="action_open_drive_video" type="object" string="View Video" class="btn btn-sm btn-outline-primary ms-2" icon="fa-external-link" invisible="not video_url" />
                            </div>
                            <field name="video" string="Attach Video (Optional)" widget="binary" filename="video_filename" />

                        </group>
                        <group string="Timeline &amp; History">
                            <field name="planned_date" />
                            <field name="submit_date" invisible="1" />
                            <field name="confirm_date" readonly="1" />
                            <field name="previous_inspection_id" readonly="1" />
                        </group>
                    </group>

                    <group string="GPS Check-in &amp; Location">
                        <group>
                            <field name="checkin_address" widget="wujia_gps_field" string="GPS Location" force_save="1" />
                            <field name="google_maps_url" widget="url" text="Open Google Maps" invisible="not latitude and not longitude" readonly="1" string="Map" />
                        </group>
                        <group>
                            <field name="latitude" readonly="1" force_save="1" digits="[10, 6]" />
                            <field name="longitude" readonly="1" force_save="1" digits="[10, 6]" />
                            <field name="checkin_time" readonly="1" force_save="1" invisible="not checkin_time" />
                        </group>
                    </group>

                    <group>
                        <group string="Tested Employee Information">
                            <field name="test_employee_name"
                                placeholder="Employee full name..." />
                            <field name="tenure"
                                placeholder="Tenure (e.g. 1 year, 6 months)..." />
                        </group>
                        <group string="Next Inspection Plan">
                            <label for="next_due_date"
                                string="Next Inspection Date" />
                            <div class="o_row">
                                <field name="next_due_date" class="oe_inline" />
                                <button name="action_create_next_schedule"
                                    type="object"
                                    title="Create Next Supervision Schedule"
                                    icon="fa-arrow-right"
                                    class="btn-link text-primary ps-1 pe-1"
                                    invisible="not next_due_date" />
                            </div>
                            <field name="next_schedule_id" readonly="1"
                                invisible="not next_schedule_id" />
                        </group>
                    </group>

                    <group>
                        <group string="Component Scores">
                            <field name="checklist_score" readonly="1" />
                            <field name="exam_score" readonly="1" />
                        </group>
                        <group string="Evaluation Result &amp; Grade">
                            <field name="total_score" class="fw-bold fs-4 text-primary" readonly="1" />
                            <field name="grade_id" class="fw-bold fs-4 text-success"
                                readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Checklist Criteria"
                            name="checklist">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" create="false" delete="false" limit="100"
                                    decoration-warning="criterion_type_snapshot == 'critical' and display_type == 'line'"
                                    decoration-bf="display_type == 'line'"
                                    decoration-info="display_type == 'section'">

                                    <field name="display_type" column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field name="template_line_id" column_invisible="True"
                                        force_save="1" />
                                    <field name="category_id" column_invisible="True" force_save="1" />
                                    <field name="previous_line_id" column_invisible="True" />

                                    <field name="content_snapshot"
                                        readonly="1"
                                        force_save="1"
                                        string="Checklist Content"
                                    />

                                    <!-- <field name="criterion_type_snapshot"
                                        readonly="1"
                                        force_save="1"
                                        string="Criterion Type"
                                        widget="badge"
                                        invisible="display_type == 'section'"
                                        decoration-danger="criterion_type_snapshot == 'critical'"
                                        decoration-info="criterion_type_snapshot == 'normal'" />

                                    <field name="deduction_score_snapshot"
                                        readonly="1"
                                        force_save="1"
                                        string="Deduction Score"
                                        invisible="display_type == 'section'" /> -->

                                    <field name="is_pass"
                                        widget="boolean_toggle"
                                        string="Passed (Pass)"
                                        invisible="display_type == 'section'"
                                        class="wujia-inspection-pass-toggle"
                                    />

                                    <field name="previous_result"
                                        readonly="1"
                                        string="Previous Result"
                                        widget="badge"
                                        invisible="display_type == 'section'"
                                        decoration-success="previous_result == 'pass'"
                                        decoration-danger="previous_result == 'fail'" />

                                    <button name="action_view_previous_inspection"
                                        type="object"
                                        icon="fa-external-link"
                                        title="View Previous Inspection Line"
                                        class="btn-link text-primary p-0 me-1"
                                        invisible="display_type == 'section' or not previous_result" />

                                    <field name="require_note_if_fail" column_invisible="True" />
                                    <field name="require_evidence_if_fail" column_invisible="True" />

                                    <field name="note"
                                        placeholder="Enter violation note if any..."
                                        invisible="display_type == 'section'"
                                        required="not is_pass and require_note_if_fail and display_type == 'line'" />

                                    <field name="evidence_image"
                                        widget="image"
                                        options="{'size': [50, 50]}"
                                        string="Evidence Photo"
                                        invisible="display_type == 'section'"
                                        required="not is_pass and require_evidence_if_fail and display_type == 'line'" />

                                    <field name="remediation_state"
                                        widget="selection_badge"
                                        decoration-danger="remediation_state == 'need_remediation'"
                                        decoration-warning="remediation_state == 'remediated'"
                                        decoration-success="remediation_state == 'done'"
                                        column_invisible="parent.state not in ['need_remediation', 'done']"
                                        invisible="display_type == 'section'" />

                                    <field name="remediation_note"
                                        placeholder="Enter store remediation note..."
                                        column_invisible="parent.state not in ['need_remediation', 'done']"
                                        invisible="display_type == 'section'" />

                                    <field name="remediation_image"
                                        widget="image"
                                        options="{'size': [50, 50]}"
                                        string="Remediation Photo"
                                        invisible="display_type == 'section'"
                                        column_invisible="parent.state not in ['need_remediation', 'done']"
                                        readonly="parent.state not in ('need_remediation', 'in_progress', 'draft')" />
                                </list>
                            </field>
                        </page>
                        <page string="Staff Exam" name="exam">
                            <!-- <field name="is_exam_submitted" column_invisible="True" /> -->
                            <div
                                class="alert alert-warning d-flex justify-content-between align-items-center mb-3"
                                invisible="is_exam_submitted or state != 'draft'">
                                <div>
                                    <p class="d-inline fw-bold me-1">Note:</p>
                                    <p class="d-inline">Please click "Start Inspection" on the header to start the inspection and take the exam!</p>
                                </div>
                            </div>
                            <div
                                class="alert alert-info d-flex justify-content-between align-items-center mb-3"
                                invisible="is_exam_submitted or state != 'in_progress'">
                                <div>
                                    <p class="d-inline fw-bold me-1">Instructions:</p>
                                    <p class="d-inline">Employees enter answers into the "Answer" box below each question. After completion, click "Submit Exam" to grade.</p>
                                </div>
                                <button name="action_submit_exam"
                                    string="Submit Exam"
                                    type="object" class="btn btn-primary fw-bold px-4"
                                    invisible="is_exam_submitted or state != 'in_progress'" />
                            </div>
                            <div
                                class="alert alert-success d-flex justify-content-between align-items-center mb-3"
                                invisible="not is_exam_submitted">
                                <div>
                                    <p class="d-inline fw-bold me-1">Exam Submitted!</p>
                                    <p class="d-inline">Answers have been locked. Scoring result:</p>
                                    <span class="fs-5 text-success fw-bold ms-1">
                                        <field name="exam_score" readonly="1" class="d-inline" />
                                    </span>
                                    <p class="d-inline fs-5 text-success fw-bold ms-1">points</p>
                                </div>
                            </div>
                            <group>
                                <group>
                                    <field name="test_employee_name"
                                        readonly="is_exam_submitted or state in ('done', 'cancel')" />
                                </group>
                                <group>
                                    <field name="tenure"
                                        readonly="is_exam_submitted or state in ('done', 'cancel')" />
                                </group>
                            </group>
                            <field name="exam_line_ids"
                                readonly="is_exam_submitted or state in ('done', 'cancel')">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle" />
                                    <field name="quest_id" column_invisible="True" />
                                    <field name="quest_code_snapshot" readonly="1" force_save="1"
                                        string="Question Code" />
                                    <field name="quest_content_snapshot" readonly="1" force_save="1"
                                        string="Question Content" />
                                    <field name="answer"
                                        placeholder="Enter employee answer..."
                                        readonly="parent.is_exam_submitted or parent.state in ('done', 'cancel')" />
                                    <field name="_point_return"
                                        string="Score"
                                        readonly="1"
                                        invisible="not parent.is_exam_submitted" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Remediation" name="appearance_issues">
                            <div class="alert alert-info d-flex align-items-center gap-2 mb-3 p-3 rounded" role="alert">
                                <i class="fa fa-info-circle fa-lg text-primary"></i>
                                <div>
                                    <strong class="d-block">Store Appearance &amp; Key Remediation Issues</strong>
                                    <span class="small text-muted">Record poor store appearance and key issues that need to be resolved.</span>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <label for="previous_store_appearance_issues" class="fw-bold text-primary mb-2 d-block" string="Previous Inspection Notes (Most Recent)" />
                                    <field name="previous_store_appearance_issues" readonly="1" nolabel="1"
                                        placeholder="No notes from previous inspection..."
                                        class="w-100"
                                        style="min-height: 160px; background-color: #f8fafc; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 10px;" />
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label for="store_appearance_issues" class="fw-bold text-dark mb-2 d-block" string="Current Inspection Notes (To remediate)" />
                                    <field name="store_appearance_issues" nolabel="1"
                                        placeholder="Enter poor store appearance details and key issues to improve for this inspection..."
                                        readonly="state in ('done', 'cancel')"
                                        class="w-100"
                                        style="min-height: 160px; border-radius: 8px; padding: 10px;" />
                                </div>
                            </div>
                        </page>
                        <page string="Revenue Report" name="report">
                            <field name="inspection_chart_data" widget="wujia_inspection_chart"
                                nolabel="1" class="w-100 d-block" />
                            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                                <separator string="3-Month Revenue Detail" class="m-0" />
                                <button name="action_sync_posapp_revenue" string="Sync PosApp Revenue"
                                    type="object" class="btn btn-sm btn-outline-primary" icon="fa-refresh"
                                    invisible="state in ('done', 'cancel')" />
                            </div>
                            <field name="report_line_ids" nolabel="1"
                                readonly="state in ('done', 'cancel')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="date_month" widget="wujia_month_year" string="Month / Year" />
                                    <field name="revenue" string="Revenue" />
                                    <field name="revenue_avg" string="Daily Avg Revenue" />
                                    <field name="percent_goods" string="Goods Ratio (%)" />
                                    <field name="total_app_sale" string="Total Mini App Orders" />
                                    <field name="percent_app_sale" string="App Orders Ratio (%)" />
                                </list>
                            </field>
                        </page>
                        <page string="Confirmation"
                            name="confirmation">
                            <group>
                                <group
                                    string="System Confirmation">
                                    <field name="confirmed_user_id" options="{'no_create': True}" />
                                    <field name="inspector_signature_image" widget="signature" string="Inspector Signature" />
                                </group>
                                <group
                                    string="Store Manager Confirmation">
                                    <field name="confirmed_member_id"
                                        domain="[('franchise_id', '=', franchise_id)]"
                                        options="{'no_create': True}" />
                                    <field name="signature_image" widget="signature" string="Store Representative Signature" />
                                    <field name="signature_date" readonly="1" invisible="not signature_date" />
                                </group>
                            </group>

                            <!-- ====== 50-50 Layout: Present Staff &amp; Passed Staff ====== -->
                            <div class="row mt-4">
                                <!-- Cột 1 (50%): Staff có mặt tại cửa hàng -->
                                <div class="col-lg-6 col-12 pe-lg-3 border-end">
                                    <separator string="Store Staff Present at Inspection" class="mb-2" />
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="alert alert-info py-1 px-3 mb-0 d-inline-flex align-items-center">
                                            <p class="d-inline fw-bold me-1 mb-0">Present:</p>
                                            <field name="present_count" readonly="1" class="d-inline fw-bold text-success" />
                                        </div>
                                    </div>
                                    <field name="attendance_line_ids" readonly="state in ('done', 'cancel')">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle" />
                                            <field name="line_type" column_invisible="True" force_save="1" />
                                            <field name="member_id" column_invisible="True" />
                                            <field name="employee_name" placeholder="Employee Name" />
                                            <field name="role" widget="badge"
                                                decoration-info="role == 'staff'"
                                                decoration-warning="role == 'manager'"
                                                decoration-success="role == 'owner'" />
                                            <field name="phone" placeholder="Phone" />
                                            <field name="is_present" widget="boolean_toggle" string="Present" />
                                            <button name="action_save_to_member" type="object"
                                                icon="fa-arrow-right"
                                                title="Save or update this member to Store Membership"
                                                class="btn-link text-primary p-0" />
                                            <button name="action_deactivate_member" type="object"
                                                icon="fa-info-circle"
                                                title="Deactivate this employee (active = False)"
                                                class="btn-link text-danger p-0"
                                                confirm="Are you sure you want to deactivate this employee (active = False)? The employee remains saved in the system history."
                                                invisible="not member_id" />
                                            <field name="note" placeholder="Note..." />
                                        </list>
                                    </field>
                                </div>

                                <!-- Cột 2 (50%): Staff đã thi đậu -->
                                <div class="col-lg-6 col-12 ps-lg-3">
                                    <separator string="Passed Exam Staff" class="mb-2" />
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="alert alert-success py-1 px-3 mb-0 d-inline-flex align-items-center">
                                            <p class="d-inline fw-bold me-1 mb-0">Passed Staff:</p>
                                            <field name="passed_count" readonly="1" class="d-inline fw-bold" />
                                        </div>
                                    </div>
                                    <field name="passed_member_ids" readonly="1">
                                        <list create="false" delete="false">
                                            <field name="user_id" string="Employee Name" />
                                            <field name="role" widget="badge"
                                                decoration-info="role == 'staff'"
                                                decoration-warning="role == 'manager'"
                                                decoration-success="role == 'owner'" />
                                            <field name="phone" string="Phone" />
                                        </list>
                                    </field>
                                </div>
                            </div>

                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_wujia_franchise_inspection_search" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.search</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <search string="Search Inspections">
                <field name="name" />
                <field name="franchise_id" />
                <field name="inspector_user_id" />
                <field name="schedule_id" />
                <field name="planned_date" />
                <separator />
                <filter string="My Inspections"
                    name="my_inspection"
                    domain="[('inspector_user_id', '=', uid)]" />
                <separator />
                <filter string="Planned Date"
                    name="filter_planned_date" date="planned_date" />
                <separator />
                <filter string="Draft" name="draft"
                    domain="[('state', '=', 'draft')]" />
                <filter string="In Progress"
                    name="in_progress"
                    domain="[('state', '=', 'in_progress')]" />
                <filter string="Need Remediation"
                    name="need_remediation"
                    domain="[('state', '=', 'need_remediation')]" />
                <filter string="Done" name="done"
                    domain="[('state', '=', 'done')]" />
                <filter string="Cancelled" name="cancel"
                    domain="[('state', '=', 'cancel')]" />
                <separator />
                <filter string="Grade A" name="grade_a"
                    domain="[('grade_id.name', '=', 'A')]" />
                <filter string="Grade B" name="grade_b"
                    domain="[('grade_id.name', '=', 'B')]" />
                <filter string="Grade C" name="grade_c"
                    domain="[('grade_id.name', '=', 'C')]" />
                <filter string="Grade D" name="grade_d"
                    domain="[('grade_id.name', '=', 'D')]" />
                <separator />
                <filter string="Franchise Store"
                    name="group_franchise"
                    context="{'group_by': 'franchise_id'}" />
                <filter string="Inspector"
                    name="group_inspector"
                    context="{'group_by': 'inspector_user_id'}" />
                <filter string="Status"
                    name="group_state" context="{'group_by': 'state'}" />
                <filter string="Grade"
                    name="group_grade" context="{'group_by': 'grade_id'}" />
                <filter string="Planned Month"
                    name="group_planned_date"
                    context="{'group_by': 'planned_date:month'}" />
                <filter string="Planned Day"
                    name="group_planned_date_day"
                    context="{'group_by': 'planned_date:day'}" />
            </search>
        </field>
    </record>

    <!-- Action Phiếu giám sát -->
    <record id="action_wujia_franchise_inspection" model="ir.actions.act_window">
        <field name="name">Franchise Inspections</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new inspection sheet!
            </p>
        </field>
    </record>

</odoo>