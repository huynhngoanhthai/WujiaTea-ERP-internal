<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category Views -->
    <record id="view_wujia_franchise_inspection_category_tree" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.tree</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <list string="Inspection Categories" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_inspection_category_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.form</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <form string="Inspection Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wujia_franchise_inspection_category" model="ir.actions.act_window">
        <field name="name">Inspection Categories</field>
        <field name="res_model">wujia.franchise.inspection.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new inspection category / group!
            </p>
        </field>
    </record>

    <!-- Template Tree / List View -->
    <record id="view_wujia_franchise_inspection_template_tree" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.tree</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <list string="Inspection Templates">
                <field name="code" />
                <field name="name" />
                <field name="version" />
                <field name="effective_date" />
                <field name="checklist_max_score" />
                <field name="exam_max_score" />
                <field name="total_max_score" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'archived'" />
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_wujia_franchise_inspection_template_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.form</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <form string="Inspection Template">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                        class="btn-primary" invisible="state == 'active'" />
                    <button name="action_create_new_version" string="Create New Version"
                        type="object" class="btn-success" invisible="state == 'draft'" />
                    <button name="action_export_criteria_excel" string="Export Criteria Excel"
                        type="object" class="btn-secondary" icon="fa-file-text-o"
                        invisible="not line_ids" />
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state == 'draft'" />
                    <button name="action_archive" string="Archive" type="object"
                        invisible="state == 'archived'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name" />
                        <h1>
                            <field name="name"
                                placeholder="e.g. Store Hygiene &amp; Quality Inspection Template 2026"
                                readonly="state in ('active', 'archived')" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="TEMPLATE-INSP-01"
                                readonly="state in ('active', 'archived')" />
                            <field name="version" readonly="state in ('active', 'archived')" />
                            <field name="effective_date" readonly="state in ('active', 'archived')" />
                        </group>
                        <group string="Scoring Configuration">
                            <field name="checklist_max_score"
                                readonly="state in ('active', 'archived')" />
                            <field name="exam_max_score" readonly="state in ('active', 'archived')" />
                            <field name="total_max_score" class="fw-bold" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Inspection Criteria" name="lines">
                            <div class="d-flex justify-content-between align-items-center mb-2"
                                invisible="state in ('active', 'archived')">
                                <span class="text-muted small">
                                    <i class="fa fa-info-circle me-1" /> You can click <strong>"Import Excel"</strong> or <strong>"Download Excel Template"</strong> on the control panel to quickly import criteria. </span>
                                <div>
                                    <button name="action_open_import_wizard" string="Import from Excel"
                                        type="object"
                                        class="btn btn-sm btn-outline-success me-1"
                                        icon="fa-file-excel-o" />
                                    <button name="action_download_excel_sample"
                                        string="Download Template" type="object"
                                        class="btn btn-sm btn-outline-secondary" icon="fa-download" />
                                </div>
                            </div>
                            <field name="line_ids" readonly="state in ('active', 'archived')">
                                <list editable="bottom" limit="100"
                                    decoration-bf="display_type == 'section'"
                                    decoration-info="display_type == 'section'">
                                    <control>
                                        <create name="add_line_control" string="Add a line"
                                            context="{'default_display_type': 'line'}" />
                                        <create name="add_section_control" string="Add a section"
                                            context="{'default_display_type': 'section'}" />
                                    </control>
                                    <field name="sequence" widget="handle" />
                                    <field name="display_type" column_invisible="True" />
                                    <field name="criterion_code" />
                                    <field name="category_id" />
                                    <field name="content" invisible="display_type == 'section'"
                                        required="display_type == 'line'" />
                                    <field name="criterion_type"
                                        invisible="display_type == 'section'" />
                                    <field name="deduction_score"
                                        invisible="display_type == 'section'" />
                                    <field name="require_note_if_fail"
                                        invisible="display_type == 'section'" />
                                    <field name="require_evidence_if_fail"
                                        invisible="display_type == 'section'" />
                                    <field name="active" widget="boolean_toggle"
                                        invisible="display_type == 'section'" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Template Search View -->
    <record id="view_wujia_franchise_inspection_template_search" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.search</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <search string="Search Inspection Templates">
                <field name="name" />
                <field name="code" />
                <field name="version" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Active" name="active" domain="[('state', '=', 'active')]" />
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]" />
                <separator />
                <filter string="Status" name="group_state" context="{'group_by': 'state'}" />
                <filter string="Effective Date" name="group_date"
                    context="{'group_by': 'effective_date'}" />
            </search>
        </field>
    </record>

    <!-- Template Action -->
    <record id="action_wujia_franchise_inspection_template" model="ir.actions.act_window">
        <field name="name">Inspection Templates</field>
        <field name="res_model">wujia.franchise.inspection.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_template_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new inspection template for the franchise store system!
            </p>
        </field>
    </record>

    <!-- Inspection Template Import Wizard View -->
    <record id="view_wujia_franchise_inspection_template_import_wizard_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.import.wizard.form</field>
        <field name="model">wujia.franchise.inspection.template.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Inspection Criteria from Excel">
                <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                    <i class="fa fa-info-circle fa-2x me-3 text-info" />
                    <div>
                        <h6 class="alert-heading fw-bold mb-1">Instructions for importing criteria from Excel file</h6>
                        <ul class="mb-0 ps-3 small">
                            <li>Only Excel files in <strong>.xlsx</strong> or <strong>.xlsm</strong> format are accepted.</li>
                            <li>If you do not have the template file, click <strong>"Download Excel Template"</strong> below.</li>
                            <li>Rows with Line Type <em>"Section"</em> will create group headers; subsequent rows will belong to that group.</li>
                        </ul>
                    </div>
                </div>
                <group>
                    <group>
                        <field name="template_id" readonly="1" force_save="1"
                            options="{'no_open': True}" />
                        <field name="file_data" filename="file_name" widget="binary" />
                        <field name="file_name" invisible="1" />
                    </group>
                    <group>
                        <field name="import_mode" widget="radio" />
                        <field name="auto_create_category" widget="boolean_toggle" />
                    </group>
                </group>
                <footer>
                    <button name="action_import_excel" string="Import Data" type="object"
                        class="btn-primary" icon="fa-upload" />
                    <button name="action_download_sample_excel" string="Download Excel Template"
                        type="object"
                        class="btn-outline-secondary" icon="fa-download" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>