<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supervision Privilege & Groups -->
    <record id="res_groups_privilege_supervision" model="res.groups.privilege">
        <field name="name">Franchise Inspection</field>
        <field name="category_id" ref="wujia_franchise.module_category_wujia"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_supervision_inspector" model="res.groups">
        <field name="name">Inspection Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_supervision"/>
        <field name="implied_ids" eval="[(4, ref('wujia_franchise.group_franchise_user'))]"/>
        <field name="comment">Officer permissions: Create and view assigned inspection sheets and schedules. Manage exam question library.</field>
    </record>

    <record id="group_supervision_admin" model="res.groups">
        <field name="name">Inspection Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_supervision"/>
        <field name="implied_ids" eval="[(4, ref('group_supervision_inspector'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Inspection Administrator - Full access.</field>
    </record>

    <!-- Kế thừa quyền Quản trị nhượng quyền -> tự động có quyền Quản trị giám sát -->
    <record id="wujia_franchise.group_franchise_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_supervision_admin'))]"/>
    </record>

</odoo>
