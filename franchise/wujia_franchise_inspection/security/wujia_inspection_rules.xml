<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Supervision Schedule Record Rules -->
        <record id="rule_supervision_schedule_inspector" model="ir.rule">
            <field name="name">Supervision Schedule: Inspector: own only</field>
            <field name="model_id" ref="model_wujia_supervision_schedule"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_supervision_inspector'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_supervision_schedule_admin" model="ir.rule">
            <field name="name">Supervision Schedule: Admin: all</field>
            <field name="model_id" ref="model_wujia_supervision_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supervision_admin'))]"/>
        </record>

