<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hoá đơn / credit note: cho kế toán gán cửa hàng (nguồn phạm vi công nợ portal). -->
    <record id="view_move_form_wujia_franchise" model="ir.ui.view">
        <field name="name">account.move.form.wujia.franchise</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="franchise_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <!-- Lọc / gom nhóm hoá đơn theo cửa hàng. -->
    <record id="view_account_move_filter_wujia_franchise" model="ir.ui.view">
        <field name="name">account.move.search.wujia.franchise</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="franchise_id"/>
            </field>
            <filter name="partner" position="after">
                <filter string="Franchise store" name="wujia_franchise"
                        domain="[]" context="{'group_by': 'franchise_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
