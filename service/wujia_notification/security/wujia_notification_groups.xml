<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_notification" model="res.groups.privilege">
        <field name="name">Wujia Notification</field>
        <field name="category_id" ref="wujia_franchise.module_category_wujia"/>
        <field name="sequence">45</field>
    </record>

    <record id="group_notification_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_notification"/>
        <field name="comment">View franchise notifications and their read status.</field>
    </record>

    <record id="group_notification_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_notification"/>
        <field name="implied_ids" eval="[(4, ref('group_notification_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Compose, send and archive notifications, and configure notification types.</field>
    </record>

</odoo>
